<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kr_edi_notice_import_form" model="ir.ui.view">
        <field name="name">kr.edi.notice.import.form</field>
        <field name="model">kr.edi.notice.import</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <field name="result" invisible="not result" readonly="1"/>
                <footer>
                    <button name="action_import" type="object" string="업로드 반영" class="btn-primary"/>
                    <button string="닫기" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_kr_edi_notice_import" model="ir.actions.act_window">
        <field name="name">EDI 고지내역 일괄 업로드</field>
        <field name="res_model">kr.edi.notice.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_kr_withholding_report_form" model="ir.ui.view">
        <field name="name">kr.withholding.report.form</field>
        <field name="model">kr.withholding.report</field>
        <field name="arch" type="xml">
            <form>
                <group col="4">
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <button name="action_compute" type="object" string="집계" class="btn-primary"/>
                <group string="원천징수이행상황신고서 (간이세액 A01)">
                    <group>
                        <field name="employee_count"/>
                        <field name="total_gross"/>
                        <field name="total_taxable"/>
                    </group>
                    <group>
                        <field name="income_tax"/>
                        <field name="local_tax"/>
                    </group>
                </group>
                <field name="note" readonly="1"/>
            </form>
        </field>
    </record>
    <record id="action_kr_withholding_report" model="ir.actions.act_window">
        <field name="name">원천세 신고 집계</field>
        <field name="res_model">kr.withholding.report</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_kr_edi_notice_import" name="EDI 고지내역 업로드"
              parent="hr_payroll_kr.menu_kr_payroll_master_root"
              action="action_kr_edi_notice_import" sequence="35"/>
    <menuitem id="menu_kr_withholding_report" name="원천세 신고 집계"
              parent="hr_work_entry_contract_enterprise.menu_hr_payroll_root"
              action="action_kr_withholding_report" sequence="76"
              groups="hr_payroll.group_hr_payroll_user"/>
</odoo>
