        <field name="amount_select">code</field>
        <field name="amount_python_compute">notice = payslip.env['kr.insurance.notice']._notice_amount(employee, 'health', payslip.date_to)
if notice is not None:
    result = -notice
else:
    result = -payslip.env['kr.payroll.rate']._employee_amount('health', result_rules['TAXBASE']['total'], payslip.date_to)</field>
