    </record>
    <record id="rule_kr_famalw" model="hr.salary.rule">
        <field name="name">가족수당 (1인 1만원, 4인 한도)</field>
        <field name="code">FAMALW</field>
        <field name="sequence">34</field>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="struct_id" ref="structure_kr_regular"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(inputs.get('FAM'))</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = min(int(inputs['FAM'].amount), 4) * 10000</field>
    </record>
    <record id="rule_kr_meal" model="hr.salary.rule">
        <field name="name">식대</field>
        <field name="code">MEAL</field>
        <field name="sequence">36</field>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="struct_id" ref="structure_kr_regular"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(inputs.get('MEAL'))</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = inputs['MEAL'].amount</field>
    </record>
    <record id="rule_kr_bonus" model="hr.salary.rule">
        <field name="name">상여금(월 분할)</field>
        <field name="code">BONUS</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="struct_id" ref="structure_kr_regular"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">if contract.kr_is_probation or inputs.get('BONUS0'):
    result = 0
else:
    pct = float(payslip.env['ir.config_parameter'].sudo().get_param('hr_payroll_kr.bonus_annual_pct', '650'))
    base = result_rules['BASIC']['total'] + result_rules['CALW']['total']
    if inputs.get('PAYFACT') and inputs['PAYFACT'].amount:
        base = base / (inputs['PAYFACT'].amount / 100.0)
    result = round(base * pct / 1200.0)</field>
    </record>
    <record id="rule_kr_ot_ext" model="hr.salary.rule">
        <field name="name">잔업수당 (통상시급×1.5)</field>
        <field name="code">OTEXT</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="struct_id" ref="structure_kr_regular"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(inputs.get('OTEXT'))</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">hours = float(payslip.env['ir.config_parameter'].sudo().get_param('hr_payroll_kr.monthly_hours', '209'))
hourly = (result_rules['BASIC']['total'] + result_rules['CALW']['total'] + result_rules['BONUS']['total']) / hours
result = round(hourly * 1.5 * inputs['OTEXT'].amount)</field>
    </record>
