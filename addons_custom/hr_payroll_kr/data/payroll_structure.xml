    <record id="rule_kr_inctax" model="hr.salary.rule">
        <field name="name">소득세 (간이세액표×조정율)</field>
        <field name="code">KRTAX</field>
        <field name="sequence">150</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="structure_kr_regular"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">dep = int(inputs['DEP'].amount) if inputs.get('DEP') else 1
tax = payslip.env['kr.income.tax.bracket']._lookup(result_rules['TAXBASE']['total'], dep, payslip.date_to)
result = -round(tax * (contract.kr_tax_adjust_pct or 100.0) / 100.0)</field>
