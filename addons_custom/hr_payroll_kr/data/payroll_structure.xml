        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="structure_kr_regular"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(inputs.get('LATE'))</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">daily = contract.kr_daily_wage if contract.kr_wage_type == 'daily' else contract.wage / 30.0
result = -round(daily / 8.0 * inputs['LATE'].amount)</field>
    </record>
    <record id="rule_kr_np" model="hr.salary.rule">
        <field name="name">국민연금 (EDI 고지액 우선)</field>
        <field name="code">KRNP</field>
        <field name="sequence">110</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="struct_id" ref="structure_kr_regular"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">notice = payslip.env['kr.insurance.notice']._notice_amount(employee, 'national_pension', payslip.date_to)
if notice is not None:
    result = -notice
else:
    result = -payslip.env['kr.payroll.rate']._employee_amount('national_pension', result_rules['TAXBASE']['total'], payslip.date_to)</field>
    </record>
