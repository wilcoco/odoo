        <field name="struct_id" ref="structure_kr_regular"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">limit = float(payslip.env['ir.config_parameter'].sudo().get_param('hr_payroll_kr.meal_tax_free', '200000'))
result = categories['GROSS'] - min(result_rules['MEAL']['total'], limit)</field>
