<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 급여 구조: 생산직 급여 매뉴얼(2025.04) 기반.
         수치·요율·고지액은 전부 데이터(요율 마스터/고지액/기타입력/파라미터) — 코드에 수치 없음.
         파라미터: hr_payroll_kr.bonus_annual_pct(상여 연 %, 기본 650),
                   hr_payroll_kr.monthly_hours(통상시급 분모, 기본 209),
                   hr_payroll_kr.meal_tax_free(식대 비과세 한도, 기본 200000),
                   hr_payroll_kr.proration(일할: fixed30 기본) -->
    <record id="structure_type_kr" model="hr.payroll.structure.type">
        <field name="name">한국 정규직</field>
        <field name="country_id" ref="base.kr"/>
    </record>

    <record id="structure_kr_regular" model="hr.payroll.structure">
        <field name="name">한국 표준 급여</field>
        <field name="type_id" ref="structure_type_kr"/>
        <field name="country_id" ref="base.kr"/>
    </record>

    <record id="rule_category_comp" model="hr.salary.rule.category">
        <field name="name">회사 부담분</field>
        <field name="code">KRCOMP</field>
