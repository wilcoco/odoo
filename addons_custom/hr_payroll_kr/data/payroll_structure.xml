    <!-- ═══ 지급 ═══ -->
    <record id="rule_kr_basic" model="hr.salary.rule">
        <field name="name">기본급</field>
        <field name="code">BASIC</field>
        <field name="sequence">1</field>
        <field name="category_id" ref="hr_payroll.BASIC"/>
        <field name="struct_id" ref="structure_kr_regular"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">factor = 0.9 if contract.kr_is_probation else 1.0
if inputs.get('PAYFACT'):
    factor *= inputs['PAYFACT'].amount / 100.0
if contract.kr_wage_type == 'daily':
    days = inputs['DAYS'].amount if inputs.get('DAYS') else 0
    result = round(contract.kr_daily_wage * days * factor)
else:
    pf = payslip.env['kr.payroll.rate']._proration_factor(contract, payslip.date_from, payslip.date_to)
    result = round(contract.wage * pf * factor)</field>
    </record>
    <record id="rule_kr_calw" model="hr.salary.rule">
        <field name="name">통상수당</field>
        <field name="code">CALW</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="hr_payroll.ALW"/>
        <field name="struct_id" ref="structure_kr_regular"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = bool(inputs.get('CALW'))</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">factor = 0.9 if contract.kr_is_probation else 1.0
if inputs.get('PAYFACT'):
    factor *= inputs['PAYFACT'].amount / 100.0
result = round(inputs['CALW'].amount * factor)</field>
    </record>
    <record id="rule_kr_oalw" model="hr.salary.rule">
        <field name="name">기타수당</field>
