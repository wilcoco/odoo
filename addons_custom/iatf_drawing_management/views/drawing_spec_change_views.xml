<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_drawing_spec_change_list" model="ir.ui.view">
        <field name="name">iatf.drawing.spec.change.list</field>
        <field name="model">iatf.drawing.spec.change</field>
        <field name="arch" type="xml">
            <list>
                <field name="eo_number"/>
                <field name="product_group_id"/>
                <field name="drawing_type_id"/>
                <field name="product_standard_id"/>
                <field name="category_item_id"/>
                <field name="part_number"/>
                <field name="part_name"/>
                <field name="car_model_id"/>
                <field name="revision"/>
                <field name="customer_received_date"/>
                <field name="distributor_id"/>
                <field name="retention_year_id"/>
                <field name="specification_id"/>
                <field name="attachment_link" widget="url"/>
                <field name="document_status_id"/>
                <field name="approval_state" widget="badge"
                       decoration-success="approval_state == 'approved'"
                       decoration-info="approval_state == 'in_progress'"
                       decoration-warning="approval_state == 'draft'"
                       decoration-danger="approval_state == 'rejected'"/>
                <field name="approval_current_approver_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="view_drawing_spec_change_form" model="ir.ui.view">
        <field name="name">iatf.drawing.spec.change.form</field>
        <field name="model">iatf.drawing.spec.change</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="approval_state" widget="statusbar"
                           statusbar_visible="draft,in_progress,approved,rejected"/>
                    <button name="action_submit_approval" string="Submit" type="object"
                            class="oe_highlight" invisible="approval_state and approval_state != 'draft'"/>
                    <button name="action_approve_approval" string="Approve" type="object"
                            class="oe_highlight"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <button name="action_reject_approval" string="Reject" type="object"
                            class="btn-secondary"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <button name="action_reset_approval" string="Reset to Draft" type="object"
                            invisible="approval_state != 'approved' and approval_state != 'rejected'"
                            groups="iatf_drawing_management.group_drawing_manager"/>
                </header>
                <sheet>
                    <field name="approval_request_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="eo_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_group_id"/>
                            <field name="drawing_type_id"/>
                            <field name="product_standard_id"/>
                            <field name="category_item_id"/>
                            <field name="part_number"/>
                            <field name="part_name"/>
                            <field name="car_model_id"/>
                            <field name="revision"/>
                        </group>
                        <group>
                            <field name="customer_received_date"/>
                            <field name="distributor_id"/>
                            <field name="retention_year_id"/>
                            <field name="specification_id"/>
                            <field name="attachment_link" widget="url"/>
                            <field name="document_status_id"/>
                            <field name="approval_current_approver_id" widget="many2one_avatar_user" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                    <notebook>
                        <page string="결재선" name="approvals">
                            <field name="approval_line_ids" readonly="approval_state and approval_state != 'draft'" context="{'default_request_id': approval_request_id}">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'approved'"
                                           decoration-info="state == 'pending'"
                                           decoration-danger="state == 'rejected'"
                                           decoration-muted="state == 'new'"/>
                                    <field name="action_date"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_drawing_spec_change_search" model="ir.ui.view">
        <field name="name">iatf.drawing.spec.change.search</field>
        <field name="model">iatf.drawing.spec.change</field>
        <field name="arch" type="xml">
            <search>
                <field name="eo_number"/>
                <field name="part_number"/>
                <field name="part_name"/>
                <field name="product_group_id"/>
                <field name="drawing_type_id"/>
                <field name="product_standard_id"/>
                <field name="car_model_id"/>
                <field name="document_status_id"/>
                <filter string="도면구분" name="group_drawing_type" context="{'group_by': 'drawing_type_id'}"/>
                <filter string="문서상태" name="group_document_status" context="{'group_by': 'document_status_id'}"/>
                <filter string="제품군" name="group_product_group" context="{'group_by': 'product_group_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_drawing_spec_change" model="ir.actions.act_window">
        <field name="name">기술사양변경 내역서</field>
        <field name="res_model">iatf.drawing.spec.change</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_drawing_spec_change_search"/>
    </record>
</odoo>
