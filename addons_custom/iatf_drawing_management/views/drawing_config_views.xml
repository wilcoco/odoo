<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_drawing_config_list" model="ir.ui.view">
        <field name="name">iatf.drawing.config.list</field>
        <field name="model">iatf.drawing.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="config_type"/>
                <field name="name"/>
                <field name="sequence"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_drawing_config_form" model="ir.ui.view">
        <field name="name">iatf.drawing.config.form</field>
        <field name="model">iatf.drawing.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="config_type"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_drawing_config" model="ir.actions.act_window">
        <field name="name">도면관리 설정</field>
        <field name="res_model">iatf.drawing.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
