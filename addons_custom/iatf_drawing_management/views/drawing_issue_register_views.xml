<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_drawing_issue_register_list" model="ir.ui.view">
        <field name="name">iatf.drawing.issue.register.list</field>
        <field name="model">iatf.drawing.issue.register</field>
        <field name="arch" type="xml">
            <list>
                <field name="issue_number"/>
                <field name="drawing_number"/>
                <field name="drawing_title"/>
                <field name="revision"/>
                <field name="issue_date"/>
                <field name="issued_by_id"/>
                <field name="recipient_id"/>
                <field name="department_id"/>
                <field name="document_status_id"/>
                <field name="file_link" widget="url"/>
            </list>
        </field>
    </record>

    <record id="view_drawing_issue_register_form" model="ir.ui.view">
        <field name="name">iatf.drawing.issue.register.form</field>
        <field name="model">iatf.drawing.issue.register</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="issue_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="drawing_number"/>
                            <field name="drawing_title"/>
                            <field name="revision"/>
                            <field name="issue_date"/>
                        </group>
                        <group>
                            <field name="issued_by_id"/>
                            <field name="recipient_id"/>
                            <field name="department_id"/>
                            <field name="document_status_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="purpose"/>
                        <field name="file_link" widget="url"/>
                        <field name="note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_drawing_issue_register" model="ir.actions.act_window">
        <field name="name">도면 불출대장</field>
        <field name="res_model">iatf.drawing.issue.register</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
