<odoo>
<record id="group_drawing_user" model="res.groups"><field name="implied_ids" eval="[(4,ref('cams_evidence_core.group_evidence_user'))]"/></record>
<record id="agreement_line_company" model="ir.rule"><field name="name">협정 항목 회사 격리</field><field name="model_id" ref="model_iatf_drawing_agreement_line"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="conformity_company" model="ir.rule"><field name="name">도면 대조 회사 격리</field><field name="model_id" ref="model_iatf_drawing_conformity_check"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="access_line_author" model="ir.model.access"><field name="name">line_author</field><field name="model_id" ref="model_iatf_drawing_agreement_line"/><field name="group_id" ref="iatf_document_control.group_document_user"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="True"/></record>
<record id="access_line_read" model="ir.model.access"><field name="name">line_read</field><field name="model_id" ref="model_iatf_drawing_agreement_line"/><field name="group_id" ref="cams_evidence_core.group_evidence_user"/><field name="perm_read" eval="True"/><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
<record id="access_conformity_user" model="ir.model.access"><field name="name">conformity_user</field><field name="model_id" ref="model_iatf_drawing_conformity_check"/><field name="group_id" ref="group_drawing_user"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="False"/></record>
<record id="access_conformity_manager" model="ir.model.access"><field name="name">conformity_manager</field><field name="model_id" ref="model_iatf_drawing_conformity_check"/><field name="group_id" ref="group_drawing_manager"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="True"/></record>
<record id="view_document_agreement" model="ir.ui.view"><field name="name">iatf.document.agreement</field><field name="model">iatf.document</field><field name="inherit_id" ref="iatf_document_control.view_document_quality_evidence"/><field name="arch" type="xml"><field name="quality_cycle_note" position="after"><group string="체결된 검사협정" invisible="quality_evidence_kind != 'drawing_agreement'">
<field name="quality_drawing_number"/><field name="quality_drawing_revision"/><field name="quality_agreement_number"/><field name="quality_agreement_customer_id"/><field name="quality_agreement_interval_months"/>
<field name="quality_agreement_line_ids" readonly="state != 'draft'"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="criterion"/><field name="output_document"/><field name="process_name"/><field name="frequency"/></list></field>
</group></field></field></record>
<record id="view_conformity_list" model="ir.ui.view"><field name="name">iatf.drawing.conformity.check.list</field><field name="model">iatf.drawing.conformity.check</field><field name="arch" type="xml"><list><field name="name"/><field name="planned_date"/><field name="checked_date"/><field name="product_id"/><field name="actual_drawing_number"/><field name="actual_revision"/><field name="result"/><field name="approval_state"/><field name="evidence_state"/></list></field></record>
<record id="view_conformity_form" model="ir.ui.view"><field name="name">iatf.drawing.conformity.check.form</field><field name="model">iatf.drawing.conformity.check</field><field name="arch" type="xml"><form><header>
<button name="action_submit_approval" type="object" string="검토 상신" invisible="evidence_state == 'done' or approval_state not in ('draft','rejected',False)"/>
<button name="action_approve_approval" type="object" string="승인" invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
<button name="action_reject_approval" type="object" string="반려" invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
<button name="action_complete_evidence" type="object" string="검증 완료" invisible="approval_state != 'approved' or evidence_state == 'done'"/>
<button name="action_new_evidence_revision" type="object" string="정정 개정" invisible="evidence_state != 'done'"/>
<field name="approval_is_current_user" invisible="1"/><field name="approval_state" widget="badge"/><field name="evidence_state" widget="statusbar"/>
</header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><field name="company_id" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="record_date" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="responsible_id" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="product_id" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="lot_id" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="workcenter_id" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="trace_exception" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="agreement_document_id" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="planned_date" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="checked_date" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="actual_drawing_number" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="actual_revision" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="actual_agreement_number" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="check_method" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="result" readonly="1"/><field name="action_note" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/></group><field name="attachment_ids" widget="many2many_binary"/><notebook><page string="결재선"><field name="approval_line_ids" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"><list editable="bottom"><field name="sequence" widget="handle"/><field name="user_id"/><field name="state" readonly="1"/></list></field></page>
<page string="완료·개정"><group><field name="evidence_revision"/><field name="previous_evidence_id"/><field name="completed_by_id"/><field name="completed_at"/></group><field name="completion_snapshot"/></page></notebook></sheet><chatter/></form></field></record>
<record id="action_conformity" model="ir.actions.act_window"><field name="name">도면·검사협정 현장 대조</field><field name="res_model">iatf.drawing.conformity.check</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_conformity" name="도면·검사협정 현장 대조" parent="menu_iatf_drawing_root" action="action_conformity" groups="group_drawing_user" sequence="50"/>
</odoo>