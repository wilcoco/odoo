<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_injection_planning" model="ir.module.category">
        <field name="name">사출 생산계획</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_planning_user" model="res.groups">
        <field name="name">생산계획 담당자</field>
        <field name="category_id" ref="module_category_injection_planning"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_planning_manager" model="res.groups">
        <field name="name">생산계획 관리자</field>
        <field name="category_id" ref="module_category_injection_planning"/>
        <field name="implied_ids" eval="[(4, ref('group_planning_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
