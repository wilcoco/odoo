<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_demand_wizard_form" model="ir.ui.view">
        <field name="name">injection.import.demand.wizard.form</field>
        <field name="model">injection.import.demand.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="planning_run_id" readonly="1"/>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                    <field name="replace_oracle"/>
                </group>
                <p class="text-muted">
                    CSV 파일 형식: demand_date, product_code, quantity, demand_type, hour, source<br/>
                    로컬 Oracle 추출 스크립트(extract_demand.py)로 생성된 파일을 업로드하세요.
                </p>
                <footer>
                    <button name="action_import" string="임포트" type="object" class="btn-primary"/>
                    <button string="취소" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
