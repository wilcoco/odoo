<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_generate_mo_wizard_form" model="ir.ui.view">
        <field name="name">injection.generate.mo.wizard.form</field>
        <field name="model">injection.generate.mo.wizard</field>
        <field name="arch" type="xml">
            <form string="MO 생성 확인">
                <group>
                    <group>
                        <field name="planning_run_id" readonly="1"/>
                        <field name="line_count"/>
                    </group>
                    <group>
                        <field name="total_qty"/>
                        <field name="changeover_count"/>
                    </group>
                </group>
                <separator string=""/>
                <p class="text-muted">
                    위 내용으로 제조 오더를 생성합니다. 계속하시겠습니까?
                </p>
                <footer>
                    <button name="action_generate" string="MO 생성" type="object" class="btn-primary"/>
                    <button string="취소" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
