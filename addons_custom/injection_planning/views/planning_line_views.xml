<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 리스트 (독립 조회용) -->
    <record id="view_planning_line_list" model="ir.ui.view">
        <field name="name">injection.planning.line.list</field>
        <field name="model">injection.planning.line</field>
        <field name="arch" type="xml">
            <list decoration-warning="changeover_needed == True">
                <field name="planning_run_id"/>
                <field name="plan_date"/>
                <field name="workcenter_id"/>
                <field name="mold_id"/>
                <field name="product_id"/>
                <field name="demand_qty"/>
                <field name="planned_qty"/>
                <field name="defect_rate"/>
                <field name="changeover_needed"/>
                <field name="total_hours"/>
                <field name="mo_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_planning_line" model="ir.actions.act_window">
        <field name="name">계획 상세</field>
        <field name="res_model">injection.planning.line</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ═══════════════════════════════════════════
         사출기 생산 계획 리포트
         ═══════════════════════════════════════════ -->

    <!-- 리스트 뷰: 날짜 → 사출기 그룹핑 -->
    <record id="view_machine_production_report_list" model="ir.ui.view">
        <field name="name">injection.planning.line.machine.report.list</field>
        <field name="model">injection.planning.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list decoration-warning="changeover_needed == True"
                  default_group_by="plan_date">
                <field name="planning_run_id" column_invisible="1"/>
                <field name="plan_date"/>
                <field name="workcenter_id"/>
                <field name="mold_id"/>
                <field name="product_id"/>
                <field name="demand_qty" sum="합계"/>
                <field name="planned_qty" sum="합계"/>
                <field name="changeover_needed"/>
                <field name="changeover_hours" sum="합계"/>
                <field name="production_hours" sum="합계"/>
                <field name="total_hours" sum="합계"/>
                <field name="start_time" widget="datetime" optional="hide"/>
                <field name="end_time" widget="datetime" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- 피벗 뷰: 날짜×사출기 → 제품별 수량 -->
    <record id="view_machine_production_report_pivot" model="ir.ui.view">
        <field name="name">injection.planning.line.machine.report.pivot</field>
        <field name="model">injection.planning.line</field>
        <field name="arch" type="xml">
            <pivot string="사출기 생산 계획">
                <field name="plan_date" type="row"/>
                <field name="workcenter_id" type="row"/>
                <field name="product_id" type="col"/>
                <field name="planned_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- 검색 뷰 -->
    <record id="view_machine_production_report_search" model="ir.ui.view">
        <field name="name">injection.planning.line.machine.report.search</field>
        <field name="model">injection.planning.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <search string="사출기 생산 계획">
                <field name="planning_run_id"/>
                <field name="workcenter_id"/>
                <field name="product_id"/>
                <field name="mold_id"/>
                <separator/>
                <filter name="changeover_only"
                        string="금형교환 건만"
                        domain="[('changeover_needed', '=', True)]"/>
                <separator/>
                <group expand="0" string="그룹">
                    <filter name="group_date" string="날짜"
                            context="{'group_by': 'plan_date'}"/>
                    <filter name="group_machine" string="사출기"
                            context="{'group_by': 'workcenter_id'}"/>
                    <filter name="group_product" string="제품"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_mold" string="금형"
                            context="{'group_by': 'mold_id'}"/>
                </group>
                <searchpanel>
                    <field name="planning_run_id" icon="fa-calendar"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- 액션 -->
    <record id="action_machine_production_report" model="ir.actions.act_window">
        <field name="name">사출기 생산 계획</field>
        <field name="res_model">injection.planning.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="view_machine_production_report_search"/>
        <field name="context">{
            'group_by': ['plan_date', 'workcenter_id'],
        }</field>
    </record>

    <!-- 뷰 바인딩 -->
    <record id="action_machine_production_report_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_machine_production_report_list"/>
        <field name="act_window_id" ref="action_machine_production_report"/>
    </record>
    <record id="action_machine_production_report_view_pivot" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_machine_production_report_pivot"/>
        <field name="act_window_id" ref="action_machine_production_report"/>
    </record>

</odoo>
