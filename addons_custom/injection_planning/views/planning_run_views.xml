<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 검색 -->
    <record id="view_planning_run_search" model="ir.ui.view">
        <field name="name">injection.planning.run.search</field>
        <field name="model">injection.planning.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="draft" string="초안" domain="[('state','=','draft')]"/>
                <filter name="review" string="검토중" domain="[('state','=','review')]"/>
                <filter name="confirmed" string="확정" domain="[('state','=','confirmed')]"/>
            </search>
        </field>
    </record>

    <!-- 리스트 -->
    <record id="view_planning_run_list" model="ir.ui.view">
        <field name="name">injection.planning.run.list</field>
        <field name="model">injection.planning.run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="plan_date_from"/>
                <field name="plan_date_to"/>
                <field name="demand_source_filter"/>
                <field name="total_planned_qty"/>
                <field name="total_changeovers"/>
                <field name="mo_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('calculating', 'review')"
                       decoration-success="state in ('confirmed', 'done')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- 폼 -->
    <record id="view_planning_run_form" model="ir.ui.view">
        <field name="name">injection.planning.run.form</field>
        <field name="model">injection.planning.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_demands" string="수요 로드"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            help="기존 생산 수요 데이터 로드"/>
                    <button name="action_fetch_demand" string="Oracle 연동"
                            type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_import_demand_file" string="CSV 업로드"
                            type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_add_manual_demand" string="수동 추가"
                            type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_generate_availability" string="가동 일정 설정"
                            type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_calculate_plan" string="계획 계산"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="계획을 계산하시겠습니까?"/>
                    <button name="action_create_material_po" string="원재료 부족분 발주"
                            type="object" class="btn-warning"
                            invisible="state not in ('review', 'confirmed') or material_shortage_count == 0"
                            confirm="부족한 원재료를 공급업체별로 발주하시겠습니까?"/>
                    <button name="action_confirm_generate_mo" string="확정 (MO 생성)"
                            type="object" class="btn-success"
                            invisible="state != 'review'"/>
                    <button name="action_cancel" string="취소"
                            type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" string="초안으로"
                            type="object"
                            invisible="state not in ('review', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_mos" type="object"
                                class="oe_stat_button" icon="fa-industry"
                                invisible="mo_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="mo_count"/>
                                </span>
                                <span class="o_stat_text">제조 오더</span>
                            </div>
                        </button>
                        <button name="action_view_daily_summary" type="object"
                                class="oe_stat_button" icon="fa-bar-chart"
                                invisible="state == 'draft'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">일별 분석</span>
                            </div>
                        </button>
                        <button name="action_view_material_requirements" type="object"
                                class="oe_stat_button" icon="fa-flask"
                                invisible="state == 'draft'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value text-danger"
                                      invisible="material_shortage_count == 0">
                                    <field name="material_shortage_count"/>
                                </span>
                                <span class="o_stat_text">원재료 부족</span>
                            </div>
                        </button>
                        <button name="action_view_material_daily" type="object"
                                class="oe_stat_button" icon="fa-line-chart"
                                invisible="state == 'draft'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">원재료 추이</span>
                            </div>
                        </button>
                        <button name="action_view_material_pos" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="material_po_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="material_po_count"/>
                                </span>
                                <span class="o_stat_text">원재료 발주</span>
                            </div>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="material_shortage_count == 0 or state == 'draft'">
                        <strong>⚠ 원재료 부족 경고</strong> —
                        <field name="material_shortage_count" class="oe_inline"/>개 원재료의
                        현재 재고가 계획 소요량보다 부족합니다.
                        '원재료 소요/재고' 탭에서 확인 후 확정하세요.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="derived_stale == False">
                        <strong>⚠ 소요 재검증 필요</strong> — 계획 라인을 고친 뒤
                        원재료 소요와 일별 차트가 다시 계산되지 않았습니다.
                        <b>발주·MO 생성이 막혀 있습니다.</b>
                        <button name="action_revalidate_requirements" type="object"
                                string="소요 재검증" class="btn btn-primary btn-sm ms-2"/>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="unverified_line_count == 0">
                        <strong>⚠ 적합성 미확인</strong> —
                        <field name="unverified_line_count" class="oe_inline"/>개 라인이
                        필수 적합성 자료(사출기 형체력 등)가 없어 물리적으로 가능한지
                        확인되지 않았습니다. <b>확정·MO 생성이 막혀 있습니다.</b>
                        기준정보를 채운 뒤 '초안으로' 되돌려 다시 계산하십시오.
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="unassigned_count == 0">
                        <strong>⚠ 미배정 수요</strong> —
                        <field name="unassigned_count" class="oe_inline"/>건이 설비·금형의
                        물리 제약으로 배정되지 않았습니다. '미배정 수요' 탭을 확인하십시오.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="plan_date_from"/>
                            <field name="plan_date_to"/>
                            <field name="schedule_not_before" readonly="state != 'draft'"/>
                        </group>
                        <group string="수량">
                            <field name="theoretical_qty"/>
                            <field name="total_planned_qty" string="확정 가능 배정량"/>
                            <field name="unassigned_qty"/>
                        </group>
                        <group string="일정">
                            <field name="total_changeovers"/>
                            <field name="changeover_hours_total"/>
                            <field name="late_line_count"/>
                            <field name="derived_stale" invisible="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="계획 라인" name="lines">
                            <field name="line_ids">
                                <list editable="bottom"
                                      decoration-warning="changeover_needed == True"
                                      decoration-danger="is_late == True"
                                      decoration-muted="fit_unverified == True">
                                    <field name="sequence" widget="handle"/>
                                    <field name="plan_date"/>
                                    <field name="start_date" optional="show"/>
                                    <field name="finish_date" optional="show"/>
                                    <field name="is_late" optional="show"/>
                                    <field name="fit_unverified" optional="show"/>
                                    <field name="fit_note" optional="hide"/>
                                    <field name="start_time" optional="show"/>
                                    <field name="end_time" optional="show"/>
                                    <field name="shift" optional="hide"/>
                                    <field name="workcenter_id"/>
                                    <field name="mold_id"/>
                                    <field name="product_id"/>
                                    <field name="demand_qty"/>
                                    <field name="planned_qty"/>
                                    <field name="defect_rate"/>
                                    <field name="initial_scrap"/>
                                    <field name="changeover_needed"/>
                                    <field name="changeover_hours" optional="show"/>
                                    <field name="production_hours" optional="show"/>
                                    <field name="total_hours"/>
                                    <field name="current_stock" optional="hide"/>
                                    <field name="max_inventory" optional="hide"/>
                                    <field name="mo_id" optional="hide"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="미배정 수요" name="unassigned"
                              invisible="unassigned_count == 0">
                            <div class="alert alert-info" role="alert">
                                <b>이론 최대 생산량</b> 은 금형 설치·교체 시간을 세지 않은
                                값입니다. 실제로 생산할 수 있는 것은 <b>확정 가능 배정량</b>
                                이며, 그 차이가 아래 미배정 수량입니다.
                            </div>
                            <div class="alert alert-warning" role="alert">
                                설비·금형의 물리 제약(형체력·금형 상태·가동시간)으로 배정하지
                                못한 수요입니다. 마스터를 고치거나 가동일정을 늘린 뒤 '초안으로'
                                되돌려 다시 계산하십시오.
                            </div>
                            <field name="unassigned_ids" readonly="1">
                                <list>
                                    <field name="plan_date"/>
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="reason" widget="badge"/>
                                    <field name="detail"/>
                                </list>
                            </field>
                        </page>
                        <page string="원재료 소요/재고" name="materials">
                            <field name="material_requirement_ids" readonly="1">
                                <list decoration-danger="is_short == True"
                                      decoration-warning="coverage_rate &lt; 150 and is_short == False">
                                    <field name="material_id"/>
                                    <field name="required_qty" sum="총 소요"/>
                                    <field name="available_qty"/>
                                    <field name="shortage_qty"/>
                                    <!-- 검사대기는 가용재고가 아니다. 부족 판정·발주 계산에
                                         들어가지 않으며, 여기서 다시 빼지도 않는다(이중 차감 금지).
                                         '조회 불가' 와 '실제 0' 은 다른 사실이라 상태를 함께 보여 준다. -->
                                    <field name="iqc_status" widget="badge"
                                           decoration-info="iqc_status == 'counted'"
                                           decoration-warning="iqc_status == 'unavailable'"
                                           optional="show"/>
                                    <field name="iqc_pending_qty" optional="show"
                                           invisible="iqc_status != 'counted'"/>
                                    <field name="iqc_reserved_qty" optional="hide"
                                           invisible="iqc_status != 'counted'"/>
                                    <field name="iqc_status_note" optional="hide"/>
                                    <field name="coverage_rate"/>
                                    <field name="uom_id" optional="show"/>
                                    <field name="first_need_date"/>
                                    <field name="ordered_qty" optional="show"/>
                                    <field name="purchase_order_id" optional="show"/>
                                    <field name="is_short" widget="boolean"/>
                                </list>
                            </field>
                        </page>
                        <page string="원재료 일별 추이" name="material_daily">
                            <field name="material_daily_ids" readonly="1">
                                <list decoration-danger="is_short == True">
                                    <field name="plan_date"/>
                                    <field name="material_id"/>
                                    <field name="required_qty" sum="총 소요"/>
                                    <field name="stock_start"/>
                                    <field name="stock_end"/>
                                    <field name="is_short" widget="boolean"/>
                                </list>
                            </field>
                        </page>
                        <page string="수요 데이터" name="demands">
                            <field name="demand_ids">
                                <list>
                                    <field name="demand_date"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="demand_type"/>
                                    <field name="hour"/>
                                    <field name="source"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="비고" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- 액션 -->
    <record id="action_planning_run" model="ir.actions.act_window">
        <field name="name">계획 실행</field>
        <field name="res_model">injection.planning.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_planning_run_search"/>
    </record>
</odoo>
