<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        수요 데이터는 production_planning 모듈의 production.demand 사용
        여기서는 사출 계획용 액션만 정의 (기본 필터 적용)
    -->

    <!-- 사출 계획용 수요 액션 (production.demand 재사용) -->
    <record id="action_demand" model="ir.actions.act_window">
        <field name="name">수요 데이터</field>
        <field name="res_model">production.demand</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_draft': 1, 'search_default_confirmed': 1}</field>
    </record>

</odoo>
