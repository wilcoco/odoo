<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_planning_config_form" model="ir.ui.view">
        <field name="name">injection.planning.config.form</field>
        <field name="model">injection.planning.config</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="저장" type="object" name="action_save_config" class="btn-primary"/>
                </header>
                <sheet>
                    <group string="Oracle 연결 정보">
                        <group>
                            <field name="oracle_host"/>
                            <field name="oracle_port"/>
                            <field name="oracle_sid"/>
                            <field name="oracle_client_path"
                                   placeholder="/Users/user/instantclient_23_3"/>
                        </group>
                        <group>
                            <field name="oracle_user"/>
                            <field name="oracle_password"/>
                            <button name="action_test_oracle_connection"
                                    string="연결 테스트" type="object"
                                    class="btn-primary"/>
                        </group>
                    </group>
                    <group string="Oracle 테이블">
                        <group>
                            <field name="hourly_table"/>
                            <field name="daily_table"/>
                        </group>
                    </group>
                    <group string="커스텀 SQL 쿼리 (선택)">
                        <field name="demand_query_daily" placeholder="비워두면 기본 테이블에서 자동 조회"/>
                        <field name="demand_query_hourly" placeholder="비워두면 기본 테이블에서 자동 조회"/>
                    </group>
                    <group string="자동화 설정">
                        <group>
                            <field name="auto_generate_mo"/>
                            <field name="planning_horizon"/>
                        </group>
                        <group>
                            <field name="mo_split_mode"/>
                        </group>
                    </group>
                    <group string="교대 근무">
                        <group>
                            <field name="day_shift_hours"/>
                            <field name="day_shift_start"/>
                        </group>
                        <group>
                            <field name="night_shift_hours"/>
                            <field name="night_shift_start"/>
                        </group>
                    </group>
                    <group string="안전재고">
                        <group>
                            <field name="safety_stock_days"/>
                        </group>
                    </group>
                    <group string="글로벌 기본값">
                        <group>
                            <field name="default_changeover"/>
                            <field name="default_defect_rate"/>
                        </group>
                        <group>
                            <field name="default_initial_scrap"/>
                            <field name="default_min_lot_size"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 서버 액션: 싱글톤 설정 열기 -->
    <record id="action_planning_config_server" model="ir.actions.server">
        <field name="name">생산계획 설정</field>
        <field name="model_id" ref="model_injection_planning_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_config()</field>
    </record>

    <record id="action_planning_config" model="ir.actions.act_window">
        <field name="name">생산계획 설정</field>
        <field name="res_model">injection.planning.config</field>
        <field name="res_id" ref="default_planning_config"/>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
    </record>
</odoo>
