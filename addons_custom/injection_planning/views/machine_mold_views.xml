<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 리스트 -->
    <record id="view_machine_mold_list" model="ir.ui.view">
        <field name="name">injection.machine.mold.capability.list</field>
        <field name="model">injection.machine.mold.capability</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="workcenter_id"/>
                <field name="mold_id"/>
                <field name="product_id"/>
                <field name="cavity_count"/>
                <field name="cycle_time"/>
                <field name="defect_rate"/>
                <field name="initial_scrap"/>
                <field name="hourly_capacity"/>
                <field name="machine_clamping_ton" optional="show"/>
                <field name="required_clamping_ton" optional="show"/>
            </list>
        </field>
    </record>

    <!-- 액션 -->
    <record id="action_machine_mold_capability" model="ir.actions.act_window">
        <field name="name">사출기-금형 조합</field>
        <field name="res_model">injection.machine.mold.capability</field>
        <field name="view_mode">list</field>
    </record>
    <record id="view_mrp_workcenter_form_clamping" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.clamping</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="x_clamping_force_ton"/>
            </xpath>
        </field>
    </record>
</odoo>
