<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 검색 뷰: 제품 필터(도메인) + 결품 위기 필터 -->
    <record id="view_daily_summary_search" model="ir.ui.view">
        <field name="name">injection.planning.daily.summary.search</field>
        <field name="model">injection.planning.daily.summary</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id" string="사출 부품"
                       filter_domain="[('product_id', '=', raw_value)]"/>
                <field name="planning_run_id"/>
                <separator/>
                <filter name="shortage_only" string="결품 위기만"
                        domain="[('shortage_risk', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- 그래프: X축=날짜, Y축=소요량/생산량/재고/안전재고 (제품 필터 후 사용) -->
    <record id="view_daily_summary_graph" model="ir.ui.view">
        <field name="name">injection.planning.daily.summary.graph</field>
        <field name="model">injection.planning.daily.summary</field>
        <field name="arch" type="xml">
            <graph type="line" stacked="0">
                <field name="plan_date" interval="day"/>
                <field name="demand_qty" type="measure"/>
                <field name="planned_qty" type="measure"/>
                <field name="stock_end" type="measure"/>
                <field name="safety_stock_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- 피벗 뷰 (제품 × 날짜 교차표) -->
    <record id="view_daily_summary_pivot" model="ir.ui.view">
        <field name="name">injection.planning.daily.summary.pivot</field>
        <field name="model">injection.planning.daily.summary</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="product_id" type="row"/>
                <field name="plan_date" interval="day" type="col"/>
                <field name="demand_qty" type="measure"/>
                <field name="planned_qty" type="measure"/>
                <field name="stock_end" type="measure"/>
                <field name="safety_stock_qty" type="measure"/>
                <field name="shortage_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- 리스트 뷰 - 결품 위기 행 빨간색 강조 -->
    <record id="view_daily_summary_list" model="ir.ui.view">
        <field name="name">injection.planning.daily.summary.list</field>
        <field name="model">injection.planning.daily.summary</field>
        <field name="arch" type="xml">
            <list decoration-danger="shortage_risk == True"
                  decoration-warning="stock_end &lt; safety_stock_qty * 1.5 and shortage_risk == False">
                <field name="plan_date"/>
                <field name="product_id"/>
                <field name="demand_qty" sum="합계"/>
                <field name="planned_qty" sum="합계"/>
                <field name="safety_stock_qty"/>
                <field name="stock_start"/>
                <field name="stock_end"/>
                <field name="shortage_risk" widget="boolean"/>
                <field name="shortage_qty"/>
            </list>
        </field>
    </record>

    <!-- 액션 -->
    <record id="action_daily_summary" model="ir.actions.act_window">
        <field name="name">일별 생산계획 분석</field>
        <field name="res_model">injection.planning.daily.summary</field>
        <field name="view_mode">graph,list,pivot</field>
        <field name="search_view_id" ref="view_daily_summary_search"/>
    </record>
</odoo>
