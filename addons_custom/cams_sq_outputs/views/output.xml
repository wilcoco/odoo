<odoo>
  <record id="ops_coverage" model="ir.ui.view"><field name="name">ops.task.def.sq.coverage</field><field name="model">ops.task.def</field><field name="inherit_id" ref="cams_ops_process.view_ops_task_def_form"/><field name="arch" type="xml"><xpath expr="//field[@name='role_id']" position="after"><field name="company_id"/><field name="sq_coverage_kind"/></xpath></field></record>
  <record id="sheet_scale" model="ir.ui.view"><field name="name">check.sheet.scale</field><field name="model">iatf.check.sheet</field><field name="inherit_id" ref="iatf_work_environment.view_check_sheet_form"/><field name="arch" type="xml"><xpath expr="//field[@name='item_ids']/list/field[@name='standard']" position="after"><field name="five_point_required" optional="hide"/><field name="five_point_definition" optional="hide"/><field name="stop_score" optional="hide"/></xpath></field></record>
  <record id="record_scale" model="ir.ui.view"><field name="name">check.record.scale</field><field name="model">iatf.check.record</field><field name="inherit_id" ref="iatf_work_environment.view_check_record_form"/><field name="arch" type="xml"><xpath expr="//field[@name='line_ids']/list/field[@name='item_name']" position="after"><field name="five_point_required" column_invisible="True"/><field name="five_point_score" readonly="not five_point_required" optional="show"/><field name="stop_score" optional="hide"/><field name="five_point_definition" optional="hide"/></xpath></field></record>
  <record id="requirement_form" model="ir.ui.view"><field name="name">sq.requirement.output</field><field name="model">sq.doc.requirement</field><field name="inherit_id" ref="cams_sq.view_requirement_form"/><field name="arch" type="xml">
    <xpath expr="//sheet" position="inside">
      <group string="서류 출력"><button name="action_output" type="object" string="기간별 PDF·엑셀 출력" class="btn-primary"/>
        <field name="source_key"/><field name="output_type" readonly="1" groups="!cams_sq.group_sq_manager"/><field name="output_type" groups="cams_sq.group_sq_manager"/>
        <field name="output_model" readonly="1" groups="!cams_sq.group_sq_manager"/><field name="output_model" groups="cams_sq.group_sq_manager"/>
        <field name="output_source_hint"/><field name="output_revision"/><field name="output_priority"/><field name="output_format"/>
        <p>실제 원천 또는 점검 대상을 연결하세요. 현재 출력과 과거 승인 증빙을 구분하며, 자료가 없으면 미비 사유를 표시합니다.</p>
        <field name="output_binding_ids" groups="cams_sq.group_sq_manager"><list editable="bottom"><field name="source_ref" options="{'no_create': True}"/><field name="purpose"/><field name="active"/><button name="action_open_source" type="object" string="원천 열기"/></list></field>
        <field name="output_binding_ids" readonly="1" groups="!cams_sq.group_sq_manager"><list><field name="source_ref"/><field name="purpose"/><field name="active"/></list></field>
      </group>
    </xpath>
  </field></record>
  <record id="wizard_form" model="ir.ui.view"><field name="name">sq.output.wizard.form</field><field name="model">sq.output.wizard</field><field name="arch" type="xml"><form string="서류 출력"><group><field name="requirement_ids" widget="many2many_tags" options="{'no_create': True}"/><field name="date_from"/><field name="date_to"/><field name="include_details"/></group><p>실제 원천의 조회 권한을 적용합니다. 미연결·미승인 자료는 미비로 표시하며, 승인된 과거 평가서의 근거를 바꾸지 않습니다.</p><footer><button name="action_pdf" type="object" string="PDF" class="btn-primary"/><button name="action_xlsx" type="object" string="엑셀"/><button name="action_native_pdf" type="object" string="기존 전용 서식(CP·FMEA·8D)"/><button special="cancel" string="닫기"/></footer></form></field></record>
  <record id="upload_form" model="ir.ui.view"><field name="name">sq.output.upload.form</field><field name="model">sq.output.upload</field><field name="arch" type="xml"><form string="서류 일괄 업로드"><group><field name="company_id"/><field name="category_id" options="{'no_create': True}"/><field name="archive" filename="filename"/><field name="filename" invisible="1"/></group><p>서류 준비 현황의 원본 행 키를 폴더 이름으로 사용하세요. 예: CHECK.004/기준서.pdf. ZIP 안에 해당 폴더들을 넣으세요. 업로드 유형 서류만 가능하며 문서 생성 권한이 필요합니다. 같은 파일은 재사용하고 변경 파일은 새 초안으로 만듭니다.</p><field name="result" nolabel="1"/><footer><button name="action_import" type="object" string="검증 후 새 초안 등록" class="btn-primary"/><button special="cancel" string="닫기"/></footer></form></field></record>
  <record id="action_load" model="ir.actions.server"><field name="name">출력 목록·조립 별칭 보충</field><field name="model_id" ref="cams_sq.model_sq_doc_requirement"/><field name="state">code</field><field name="code">action = model.action_load_outputs()</field></record>
  <record id="action_upload" model="ir.actions.act_window"><field name="name">서류 일괄 업로드</field><field name="res_model">sq.output.upload</field><field name="view_mode">form</field><field name="target">new</field></record>
  <record id="action_output" model="ir.actions.act_window"><field name="name">서류 출력</field><field name="res_model">sq.output.wizard</field><field name="view_mode">form</field><field name="target">new</field></record>
  <menuitem id="menu_load" name="출력 목록·별칭 보충" parent="cams_sq.menu_sq_settings" action="action_load"/>
  <menuitem id="menu_output" name="서류 출력" parent="cams_sq.menu_sq_readiness" action="action_output"/>
  <menuitem id="menu_upload" name="서류 일괄 업로드" groups="cams_sq_outputs.group_sq_uploader" parent="cams_sq.menu_sq_readiness" action="action_upload"/>
</odoo>
