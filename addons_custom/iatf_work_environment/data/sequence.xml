<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_environment_check" model="ir.sequence">
            <field name="name">환경점검</field>
            <field name="code">iatf.environment.check</field>
            <field name="prefix">EC-%(year)s-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_check_record" model="ir.sequence">
            <field name="name">점검 실적</field>
            <field name="code">iatf.check.record</field>
            <field name="prefix">CK-%(year)s-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_safety_assessment" model="ir.sequence">
            <field name="name">위험성평가</field>
            <field name="code">iatf.safety.assessment</field>
            <field name="prefix">RA-%(year)s-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_safety_incident" model="ir.sequence">
            <field name="name">아차사고/사고</field>
            <field name="code">iatf.safety.incident</field>
            <field name="prefix">SI-%(year)s-</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
