<odoo>
<record id="view_check_sheet_source" model="ir.ui.view"><field name="name">check.sheet.source.evidence</field><field name="model">iatf.check.sheet</field><field name="inherit_id" ref="view_check_sheet_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="일상관리 목적·배치도"><field name="quality_purpose"/><field name="layout_document_id"/></group></xpath></field></record>
<record id="view_check_record_source" model="ir.ui.view"><field name="name">check.record.source.evidence</field><field name="model">iatf.check.record</field><field name="inherit_id" ref="view_check_record_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="생산·현장 원천 연결"><field name="quality_purpose"/><field name="lot_id" readonly="state == 'done'"/><field name="workcenter_id" readonly="state == 'done'"/><field name="production_id" readonly="state == 'done'"/><field name="trace_exception" readonly="state == 'done'"/><field name="document_ids" widget="many2many_tags" readonly="state == 'done'"/><field name="attachment_ids" widget="many2many_binary" readonly="state == 'done'"/></group></xpath></field></record>
<record id="view_check_snapshot_source" model="ir.ui.view"><field name="name">check.snapshot.source.evidence</field><field name="model">iatf.check.record</field><field name="inherit_id" ref="view_check_record_form"/><field name="arch" type="xml"><xpath expr="//field[@name='snapshot_ids']/form/field[@name='content']" position="after"><field name="source_context" readonly="1"/><field name="source_attachment_ids" widget="many2many_binary" readonly="1"/></xpath></field></record>
</odoo>
