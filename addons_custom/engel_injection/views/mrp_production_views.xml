<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- MO 폼에 사출 필드 추가 -->
    <record id="view_mrp_production_form_injection" model="ir.ui.view">
        <field name="name">mrp.production.form.engel.injection</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- 시리얼 카운트 stat 버튼 -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_injection_serials" type="object"
                        class="oe_stat_button" icon="fa-barcode"
                        invisible="injection_serial_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="injection_serial_count"/>
                        </span>
                        <span class="o_stat_text">사출 시리얼</span>
                    </div>
                </button>
            </xpath>

            <!-- 차종 필드 추가 (제품 필드 다음) -->
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="car_model"/>
            </xpath>

        </field>
    </record>

    <!-- MO 리스트에 사출 통계 추가 -->
    <record id="view_mrp_production_list_injection" model="ir.ui.view">
        <field name="name">mrp.production.list.engel.injection</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="car_model" optional="hide"/>
                <field name="injection_serial_count" optional="hide" string="시리얼"/>
                <field name="injection_defect_rate" optional="hide" string="불량률(%)"/>
            </xpath>
        </field>
    </record>

</odoo>
