<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 리스트 -->
    <record id="view_car_model_list" model="ir.ui.view">
        <field name="name">engel.car.model.list</field>
        <field name="model">engel.car.model</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="customer_id"/>
            </list>
        </field>
    </record>

    <!-- 액션 -->
    <record id="action_car_model" model="ir.actions.act_window">
        <field name="name">차종 관리</field>
        <field name="res_model">engel.car.model</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
