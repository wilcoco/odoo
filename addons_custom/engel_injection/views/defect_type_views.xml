<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 검색 -->
    <record id="view_defect_type_search" model="ir.ui.view">
        <field name="name">engel.defect.type.search</field>
        <field name="model">engel.defect.type</field>
        <field name="arch" type="xml">
            <search string="불량 유형">
                <field name="code"/>
                <field name="name"/>
                <filter name="active" string="활성" domain="[('active','=',True)]"/>
                <filter name="inactive" string="비활성" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- 리스트 -->
    <record id="view_defect_type_list" model="ir.ui.view">
        <field name="name">engel.defect.type.list</field>
        <field name="model">engel.defect.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- 폼 -->
    <record id="view_defect_type_form" model="ir.ui.view">
        <field name="name">engel.defect.type.form</field>
        <field name="model">engel.defect.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="기본 정보">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 액션 -->
    <record id="action_defect_type" model="ir.actions.act_window">
        <field name="name">불량 유형</field>
        <field name="res_model">engel.defect.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_defect_type_search"/>
    </record>

</odoo>
