<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_injection_serial" model="ir.sequence">
            <field name="name">사출 시리얼</field>
            <field name="code">engel.injection.serial</field>
            <field name="prefix">INJ-%(year)s%(month)s-</field>
            <field name="padding">6</field>
        </record>

        <record id="seq_production_lot" model="ir.sequence">
            <field name="name">사출 생산 LOT</field>
            <field name="code">engel.production.lot</field>
            <field name="prefix">LOT-%(year)s%(month)s-</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
