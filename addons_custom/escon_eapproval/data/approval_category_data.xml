<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 에스콘 전자결재 요청 유형 (Odoo Approvals 연동).
             기본 영문 유형(Business Trip 등)은 escon.eapproval.setup 이 자동 보관 처리한다.
             모든 유형: 부서장(관리자) 자동 결재자 + 순차 결재 + 자동 문서번호. -->

        <record id="category_general" model="approval.category">
            <field name="name">일반 결재</field>
            <field name="description">정형 양식이 없는 일반 기안/품의 — 내용과 첨부로 상신</field>
            <field name="image" type="base64" file="approvals/static/src/img/Folder.png"/>
            <field name="sequence">10</field>
            <field name="has_reference">optional</field>
            <field name="requirer_document">optional</field>
            <field name="manager_approval">approver</field>
            <field name="approver_sequence" eval="True"/>
            <field name="automated_sequence" eval="True"/>
            <field name="sequence_code">GEN</field>
        </record>

        <record id="category_expense" model="approval.category">
            <field name="name">경비청구서</field>
            <field name="description">업무 경비 청구 — 금액과 영수증(증빙) 첨부 필수</field>
            <field name="image" type="base64" file="approvals/static/src/img/Credit-card.png"/>
            <field name="sequence">20</field>
            <field name="has_date">required</field>
            <field name="has_amount">required</field>
            <field name="has_payment_method">optional</field>
            <field name="has_partner">optional</field>
            <field name="requirer_document">required</field>
            <field name="manager_approval">approver</field>
            <field name="approver_sequence" eval="True"/>
            <field name="automated_sequence" eval="True"/>
            <field name="sequence_code">EXP</field>
        </record>

        <record id="category_trip" model="approval.category">
            <field name="name">출장</field>
            <field name="description">출장 신청 — 기간과 출장지를 입력</field>
            <field name="image" type="base64" file="approvals/static/src/img/Suitcase.png"/>
            <field name="sequence">30</field>
            <field name="has_period">required</field>
            <field name="has_location">required</field>
            <field name="has_partner">optional</field>
            <field name="has_amount">optional</field>
            <field name="requirer_document">optional</field>
            <field name="manager_approval">approver</field>
            <field name="approver_sequence" eval="True"/>
            <field name="automated_sequence" eval="True"/>
            <field name="sequence_code">TRIP</field>
        </record>

        <record id="category_car" model="approval.category">
            <field name="name">자동차 대여</field>
            <field name="description">법인/렌트 차량 사용 신청 — 사용 기간을 입력</field>
            <field name="image" type="base64" file="approvals/static/src/img/Car.png"/>
            <field name="sequence">40</field>
            <field name="has_period">required</field>
            <field name="has_location">optional</field>
            <field name="requirer_document">optional</field>
            <field name="manager_approval">approver</field>
            <field name="approver_sequence" eval="True"/>
            <field name="automated_sequence" eval="True"/>
            <field name="sequence_code">CAR</field>
        </record>

        <record id="category_gate" model="approval.category">
            <field name="name">출입신청</field>
            <field name="description">외부인/협력사 출입 및 휴일·야간 출입 신청 — 기간과 방문 업체를 입력</field>
            <field name="image" type="base64" file="approvals/static/src/img/Contract.png"/>
            <field name="sequence">50</field>
            <field name="has_period">required</field>
            <field name="has_partner">optional</field>
            <field name="has_location">optional</field>
            <field name="requirer_document">optional</field>
            <field name="manager_approval">approver</field>
            <field name="approver_sequence" eval="True"/>
            <field name="automated_sequence" eval="True"/>
            <field name="sequence_code">GATE</field>
        </record>

        <!-- 승인 완료 시 공급업체별 구매 견적요청서(RFQ)를 자동 생성 (approvals_purchase) -->
        <record id="category_rfq" model="approval.category">
            <field name="name">견적 요청서 (RFQ)</field>
            <field name="description">구매 품목 승인 — 승인 완료 시 공급업체별 구매 RFQ 자동 생성</field>
            <field name="image" type="base64" file="approvals/static/src/img/Bag.png"/>
            <field name="sequence">60</field>
            <field name="approval_type">purchase</field>
            <field name="has_product">required</field>
            <field name="requirer_document">optional</field>
            <field name="manager_approval">approver</field>
            <field name="approver_sequence" eval="True"/>
            <field name="automated_sequence" eval="True"/>
            <field name="sequence_code">RFQ</field>
        </record>
    </data>
</odoo>
