<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="ir_cron_mrp_auto_order_process_batches" model="ir.cron">
      <field name="name">MRP Auto Order: Process Pending Batches</field>
      <field name="model_id" ref="mrp_auto_order.model_mrp_auto_order_batch"/>
      <field name="state">code</field>
      <field name="code">model.cron_process_pending_batches()</field>
      <field name="interval_number">5</field>
      <field name="interval_type">minutes</field>
      <!-- Odoo 18+: 'numbercall' 필드는 제거되었습니다. 반복 수행은 진행/트리거 메커니즘으로 관리됩니다. -->
      <field name="active">True</field>
      <field name="user_id" ref="base.user_root"/>
      <field name="priority">5</field>
    </record>
  </data>
</odoo>
