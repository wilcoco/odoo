<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 외주 조달 계획 시퀀스 -->
        <record id="seq_outsource_planning_run" model="ir.sequence">
            <field name="name">외주 조달 계획</field>
            <field name="code">outsource.planning.run</field>
            <field name="prefix">OUT/%(year)s/</field>
            <field name="padding">4</field>
        </record>

        <!-- 공급망 발주 추적 시퀀스 -->
        <record id="seq_supply_chain_order" model="ir.sequence">
            <field name="name">공급망 발주 추적</field>
            <field name="code">supply.chain.order</field>
            <field name="prefix">SCO/%(year)s/</field>
            <field name="padding">4</field>
        </record>

        <!-- 협력사 간 발주 시퀀스 -->
        <record id="seq_supplier_order" model="ir.sequence">
            <field name="name">협력사 간 발주</field>
            <field name="code">supplier.order</field>
            <field name="prefix">SPO/%(year)s/</field>
            <field name="padding">4</field>
        </record>

    </data>
</odoo>
