            <field name="is_outsourced">True</field>
            <field name="outsource_partner_id" ref="partner_supplier_hanbracket"/>
            <field name="outsource_leadtime">3</field>
            <field name="standard_price">1200</field>
            <field name="list_price">1500</field>
            <field name="uom_id" ref="uom.product_uom_unit"/>
            <field name="uom_po_id" ref="uom.product_uom_unit"/>
        </record>

