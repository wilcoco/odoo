        <!-- 외주 부품 1: 프론트 브라켓 A -->
        <record id="product_out_brk_001" model="product.product">
            <field name="name">프론트 브라켓 A</field>
            <field name="default_code">OUT-BRK-001</field>
            <field name="type">consu</field>
            <field name="is_storable">True</field>
