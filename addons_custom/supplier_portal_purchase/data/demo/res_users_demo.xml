<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- 협력사 포탈 계정 1: (주)한국브라켓 -->
        <record id="user_supplier1" model="res.users">
            <field name="name">박협력 (한국브라켓)</field>
            <field name="login">supplier1</field>
            <field name="password">supplier1234</field>
            <field name="partner_id" ref="partner_contact_park"/>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_portal')])]"/>
        </record>

        <!-- 협력사 포탈 계정 2: 대한하우징(주) -->
        <record id="user_supplier2" model="res.users">
            <field name="name">이공급 (대한하우징)</field>
            <field name="login">supplier2</field>
            <field name="password">supplier1234</field>
            <field name="partner_id" ref="partner_contact_lee"/>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_portal')])]"/>
        </record>

        <!-- 협력사 포탈 계정 3: 삼성캡(주) -->
        <record id="user_supplier3" model="res.users">
            <field name="name">김납품 (삼성캡)</field>
            <field name="login">supplier3</field>
            <field name="password">supplier1234</field>
            <field name="partner_id" ref="partner_contact_kim"/>
            <field name="groups_id" eval="[(6, 0, [ref('base.group_portal')])]"/>
        </record>

        <!-- 내부 사용자: 구매팀장 -->
        <record id="user_buyer_kim" model="res.users">
            <field name="name">김구매 (구매팀장)</field>
            <field name="login">buyer_kim</field>
            <field name="password">buyer1234</field>
            <field name="groups_id" eval="[(6, 0, [
                ref('base.group_user'),
                ref('purchase.group_purchase_manager'),
                ref('stock.group_stock_manager'),
            ])]"/>
        </record>

        <!-- 내부 사용자: 구매담당 -->
        <record id="user_buyer_lee" model="res.users">
            <field name="name">이구매 (구매담당)</field>
            <field name="login">buyer_lee</field>
            <field name="password">buyer1234</field>
            <field name="groups_id" eval="[(6, 0, [
                ref('base.group_user'),
                ref('purchase.group_purchase_user'),
                ref('stock.group_stock_user'),
            ])]"/>
        </record>

        <!-- 내부 사용자: 생산관리자 -->
        <record id="user_prod_park" model="res.users">
            <field name="name">박생산 (생산관리)</field>
            <field name="login">prod_park</field>
            <field name="password">prod1234</field>
            <field name="groups_id" eval="[(6, 0, [
                ref('base.group_user'),
                ref('mrp.group_mrp_manager'),
                ref('stock.group_stock_user'),
            ])]"/>
        </record>

    </data>
</odoo>
