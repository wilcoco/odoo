<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_portal_credential_wizard" model="ir.ui.view">
        <field name="name">supplier.portal.credential.wizard.form</field>
        <field name="model">supplier.portal.credential.wizard</field>
        <field name="arch" type="xml">
            <form string="협력사 포탈 계정 설정">
                <div class="alert alert-info" role="alert">
                    협력사에게 알려줄 <b>아이디와 비밀번호를 여기서 바로 지정</b>합니다.
                    초대 메일이 필요 없습니다 — 전화나 메신저로 전달하세요.
                </div>
                <group>
                    <field name="partner_id"/>
                    <field name="user_id" invisible="not user_id"/>
                    <div colspan="2" class="text-muted small"
                         invisible="not user_id">
                        이미 계정이 있습니다. 비밀번호를 새로 지정합니다.
                        아이디를 바꾸면 협력사는 <b>새 아이디로만</b> 로그인할 수 있습니다.
                    </div>
                </group>
                <group>
                    <group string="로그인 정보">
                        <field name="login" required="1"
                               placeholder="예: hanwha_resin 또는 담당자 이메일"/>
                        <field name="new_password" password="True" required="1"
                               placeholder="8자 이상"/>
                        <field name="confirm_password" password="True" required="1"/>
                    </group>
                    <group string="접속 주소">
                        <field name="portal_url" nolabel="1" colspan="2"
                               widget="url" readonly="1"/>
                        <div colspan="2" class="text-muted small">
                            협력사는 이 주소로 로그인한 뒤 자동으로 협력사 포탈로 이동합니다.
                        </div>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="적용"
                            class="btn-primary"/>
                    <button special="cancel" string="취소" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 적용 후 화면 — 담당자가 협력사에 그대로 불러줄 정보만 남긴다.
         비밀번호는 이미 지워져서 다시 볼 수 없다(방금 본인이 입력한 값). -->
    <record id="view_portal_credential_wizard_done" model="ir.ui.view">
        <field name="name">supplier.portal.credential.wizard.done</field>
        <field name="model">supplier.portal.credential.wizard</field>
        <field name="arch" type="xml">
            <form string="설정 완료">
                <div class="alert alert-success" role="alert">
                    <b>포탈 계정이 설정되었습니다.</b><br/>
                    아래 정보를 협력사 담당자에게 전달하세요.
                    비밀번호는 보안상 다시 표시되지 않습니다.
                </div>
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="login" string="아이디" readonly="1"/>
                    <field name="portal_url" string="접속 주소" widget="url" readonly="1"/>
                </group>
                <footer>
                    <button name="action_close" type="object" string="닫기"
                            class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_portal_credential_wizard" model="ir.actions.act_window">
        <field name="name">포탈 계정 아이디/비밀번호 설정</field>
        <field name="res_model">supplier.portal.credential.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_portal_credential_wizard"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>
