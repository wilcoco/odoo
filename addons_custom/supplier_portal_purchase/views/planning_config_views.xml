<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 외주 조달 설정 폼 -->
    <record id="outsource_planning_config_form" model="ir.ui.view">
        <field name="name">outsource.planning.config.form</field>
        <field name="model">outsource.planning.config</field>
        <field name="arch" type="xml">
            <form string="외주 조달 설정">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group string="재고 설정">
                        <group>
                            <field name="safety_stock_days"/>
                        </group>
                    </group>
                    <group string="자동발주 설정">
                        <group>
                            <field name="auto_generate_po"/>
                            <field name="outsource_buffer_days"/>
                            <field name="default_buyer_id"/>
                        </group>
                        <group>
                            <field name="portal_base_url"
                                   placeholder="https://your-odoo.com"/>
                            <field name="po_reminder_days"/>
                        </group>
                    </group>
                    <group string="알림 설정">
                        <group>
                            <field name="notify_production_impact"/>
                            <field name="production_manager_id"
                                   invisible="not notify_production_impact"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 외주 조달 설정 목록 -->
    <record id="outsource_planning_config_list" model="ir.ui.view">
        <field name="name">outsource.planning.config.list</field>
        <field name="model">outsource.planning.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="safety_stock_days"/>
                <field name="auto_generate_po"/>
                <field name="default_buyer_id"/>
            </list>
        </field>
    </record>

    <!-- 외주 조달 설정 액션 -->
    <record id="action_outsource_planning_config" model="ir.actions.act_window">
        <field name="name">외주 조달 설정</field>
        <field name="res_model">outsource.planning.config</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>

</odoo>
