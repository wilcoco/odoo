<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 포탈 알림 폼 뷰 -->
    <record id="supplier_portal_notification_form_view" model="ir.ui.view">
        <field name="name">supplier.portal.notification.form</field>
        <field name="model">supplier.portal.notification</field>
        <field name="arch" type="xml">
            <form string="포탈 알림">
                <sheet>
                    <group>
                        <group string="알림 대상">
                            <field name="partner_id"/>
                            <field name="user_id"/>
                        </group>
                        <group string="알림 정보">
                            <field name="notification_type"/>
                            <field name="purchase_order_id"/>
                            <field name="is_read"/>
                            <field name="read_date"/>
                        </group>
                    </group>
                    <group string="메시지">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 포탈 알림 목록 뷰 -->
    <record id="supplier_portal_notification_tree_view" model="ir.ui.view">
        <field name="name">supplier.portal.notification.tree</field>
        <field name="model">supplier.portal.notification</field>
        <field name="arch" type="xml">
            <list string="포탈 알림">
                <field name="create_date"/>
                <field name="notification_type"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="purchase_order_id"/>
                <field name="message"/>
                <field name="is_read"
                       decoration-danger="is_read == False"
                       decoration-success="is_read == True"/>
            </list>
        </field>
    </record>

    <!-- 포탈 알림 검색 뷰 -->
    <record id="supplier_portal_notification_search_view" model="ir.ui.view">
        <field name="name">supplier.portal.notification.search</field>
        <field name="model">supplier.portal.notification</field>
        <field name="arch" type="xml">
            <search string="알림 검색">
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="purchase_order_id"/>
                <filter name="unread" string="미읽음"
                        domain="[('is_read', '=', False)]"/>
                <filter name="read" string="읽음"
                        domain="[('is_read', '=', True)]"/>
                <separator/>
                <filter name="partner" string="협력사 알림"
                        domain="[('partner_id', '!=', False)]"/>
                <filter name="user" string="내부 알림"
                        domain="[('user_id', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="협력사" name="group_partner"
                            context="{'group_by': 'partner_id'}"/>
                    <filter string="알림 유형" name="group_type"
                            context="{'group_by': 'notification_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 포탈 알림 액션 -->
    <record id="action_supplier_portal_notification" model="ir.actions.act_window">
        <field name="name">포탈 알림</field>
        <field name="res_model">supplier.portal.notification</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_unread': 1}</field>
    </record>

</odoo>
