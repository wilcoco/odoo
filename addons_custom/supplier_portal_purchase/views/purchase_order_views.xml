<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 발주서 폼 뷰 확장 -->
    <record id="purchase_order_form_view_portal" model="ir.ui.view">
        <field name="name">purchase.order.form.portal</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- 헤더에 포탈 상태 버튼 추가 -->
            <button name="action_rfq_send" position="before">
                <field name="portal_state" widget="statusbar"
                       statusbar_visible="new,responded,approved,done"
                       invisible="not auto_generated"/>
            </button>

            <!-- 승인/반려 버튼 -->
            <button name="button_confirm" position="after">
                <button name="action_approve_response" type="object"
                        string="응답 승인" class="btn-success"
                        invisible="portal_state != 'responded'"/>
                <button name="action_reject_response" type="object"
                        string="응답 반려" class="btn-warning"
                        invisible="portal_state != 'responded'"/>
                <button name="action_mark_done" type="object"
                        string="납품 완료" class="btn-primary"
                        invisible="portal_state != 'approved'"/>
            </button>

            <!-- 포탈 정보 그룹 추가 (Other Information 탭 내 other_info 그룹 앞에) -->
            <group name="other_info" position="before">
                <group string="외주 발주 정보" invisible="not auto_generated" colspan="2">
                    <group>
                        <field name="auto_generated" readonly="1"/>
                        <field name="planning_run_id" readonly="1"/>
                        <field name="buyer_id"/>
                    </group>
                    <group>
                        <field name="portal_state" readonly="1"/>
                        <field name="production_impact" readonly="1"
                               decoration-success="production_impact == 'ok'"
                               decoration-warning="production_impact == 'warning'"
                               decoration-danger="production_impact == 'critical'"/>
                        <field name="portal_url" widget="url" readonly="1"
                               invisible="not portal_url"/>
                    </group>
                </group>
            </group>

            <!-- 응답 내역 탭 -->
            <page name="purchase_delivery_invoice" position="after">
                <page string="협력사 응답" name="supplier_response"
                      invisible="not auto_generated">
                    <field name="response_ids" readonly="1"/>
                </page>
            </page>
        </field>
    </record>

    <!-- 발주서 목록 뷰 확장 -->
    <record id="purchase_order_tree_view_portal" model="ir.ui.view">
        <field name="name">purchase.order.tree.portal</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="portal_state" optional="hide"
                       decoration-danger="portal_state == 'new'"
                       decoration-warning="portal_state == 'responded'"
                       decoration-info="portal_state == 'rejected'"
                       decoration-success="portal_state == 'approved'"/>
                <field name="production_impact" optional="hide"
                       decoration-success="production_impact == 'ok'"
                       decoration-warning="production_impact == 'warning'"
                       decoration-danger="production_impact == 'critical'"/>
                <field name="auto_generated" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- 발주서 검색 뷰 확장 -->
    <record id="purchase_order_search_view_portal" model="ir.ui.view">
        <field name="name">purchase.order.search.portal</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <filter name="approved" position="after">
                <separator/>
                <filter name="auto_generated" string="자동 생성 발주"
                        domain="[('auto_generated', '=', True)]"/>
                <filter name="portal_new" string="응답 대기"
                        domain="[('portal_state', '=', 'new')]"/>
                <filter name="portal_responded" string="응답 완료"
                        domain="[('portal_state', '=', 'responded')]"/>
                <filter name="portal_rejected" string="반려됨"
                        domain="[('portal_state', '=', 'rejected')]"/>
                <separator/>
                <filter name="impact_warning" string="생산 영향 (주의)"
                        domain="[('production_impact', '=', 'warning')]"/>
                <filter name="impact_critical" string="생산 영향 (위험)"
                        domain="[('production_impact', '=', 'critical')]"/>
            </filter>
            <!-- Group By 필터 추가 (representative 그룹 필터 뒤에) -->
            <filter name="representative" position="after">
                <filter string="포탈 상태" name="group_portal_state"
                        context="{'group_by': 'portal_state'}"/>
                <filter string="생산 영향도" name="group_production_impact"
                        context="{'group_by': 'production_impact'}"/>
            </filter>
        </field>
    </record>

    <!-- 외주 발주 관리 액션 -->
    <record id="action_purchase_order_outsource" model="ir.actions.act_window">
        <field name="name">외주 발주 관리</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="domain">[('auto_generated', '=', True)]</field>
        <field name="context">{
            'search_default_portal_new': 1,
            'search_default_portal_responded': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                자동 생성된 외주 발주가 없습니다
            </p>
            <p>
                생산계획 확정 시 외주 부품에 대한 발주서가 자동으로 생성됩니다.
            </p>
        </field>
    </record>

    <!-- 승인 대기 발주 액션 -->
    <record id="action_purchase_order_pending_approval" model="ir.actions.act_window">
        <field name="name">승인 대기</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('auto_generated', '=', True),
            ('portal_state', '=', 'responded'),
        ]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                승인 대기 중인 발주가 없습니다
            </p>
        </field>
    </record>

</odoo>
