<odoo>
  <record id="iatf_packaging.group_packaging_user" model="res.groups"><field name="implied_ids" eval="[(4,ref('cams_evidence_core.group_evidence_user'))]"/></record>
  <record id="container_company" model="ir.rule"><field name="name">용기 점검 회사 격리</field><field name="model_id" ref="model_cams_container_clean"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="spec_company" model="ir.rule"><field name="name">용기 사양 회사 격리</field><field name="model_id" ref="iatf_packaging.model_iatf_packaging_spec"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="access_container_user" model="ir.model.access"><field name="name">container user</field><field name="model_id" ref="model_cams_container_clean"/><field name="group_id" ref="group_material_user"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/></record>
  <record id="access_container_manager" model="ir.model.access"><field name="name">container manager</field><field name="model_id" ref="model_cams_container_clean"/><field name="group_id" ref="group_material_manager"/><field name="perm_read" eval="True"/><field name="perm_write" eval="True"/><field name="perm_create" eval="True"/><field name="perm_unlink" eval="True"/></record>
  <record id="access_container_spec_reference" model="ir.model.access"><field name="name">container spec reference</field><field name="model_id" ref="iatf_packaging.model_iatf_packaging_spec"/><field name="group_id" ref="group_material_user"/><field name="perm_read" eval="True"/></record>
  <record id="view_spec_evidence" model="ir.ui.view"><field name="name">iatf.packaging.spec.evidence</field><field name="model">iatf.packaging.spec</field><field name="inherit_id" ref="iatf_packaging.view_packaging_spec_form"/><field name="arch" type="xml">
    <xpath expr="//header" position="replace"><header>
      <button name="action_submit_approval" type="object" string="기준 검토 상신" class="btn-primary" invisible="state != 'draft' or approval_state not in ('draft','rejected',False)"/>
      <button name="action_approve_approval" type="object" string="승인" invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
      <button name="action_reject_approval" type="object" string="반려" invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
      <button name="action_activate" type="object" string="승인 기준 활성화" invisible="approval_state != 'approved' or state != 'draft'"/>
      <button name="action_new_evidence_revision" type="object" string="정정 개정 작성" invisible="state not in ('active','obsolete')"/>
      <button name="action_obsolete" type="object" string="폐기" groups="iatf_packaging.group_packaging_manager" invisible="state == 'obsolete'"/>
      <field name="approval_is_current_user" invisible="1"/><field name="evidence_state" invisible="1"/><field name="approval_state" widget="badge"/><field name="state" widget="statusbar"/>
    </header></xpath>
    <xpath expr="//sheet" position="inside"><group string="용기 적용·자동화"><field name="flow_direction"/><field name="automated"/><field name="t1_date"/><field name="automation_ready_date"/><field name="readiness_deviation"/><field name="trace_exception"/></group>
      <group string="검토·승인"><field name="approval_line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="user_id"/><field name="state" readonly="1"/></list></field></group>
      <group string="완료·개정 근거"><field name="evidence_revision"/><field name="previous_evidence_id"/><field name="completed_by_id"/><field name="completed_at"/><field name="completion_snapshot"/></group>
    </xpath>
  </field></record>
  <record id="view_container_list" model="ir.ui.view"><field name="name">cams.container.clean.list</field><field name="model">cams.container.clean</field><field name="arch" type="xml"><list><field name="name"/><field name="record_date"/><field name="quarter"/><field name="spec_id"/><field name="product_id"/><field name="lot_id"/><field name="result" widget="badge"/><field name="approval_state"/><field name="evidence_state"/></list></field></record>
  <record id="view_container_form" model="ir.ui.view"><field name="name">cams.container.clean.form</field><field name="model">cams.container.clean</field><field name="arch" type="xml"><form>
    <header><button name="action_submit_approval" type="object" string="검토 상신" invisible="approval_state not in ('draft','rejected',False) or evidence_state == 'done'"/><button name="action_approve_approval" type="object" string="승인" invisible="approval_state != 'in_progress' or not approval_is_current_user"/><button name="action_reject_approval" type="object" string="반려" invisible="approval_state != 'in_progress' or not approval_is_current_user"/><button name="action_complete_evidence" type="object" string="검증 완료" invisible="approval_state != 'approved' or evidence_state == 'done'"/><button name="action_new_evidence_revision" type="object" string="정정 개정" invisible="evidence_state != 'done'"/><field name="approval_is_current_user" invisible="1"/><field name="approval_state" widget="badge"/><field name="evidence_state" widget="statusbar"/></header>
    <sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="company_id" groups="base.group_multi_company"/><field name="record_date"/><field name="quarter" readonly="1"/><field name="responsible_id"/><field name="spec_id"/><field name="product_id"/><field name="lot_id" domain="[('product_id','=',product_id)]"/><field name="workcenter_id"/><field name="trace_exception"/></group><group><field name="cleanliness"/><field name="damage"/><field name="identification"/><field name="mixed_parts"/><field name="actual_container_type"/><field name="actual_quantity"/><field name="result" readonly="1"/><field name="action_note"/></group></group>
    <field name="attachment_ids" widget="many2many_binary"/><group string="결재선"><field name="approval_line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="user_id"/><field name="state" readonly="1"/></list></field></group><group string="완료 근거"><field name="evidence_revision"/><field name="previous_evidence_id"/><field name="completed_by_id"/><field name="completed_at"/><field name="completion_snapshot"/></group></sheet><chatter/>
  </form></field></record>
  <record id="action_container_clean" model="ir.actions.act_window"><field name="name">분기 용기 점검·사양 대조</field><field name="res_model">cams.container.clean</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_container_clean" name="분기 용기 점검·사양 대조" parent="iatf_menu.menu_iatf_packaging" action="action_container_clean" groups="group_material_user" sequence="70"/>
</odoo>
