<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_inherit_pqc" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.pqc</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pqc" type="object"
                        class="oe_stat_button" icon="fa-clipboard-check">
                    <field name="pqc_count" widget="statinfo" string="공정검사"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
