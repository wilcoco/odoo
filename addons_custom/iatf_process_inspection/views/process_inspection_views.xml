<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_process_inspection_list" model="ir.ui.view">
        <field name="name">iatf.process.inspection.list</field>
        <field name="model">iatf.process.inspection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="inspection_stage"/>
                <field name="inspection_date"/>
                <field name="product_id"/>
                <field name="production_id"/>
                <field name="picking_id"/>
                <field name="quantity_inspected"/>
                <field name="defect_rate"/>
                <field name="result"/>
                <field name="inspector_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_process_inspection_form" model="ir.ui.view">
        <field name="name">iatf.process.inspection.form</field>
        <field name="model">iatf.process.inspection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_inspection" string="검사 시작" type="object" class="btn-primary" invisible="state != 'draft' or inspection_input_locked"/>
                    <button name="action_decide" string="판정 완료" type="object" class="btn-primary" invisible="state != 'inspecting' or inspection_input_locked"/>
                    <button name="action_close" string="종료" type="object" class="btn-success" invisible="state != 'decided'"/>
                    <button name="action_create_nc" string="부적합 생성" type="object" class="btn-warning" invisible="result != 'fail'"/>
                    <button name="action_cancel" string="취소" type="object" invisible="state in ('closed', 'cancelled')"/>
                    <button name="action_submit_approval" string="결재 상신" type="object" class="btn-primary" invisible="approval_state not in (False, 'draft', 'rejected')"/>
                    <button name="action_approve_approval" string="승인" type="object" class="btn-success" invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <button name="action_reject_approval" string="반려" type="object" invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <field name="approval_is_current_user" invisible="1"/>
                    <field name="approval_state" widget="badge" decoration-success="approval_state == 'approved'" decoration-danger="approval_state == 'rejected'" decoration-info="approval_state == 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,inspecting,decided,closed"/>
                    <button name="action_create_reinspection" string="새 재검사" type="object" invisible="not inspection_input_locked"/>
                </header>
                <sheet>
                    <field name="auto_evidence_snapshot" invisible="1"/>
                    <field name="run_unit_mo_ids" invisible="1"/>
                    <field name="run_scope_frozen" invisible="1"/>
                    <field name="inspection_input_locked" invisible="1"/>
                    <div class="alert alert-info" role="status" invisible="not run_unit_mo_ids">생산 범위는 자동 집계됩니다. 검사 시작 또는 실제 검사값 입력 후의 생산분은 새 검사서로 분리됩니다. 검사 수량과 측정값은 실제 검사 후 입력하세요.</div>
                    <group string="재검사·정정" invisible="not correction_of_id">
                        <field name="correction_of_id"/>
                        <field name="correction_reason" readonly="inspection_input_locked" required="correction_of_id"/>
                    </group>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="inspection_stage" readonly="inspection_input_locked or run_unit_mo_ids or correction_of_id"/>
                            <field name="article_stage" readonly="inspection_input_locked or run_unit_mo_ids or correction_of_id"/>
                            <field name="production_date" readonly="inspection_input_locked or run_unit_mo_ids or correction_of_id"/>
                            <field name="shift" readonly="inspection_input_locked or run_unit_mo_ids or correction_of_id"/>
                            <field name="inspection_date" readonly="inspection_input_locked"/>
                            <field name="product_id" readonly="inspection_input_locked or run_unit_mo_ids or correction_of_id"/>
                            <field name="part_number"/>
                            <field name="lot_id" readonly="inspection_input_locked or run_unit_mo_ids or correction_of_id"/>
                        </group>
                        <group>
                            <field name="production_id" readonly="inspection_input_locked or run_unit_mo_ids or correction_of_id"/>
                            <field name="picking_id" readonly="inspection_input_locked or run_unit_mo_ids or correction_of_id"/>
                            <field name="workcenter_id" readonly="inspection_input_locked or run_unit_mo_ids or correction_of_id"/>
                            <field name="control_plan_id" readonly="inspection_input_locked"/>
                            <field name="inspector_id" readonly="inspection_input_locked"/>
                            <field name="approved_by" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="수량">
                            <field name="quantity_uom_id" readonly="inspection_input_locked or run_unit_mo_ids or correction_of_id"/>
                            <field name="inspection_type" readonly="inspection_input_locked"/>
                            <field name="quantity_produced" readonly="inspection_input_locked or run_unit_mo_ids or correction_of_id"/>
                            <field name="quantity_inspected" readonly="inspection_input_locked"/>
                            <field name="quantity_accepted" readonly="inspection_input_locked"/>
                            <field name="quantity_rejected" readonly="inspection_input_locked"/>
                            <field name="defect_rate"/>
                        </group>
                        <group string="판정">
                            <field name="visual_result" readonly="inspection_input_locked"/>
                            <field name="dimension_result" readonly="inspection_input_locked"/>
                            <field name="function_result" readonly="inspection_input_locked"/>
                            <field name="result" readonly="inspection_input_locked"/>
                            <field name="disposition" readonly="inspection_input_locked"/>
                            <field name="nonconformity_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="검사 항목">
                            <field name="line_ids" readonly="inspection_input_locked">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="characteristic_name"/>
                                    <field name="characteristic_type"/>
                                    <field name="special_characteristic"/>
                                    <field name="specification"/>
                                    <field name="measurement_method"/>
                                    <field name="measured_value"/>
                                    <field name="result"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="결재선">
                            <field name="approval_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="기타">
                            <group>
                                <field name="document_ids" widget="many2many_tags"/>
                                <field name="notes"/>
                            </group>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_process_inspection" model="ir.actions.act_window">
        <field name="name">공정검사 / 최종검사</field>
        <field name="res_model">iatf.process.inspection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
