<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_process_inspection_user" model="res.groups">
        <field name="name">공정검사 담당자</field>
        <field name="category_id" ref="iatf_document_control.module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_process_inspection_manager" model="res.groups">
        <field name="name">공정검사 관리자</field>
        <field name="category_id" ref="iatf_document_control.module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('group_process_inspection_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_process_inspection_company" model="ir.rule">
        <field name="name">Process inspection company</field>
        <field name="model_id" ref="model_iatf_process_inspection"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_process_inspection_line_company" model="ir.rule">
        <field name="name">Process inspection line company</field>
        <field name="model_id" ref="model_iatf_process_inspection_line"/>
        <field name="domain_force">['|', ('inspection_id.company_id', '=', False), ('inspection_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_shipping_inspection_company" model="ir.rule">
        <field name="name">Shipping inspection company</field>
        <field name="model_id" ref="iatf_shipping_inspection.model_iatf_shipping_inspection"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_packaging_spec_company" model="ir.rule">
        <field name="name">Packaging specification company</field>
        <field name="model_id" ref="iatf_packaging.model_iatf_packaging_spec"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
