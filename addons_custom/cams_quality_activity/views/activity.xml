<odoo>
<record id="view_document_activity_plan" model="ir.ui.view"><field name="name">iatf.document.activity.plan</field><field name="model">iatf.document</field><field name="inherit_id" ref="iatf_document_control.view_document_quality_evidence"/><field name="arch" type="xml"><field name="quality_cycle_note" position="after"><group string="정성품질 연간 계획" invisible="quality_evidence_kind != 'quality_activity_plan'">
<field name="quality_activity_year"/><field name="quality_training_planned_date"/><field name="quality_check_planned_date"/><field name="quality_target_department_ids" widget="many2many_tags"/>
<field name="quality_activity_training_count" groups="cams_quality_activity.group_activity_user"/><field name="quality_activity_check_count" groups="cams_quality_activity.group_activity_user"/><field name="quality_activity_award_count" groups="cams_quality_activity.group_activity_user"/>
</group></field></field></record>
<record id="view_activity_list" model="ir.ui.view"><field name="name">cams.quality.activity.list</field><field name="model">cams.quality.activity</field><field name="arch" type="xml"><list><field name="name"/><field name="record_date"/><field name="activity_type"/><field name="department_id"/><field name="plan_document_id"/><field name="approval_state" widget="badge"/><field name="evidence_state" widget="badge"/></list></field></record>
<record id="view_activity_form" model="ir.ui.view"><field name="name">cams.quality.activity.form</field><field name="model">cams.quality.activity</field><field name="arch" type="xml"><form><header>
<button name="action_submit_approval" type="object" string="검토 상신" invisible="evidence_state == 'done' or approval_state not in ('draft','rejected',False)"/>
<button name="action_approve_approval" type="object" string="승인" invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
<button name="action_reject_approval" type="object" string="반려" invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
<button name="action_complete_evidence" type="object" string="검증 완료" invisible="approval_state != 'approved' or evidence_state == 'done'"/>
<button name="action_new_evidence_revision" type="object" string="정정 개정" invisible="evidence_state != 'done'"/>
<field name="approval_is_current_user" invisible="1"/><field name="approval_state" widget="badge"/><field name="evidence_state" widget="statusbar"/>
</header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><field name="company_id" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="record_date" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="responsible_id" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="plan_document_id" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="activity_type" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="department_id" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="product_id" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="lot_id" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="workcenter_id" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="trace_exception" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="training_ids" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'" invisible="activity_type != 'training'" widget="many2many_tags"/><field name="result_note" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"/><field name="improvement_type" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'" invisible="activity_type != 'inspection'"/><field name="improvement_note" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'" invisible="activity_type != 'inspection'"/><field name="award_month" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'" invisible="activity_type != 'award'"/></group><field name="attachment_ids" widget="many2many_binary"/><notebook><page string="결재선"><field name="approval_line_ids" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"><list editable="bottom"><field name="sequence" widget="handle"/><field name="user_id"/><field name="state" readonly="1"/></list></field></page>
<page string="완료·개정 근거"><group><field name="evidence_revision"/><field name="previous_evidence_id"/><field name="completed_by_id"/><field name="completed_at"/></group><field name="completion_snapshot"/></page></notebook></sheet><chatter/></form></field></record>
<record id="action_activity" model="ir.actions.act_window"><field name="name">정성품질 교육·점검·부서 포상</field><field name="res_model">cams.quality.activity</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_activity" name="정성품질 교육·점검·부서 포상" parent="iatf_menu.menu_iatf_quality_objective" action="action_activity" groups="group_activity_user" sequence="60"/>
</odoo>