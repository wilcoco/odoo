<odoo>
  <record id="group_activity_user" model="res.groups"><field name="name">정성품질 실행 담당</field><field name="implied_ids" eval="[(4,ref('cams_evidence_core.group_evidence_user'))]"/></record>
  <record id="group_activity_manager" model="res.groups"><field name="name">정성품질 실행 책임자</field><field name="implied_ids" eval="[(4,ref('group_activity_user')),(4,ref('cams_evidence_core.group_evidence_manager'))]"/></record>
  <record id="activity_company" model="ir.rule"><field name="name">정성품질 실행 회사 격리</field><field name="model_id" ref="model_cams_quality_activity"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="training_reference_company" model="ir.rule"><field name="name">정성품질 교육 참조 회사</field><field name="model_id" ref="iatf_training.model_iatf_training_record"/><field name="groups" eval="[(4,ref('group_activity_user'))]"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
</odoo>
