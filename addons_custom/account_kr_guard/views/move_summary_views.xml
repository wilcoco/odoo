<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 리포트 #4·#14: 결제완료/남은금액을 청구서 상단(총액 옆)에 -->
    <record id="view_move_form_kr_summary" model="ir.ui.view">
        <field name="name">account.move.form.kr.summary</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="kr_paid_amount" invisible="state != 'posted' or move_type not in ('out_invoice','in_invoice','out_refund','in_refund')"/>
                <field name="kr_residual_display" invisible="state != 'posted' or move_type not in ('out_invoice','in_invoice','out_refund','in_refund')"
                       decoration-danger="kr_residual_display > 0"/>
            </xpath>
        </field>
    </record>
    <record id="view_invoice_tree_kr_summary" model="ir.ui.view">
        <field name="name">account.move.list.kr.summary</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="kr_paid_amount" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
