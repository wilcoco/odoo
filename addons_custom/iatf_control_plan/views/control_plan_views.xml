<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iatf_control_plan_search" model="ir.ui.view">
        <field name="name">iatf.control.plan.search</field>
        <field name="model">iatf.control.plan</field>
        <field name="arch" type="xml">
            <search string="Control Plans">
                <field name="name"/>
                <field name="title"/>
                <field name="product_id"/>
                <separator/>
                <filter name="prototype" string="Prototype" domain="[('cp_type','=','prototype')]"/>
                <filter name="pre_launch" string="Pre-Launch" domain="[('cp_type','=','pre_launch')]"/>
                <filter name="production" string="Production" domain="[('cp_type','=','production')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Type" context="{'group_by': 'cp_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_iatf_control_plan_tree" model="ir.ui.view">
        <field name="name">iatf.control.plan.tree</field>
        <field name="model">iatf.control.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="title"/>
                <field name="cp_type" widget="badge"/>
                <field name="product_id"/>
                <field name="customer_id" optional="show"/>
                <field name="revision"/>
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="line_count" string="Items"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'review'"
                       decoration-muted="state == 'obsolete'"/>
            </list>
        </field>
    </record>

    <record id="view_iatf_control_plan_form" model="ir.ui.view">
        <field name="name">iatf.control.plan.form</field>
        <field name="model">iatf.control.plan</field>
        <field name="arch" type="xml">
            <form string="Control Plan">
                <header>
                    <button name="action_submit_review" string="Submit for Review" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="state != 'review'"
                            groups="iatf_control_plan.group_cp_manager"/>
                    <button name="action_obsolete" string="Obsolete" type="object"
                            invisible="state != 'approved'"/>
                    <button name="action_reset_draft" string="Reset" type="object"
                            invisible="state in ('draft',)"
                            groups="iatf_control_plan.group_cp_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="title" placeholder="Control Plan Title"/></h2>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="cp_type"/>
                            <field name="product_id"/>
                            <field name="part_number"/>
                            <field name="customer_id"/>
                        </group>
                        <group string="Ownership">
                            <field name="responsible_id"/>
                            <field name="team_member_ids" widget="many2many_tags"/>
                            <field name="revision"/>
                            <field name="revision_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Links">
                            <field name="fmea_id"/>
                            <field name="apqp_project_id"/>
                            <field name="document_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Control Plan Items" name="items">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="process_step_number"/>
                                    <field name="process_name"/>
                                    <field name="characteristic_number"/>
                                    <field name="characteristic_name"/>
                                    <field name="characteristic_type"/>
                                    <field name="special_characteristic" widget="badge"
                                           decoration-danger="special_characteristic == 'cc'"
                                           decoration-warning="special_characteristic == 'sc'"/>
                                    <field name="specification"/>
                                    <field name="evaluation_method"/>
                                    <field name="sample_size"/>
                                    <field name="sample_frequency"/>
                                    <field name="control_method"/>
                                    <field name="reaction_plan"/>
                                    <field name="fmea_line_id" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_iatf_control_plan" model="ir.actions.act_window">
        <field name="name">Control Plans</field>
        <field name="res_model">iatf.control.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_iatf_control_plan_search"/>
    </record>
</odoo>
