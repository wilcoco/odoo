<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_iatf_traceability_record" model="ir.sequence">
            <field name="name">IATF Traceability Record</field>
            <field name="code">iatf.traceability.record</field>
            <field name="prefix">TRACE-%(year)s-</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_iatf_recall_simulation" model="ir.sequence">
            <field name="name">IATF Recall Simulation</field>
            <field name="code">iatf.recall.simulation</field>
            <field name="prefix">RECALL-%(year)s-</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
