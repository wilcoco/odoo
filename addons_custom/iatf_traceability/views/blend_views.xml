<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ 배합 관리기준 ============ -->
    <record id="view_blend_standard_list" model="ir.ui.view">
        <field name="name">iatf.blend.standard.list</field>
        <field name="model">iatf.blend.standard</field>
        <field name="arch" type="xml">
            <list string="배합 관리기준" decoration-muted="not customer_approved">
                <field name="name"/>
                <field name="product_id"/>
                <field name="material_id" optional="show"/>
                <field name="max_regrind_ratio"/>
                <field name="ratio_basis"/>
                <field name="max_additive_ratio" optional="hide"/>
                <field name="effective_date"/>
                <field name="customer_approved" widget="boolean_toggle"/>
                <field name="approval_ref" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_blend_standard_form" model="ir.ui.view">
        <field name="name">iatf.blend.standard.form</field>
        <field name="model">iatf.blend.standard</field>
        <field name="arch" type="xml">
            <form string="배합 관리기준">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="적용 대상">
                            <field name="product_id"/>
                            <field name="material_id"/>
                            <field name="effective_date"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="혼합 기준">
                            <field name="max_regrind_ratio"/>
                            <field name="ratio_basis"/>
                            <field name="max_additive_ratio"/>
                        </group>
                    </group>
                    <group string="고객 승인 (SQ 1_5 — 혼합 사용 시 승인·물성 확인)">
                        <field name="customer_approved"/>
                        <field name="approval_ref" invisible="not customer_approved"/>
                        <field name="approval_date" invisible="not customer_approved"/>
                        <field name="ms_spec_note" placeholder="시험성적서 번호 등 물성 만족 근거"/>
                    </group>
                    <group string="비고">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_blend_standard_search" model="ir.ui.view">
        <field name="name">iatf.blend.standard.search</field>
        <field name="model">iatf.blend.standard</field>
        <field name="arch" type="xml">
            <search string="배합 관리기준">
                <field name="name"/>
                <field name="product_id"/>
                <field name="material_id"/>
                <filter name="f_approved" string="고객 승인됨" domain="[('customer_approved','=',True)]"/>
                <!-- 재생재를 쓰면서 승인 근거가 없는 기준이 SQ 1_5 의 감점 지점이다. -->
                <filter name="f_not_approved" string="고객 승인 없음"
                        domain="[('customer_approved','=',False),('max_regrind_ratio','&gt;',0)]"/>
                <separator/>
                <filter name="f_archived" string="보관됨" domain="[('active','=',False)]"/>
                <group expand="0" string="그룹">
                    <filter name="g_product" string="품목" context="{'group_by':'product_id'}"/>
                    <filter name="g_material" string="수지" context="{'group_by':'material_id'}"/>
                    <filter name="g_basis" string="비율 기준" context="{'group_by':'ratio_basis'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_blend_standard" model="ir.actions.act_window">
        <field name="name">배합 관리기준</field>
        <field name="res_model">iatf.blend.standard</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">배합 관리기준을 등록하십시오.</p>
            <p>품목별 재생재 최대 투입비율입니다. 이 기준이 있어야 배합일지가 합부를 판정할 수 있습니다.</p>
        </field>
    </record>

    <!-- ============ 분쇄일지 ============ -->
    <record id="view_regrind_log_list" model="ir.ui.view">
        <field name="name">iatf.regrind.log.list</field>
        <field name="model">iatf.regrind.log</field>
        <field name="arch" type="xml">
            <list string="분쇄일지" decoration-danger="foreign_check == 'ng'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="regrind_date"/>
                <field name="shift" optional="hide"/>
                <field name="equipment_id" optional="show"/>
                <field name="source_product_id"/>
                <field name="source_type"/>
                <field name="input_qty" sum="투입 합계"/>
                <field name="output_qty" sum="산출 합계"/>
                <field name="yield_ratio" optional="hide"/>
                <field name="output_lot_name" optional="hide"/>
                <field name="foreign_check" widget="badge"
                       decoration-success="foreign_check == 'ok'"
                       decoration-danger="foreign_check == 'ng'"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_regrind_log_form" model="ir.ui.view">
        <field name="name">iatf.regrind.log.form</field>
        <field name="model">iatf.regrind.log</field>
        <field name="arch" type="xml">
            <form string="분쇄일지">
                <header>
                    <button name="action_done" type="object" string="완료"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="작성중으로"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="분쇄">
                            <field name="regrind_date"/>
                            <field name="shift"/>
                            <field name="equipment_id"/>
                            <field name="operator_id"/>
                        </group>
                        <group string="투입 스크랩">
                            <field name="source_product_id"/>
                            <field name="source_type"/>
                            <field name="input_qty"/>
                        </group>
                    </group>
                    <group>
                        <group string="산출 재생재">
                            <field name="output_qty"/>
                            <field name="loss_qty" readonly="1"/>
                            <field name="yield_ratio" readonly="1"/>
                            <field name="used_qty" readonly="1"/>
                        </group>
                        <group string="식별·보관">
                            <field name="output_lot_id"/>
                            <field name="output_lot_name"/>
                            <field name="storage_location"/>
                        </group>
                    </group>
                    <group string="이물 혼입 점검">
                        <field name="foreign_check"/>
                        <field name="foreign_action" invisible="foreign_check != 'ng'"
                               required="foreign_check == 'ng'"/>
                    </group>
                    <notebook>
                        <page string="이 재생재를 쓴 배합">
                            <field name="blend_line_ids" readonly="1">
                                <list>
                                    <field name="blend_id"/>
                                    <field name="product_id"/>
                                    <field name="qty" sum="투입 누계"/>
                                </list>
                            </field>
                        </page>
                        <page string="비고">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_regrind_log_search" model="ir.ui.view">
        <field name="name">iatf.regrind.log.search</field>
        <field name="model">iatf.regrind.log</field>
        <field name="arch" type="xml">
            <search string="분쇄일지">
                <field name="name"/>
                <field name="source_product_id"/>
                <field name="equipment_id"/>
                <field name="output_lot_name"/>
                <filter name="f_foreign_ng" string="이물 발견" domain="[('foreign_check','=','ng')]"/>
                <!-- 점검을 하지 않은 채 완료된 건은 없어야 한다(백스톱이 막는다).
                     작성중인 건을 찾는 용도로 남긴다. -->
                <filter name="f_no_check" string="이물 점검 미기록"
                        domain="[('foreign_check','=',False)]"/>
                <separator/>
                <filter name="f_draft" string="작성중" domain="[('state','=','draft')]"/>
                <filter name="f_done" string="완료" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="f_this_month" string="이번 달"
                        domain="[('regrind_date','&gt;=',(context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="그룹">
                    <filter name="g_equipment" string="분쇄기" context="{'group_by':'equipment_id'}"/>
                    <filter name="g_product" string="스크랩 품목" context="{'group_by':'source_product_id'}"/>
                    <filter name="g_source" string="스크랩 출처" context="{'group_by':'source_type'}"/>
                    <filter name="g_date" string="분쇄일" context="{'group_by':'regrind_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_regrind_log" model="ir.actions.act_window">
        <field name="name">분쇄일지</field>
        <field name="res_model">iatf.regrind.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">분쇄 실적이 아직 없습니다.</p>
            <p>스크랩을 분쇄해 재생재를 만들 때마다 기록합니다. 배합일지의 재생재 줄이 이 기록을 가리킵니다.</p>
        </field>
    </record>

    <!-- ============ 배합일지 ============ -->
    <record id="view_blend_log_list" model="ir.ui.view">
        <field name="name">iatf.blend.log.list</field>
        <field name="model">iatf.blend.log</field>
        <field name="arch" type="xml">
            <list string="배합일지" decoration-danger="result == 'ng'"
                  decoration-warning="result == 'pending'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="blend_date"/>
                <field name="shift" optional="hide"/>
                <field name="equipment_id" optional="hide"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="virgin_qty" sum="신재 합계"/>
                <field name="regrind_qty" sum="재생재 합계"/>
                <field name="additive_qty" optional="hide"/>
                <field name="total_qty" sum="총 투입"/>
                <field name="regrind_ratio"/>
                <field name="limit_ratio"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'ok'"
                       decoration-danger="result == 'ng'"
                       decoration-warning="result == 'pending'"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_blend_log_form" model="ir.ui.view">
        <field name="name">iatf.blend.log.form</field>
        <field name="model">iatf.blend.log</field>
        <field name="arch" type="xml">
            <form string="배합일지">
                <header>
                    <button name="action_done" type="object" string="완료"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="작성중으로"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="result != 'pending' or not line_ids">
                        이 품목의 배합 관리기준이 없어 합부를 판정할 수 없습니다.
                        「배합 관리기준」에 재생재 최대비율을 먼저 등록하십시오.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="result != 'ng'">
                        재생재 비율이 관리기준을 초과했습니다. 조치 내용을 적어야 완료할 수 있습니다.
                    </div>
                    <group>
                        <group string="배합">
                            <field name="blend_date"/>
                            <field name="shift"/>
                            <field name="equipment_id"/>
                            <field name="operator_id"/>
                        </group>
                        <group string="적용 대상">
                            <field name="product_id"/>
                            <field name="production_id"/>
                            <field name="lot_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="투입 내역">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="material_type"/>
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="regrind_log_id"
                                           required="material_type == 'regrind'"
                                           readonly="material_type != 'regrind'"/>
                                    <field name="qty" sum="투입 합계"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                            <group>
                                <group string="투입 집계">
                                    <field name="virgin_qty" readonly="1"/>
                                    <field name="regrind_qty" readonly="1"/>
                                    <field name="additive_qty" readonly="1"/>
                                    <field name="resin_qty" readonly="1"/>
                                    <field name="total_qty" readonly="1"/>
                                </group>
                                <group string="판정">
                                    <field name="standard_id" readonly="1"/>
                                    <field name="ratio_basis" readonly="1"/>
                                    <field name="regrind_ratio" readonly="1"/>
                                    <field name="limit_ratio" readonly="1"/>
                                    <field name="additive_ratio" readonly="1"/>
                                    <field name="limit_additive_ratio" readonly="1"/>
                                    <field name="result" readonly="1" widget="badge"
                                           decoration-success="result == 'ok'"
                                           decoration-danger="result == 'ng'"
                                           decoration-warning="result == 'pending'"/>
                                </group>
                            </group>
                            <group string="기준 초과 시 조치" invisible="result != 'ng'">
                                <field name="ng_action" nolabel="1" required="result == 'ng'"/>
                            </group>
                        </page>
                        <page string="비고">
                            <field name="note" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_blend_log_search" model="ir.ui.view">
        <field name="name">iatf.blend.log.search</field>
        <field name="model">iatf.blend.log</field>
        <field name="arch" type="xml">
            <search string="배합일지">
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="equipment_id"/>
                <field name="operator_id"/>
                <filter name="f_ng" string="기준 초과" domain="[('result','=','ng')]"/>
                <!-- 기준이 없어 판정을 못 한 배합. 실적보다 먼저 메워야 할 공백이다. -->
                <filter name="f_pending" string="기준 미등록(판정 불가)"
                        domain="[('result','=','pending'),('line_ids','!=',False)]"/>
                <filter name="f_ok" string="기준 이내" domain="[('result','=','ok')]"/>
                <separator/>
                <filter name="f_has_regrind" string="재생재 사용" domain="[('regrind_qty','&gt;',0)]"/>
                <filter name="f_no_lot" string="생산 LOT 미기록" domain="[('lot_id','=',False)]"/>
                <separator/>
                <filter name="f_draft" string="작성중" domain="[('state','=','draft')]"/>
                <filter name="f_done" string="완료" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="f_today" string="오늘"
                        domain="[('blend_date','=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="f_this_month" string="이번 달"
                        domain="[('blend_date','&gt;=',(context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="그룹">
                    <filter name="g_product" string="품목" context="{'group_by':'product_id'}"/>
                    <filter name="g_equipment" string="배합기" context="{'group_by':'equipment_id'}"/>
                    <filter name="g_shift" string="교대" context="{'group_by':'shift'}"/>
                    <filter name="g_result" string="판정" context="{'group_by':'result'}"/>
                    <filter name="g_date" string="배합일" context="{'group_by':'blend_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 조회(집계) 화면 — 월별·품목별 재생재 비율 추이. SQ 는 "관리하고 있는가"를 본다. -->
    <record id="view_blend_log_pivot" model="ir.ui.view">
        <field name="name">iatf.blend.log.pivot</field>
        <field name="model">iatf.blend.log</field>
        <field name="arch" type="xml">
            <pivot string="배합 비율 집계" sample="0">
                <field name="product_id" type="row"/>
                <field name="blend_date" interval="month" type="col"/>
                <field name="regrind_ratio" type="measure"/>
                <field name="regrind_qty" type="measure"/>
                <field name="total_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_blend_log_graph" model="ir.ui.view">
        <field name="name">iatf.blend.log.graph</field>
        <field name="model">iatf.blend.log</field>
        <field name="arch" type="xml">
            <graph string="재생재 비율 추이" type="line" sample="0">
                <field name="blend_date" interval="week"/>
                <field name="regrind_ratio" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_blend_log" model="ir.actions.act_window">
        <field name="name">배합일지</field>
        <field name="res_model">iatf.blend.log</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">배합 실적이 아직 없습니다.</p>
            <p>LOT별 신재·재생재 투입을 기록하면 비율과 합부가 자동으로 판정됩니다 (SQ 사출 1_10).</p>
        </field>
    </record>

    <record id="action_blend_log_ng" model="ir.actions.act_window">
        <field name="name">기준 초과·판정불가 배합</field>
        <field name="res_model">iatf.blend.log</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('result','in',['ng','pending']),('line_ids','!=',False)]</field>
        <field name="context">{'search_default_g_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">기준을 벗어난 배합이 없습니다.</p>
            <p>기준 초과 배합과, 관리기준이 없어 판정하지 못한 배합을 함께 보여줍니다.</p>
        </field>
    </record>

</odoo>
