<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iatf_approval_template_list" model="ir.ui.view">
        <field name="name">iatf.approval.template.list</field>
        <field name="model">iatf.approval.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="department_id"/>
                <field name="min_amount"/>
            </list>
        </field>
    </record>

    <record id="view_iatf_approval_template_form" model="ir.ui.view">
        <field name="name">iatf.approval.template.form</field>
        <field name="model">iatf.approval.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="min_amount"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="approver_mode"/>
                            <field name="user_id" required="approver_mode == 'user'"
                                   readonly="approver_mode != 'user'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_iatf_approval_template" model="ir.actions.act_window">
        <field name="name">결재선 템플릿</field>
        <field name="res_model">iatf.approval.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">기본 결재선 템플릿을 만드세요</p>
            <p>모델·부서·금액 조건으로 매칭되어, 상신 시 결재선이 비어 있으면 자동 구성됩니다.</p>
        </field>
    </record>

    <menuitem id="menu_iatf_approval_template" name="결재선 템플릿"
              parent="base.menu_custom" action="action_iatf_approval_template"
              groups="base.group_system" sequence="60"/>
</odoo>
