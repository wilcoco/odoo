<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_kr_customer_tax_invoice" model="ir.actions.act_window">
        <field name="name">매출처 세금계산서</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kr_customer_tax_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_move_form_kr_plus')})]"/>
        <field name="search_view_id" ref="view_kr_customer_tax_invoice_search"/>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">매출처 세금계산서를 등록하세요.</p>
        </field>
    </record>

    <record id="action_kr_customer_tax_refund" model="ir.actions.act_window">
        <field name="name">매출처 취소 세금계산서</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kr_customer_tax_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_move_form_kr_plus')})]"/>
        <field name="search_view_id" ref="view_kr_customer_tax_invoice_search"/>
        <field name="domain">[('move_type', '=', 'out_refund')]</field>
        <field name="context">{'default_move_type': 'out_refund', 'display_account_trust': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">매출처 취소 세금계산서를 등록하세요.</p>
        </field>
    </record>

    <record id="action_kr_vendor_tax_invoice" model="ir.actions.act_window">
        <field name="name">매입처 세금계산서</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kr_vendor_tax_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_move_form_kr_plus')})]"/>
        <field name="search_view_id" ref="view_kr_vendor_tax_invoice_search"/>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'display_account_trust': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">매입처 세금계산서를 등록하세요.</p>
        </field>
    </record>

    <record id="action_kr_vendor_tax_refund" model="ir.actions.act_window">
        <field name="name">매입처 취소 세금계산서</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kr_vendor_tax_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_move_form_kr_plus')})]"/>
        <field name="search_view_id" ref="view_kr_vendor_tax_invoice_search"/>
        <field name="domain">[('move_type', '=', 'in_refund')]</field>
        <field name="context">{'default_move_type': 'in_refund', 'display_account_trust': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">매입처 취소 세금계산서를 등록하세요.</p>
        </field>
    </record>

    <!-- 회계 대시보드의 저널 바로가기도 회사용 목록·폼을 사용한다. -->
    <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kr_customer_tax_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_move_form_kr_plus')})]"/>
        <field name="search_view_id" ref="view_kr_customer_tax_invoice_search"/>
    </record>
    <record id="account.action_move_out_refund_type" model="ir.actions.act_window">
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kr_customer_tax_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_move_form_kr_plus')})]"/>
        <field name="search_view_id" ref="view_kr_customer_tax_invoice_search"/>
    </record>
    <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kr_vendor_tax_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_move_form_kr_plus')})]"/>
        <field name="search_view_id" ref="view_kr_vendor_tax_invoice_search"/>
    </record>
    <record id="account.action_move_in_refund_type" model="ir.actions.act_window">
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kr_vendor_tax_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_move_form_kr_plus')})]"/>
        <field name="search_view_id" ref="view_kr_vendor_tax_invoice_search"/>
    </record>

    <record id="action_kr_journal_entries" model="ir.actions.act_window">
        <field name="name">전표</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_move_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_move_form_kr_plus')})]"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <!-- 일반 전표뿐 아니라 Odoo 청구서·세금계산서도 함께 조회한다. -->
        <field name="domain">[]</field>
        <field name="context">{'default_move_type': 'entry', 'view_no_maturity': True}</field>
    </record>

    <record id="action_kr_bank_journals" model="ir.actions.act_window">
        <field name="name">계좌 설정</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kr_bank_journal_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_account_journal_form')})]"/>
        <field name="domain">[('type', '=', 'bank')]</field>
        <field name="context">{'default_type': 'bank', 'kr_bank_account_setup': True}</field>
    </record>

    <!-- 선택 Enterprise 모듈을 강제 의존하지 않는 설정 바로가기 -->
    <record id="action_kr_frequent_asset_models" model="ir.actions.server">
        <field name="name">자산 모델</field>
        <field name="model_id" ref="model_account_kr_plus_settings"/>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = env["account.kr.plus.settings"].action_open_frequent_optional_setting(
    "asset_models"
)</field>
    </record>
    <record id="action_kr_frequent_account_reports" model="ir.actions.server">
        <field name="name">회계 보고서 설정</field>
        <field name="model_id" ref="model_account_kr_plus_settings"/>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = env["account.kr.plus.settings"].action_open_frequent_optional_setting(
    "account_reports"
)</field>
    </record>
    <record id="action_kr_frequent_disallowed_expense_categories" model="ir.actions.server">
        <field name="name">손금불산입 카테고리</field>
        <field name="model_id" ref="model_account_kr_plus_settings"/>
        <field name="groups_id" eval="[(4, ref('account.group_account_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = env["account.kr.plus.settings"].action_open_frequent_optional_setting(
    "disallowed_expense_categories"
)</field>
    </record>

    <!-- 회계 앱 상단에서 자주 쓰는 기준정보만 빠르게 여는 바로가기 -->
    <menuitem id="menu_kr_frequent_settings_root"
              name="자주 쓰는 설정"
              parent="account.menu_finance"
              groups="account.group_account_manager"
              sequence="5"/>
    <menuitem id="menu_kr_frequent_general_settings"
              name="설정"
              parent="menu_kr_frequent_settings_root"
              action="account.action_account_config"
              groups="base.group_system"
              sequence="10"/>
    <menuitem id="menu_kr_frequent_kr_settings"
              name="한국식 회계 설정"
              parent="menu_kr_frequent_settings_root"
              action="action_account_kr_plus_settings"
              sequence="20"/>
    <menuitem id="menu_kr_frequent_bank_accounts"
              name="은행계좌 설정"
              parent="menu_kr_frequent_settings_root"
              action="action_kr_bank_journals"
              sequence="30"/>
    <menuitem id="menu_kr_frequent_reconcile_models"
              name="조정 방식"
              parent="menu_kr_frequent_settings_root"
              action="account.action_account_reconcile_model"
              sequence="40"/>
    <menuitem id="menu_kr_frequent_chart_of_accounts"
              name="계정과목표"
              parent="menu_kr_frequent_settings_root"
              action="account.action_account_form"
              sequence="50"/>
    <menuitem id="menu_kr_frequent_taxes"
              name="세금 종류"
              parent="menu_kr_frequent_settings_root"
              action="account.action_tax_form"
              sequence="60"/>
    <menuitem id="menu_kr_frequent_journals"
              name="전표 유형"
              parent="menu_kr_frequent_settings_root"
              action="account.action_account_journal_form"
              sequence="70"/>
    <menuitem id="menu_kr_frequent_assets_group"
              name="고정자산"
              parent="menu_kr_frequent_settings_root"
              sequence="80"/>
    <menuitem id="menu_kr_frequent_asset_models"
              name="자산 모델"
              parent="menu_kr_frequent_assets_group"
              action="action_kr_frequent_asset_models"
              sequence="10"/>
    <menuitem id="menu_kr_frequent_account_reports"
              name="회계 보고서 설정"
              parent="menu_kr_frequent_settings_root"
              action="action_kr_frequent_account_reports"
              sequence="90"/>
    <menuitem id="menu_kr_frequent_disallowed_expense_categories"
              name="손금불산입 카테고리"
              parent="menu_kr_frequent_settings_root"
              action="action_kr_frequent_disallowed_expense_categories"
              sequence="100"/>

    <!-- 표준 메뉴 이름과 동작을 회사용 화면으로 교체한다. -->
    <record id="account.menu_action_move_out_invoice_type" model="ir.ui.menu">
        <field name="name">매출처 세금계산서</field>
        <field name="action" ref="action_kr_customer_tax_invoice"/>
    </record>
    <record id="account.menu_action_move_out_refund_type" model="ir.ui.menu">
        <field name="name">매출처 취소 세금계산서</field>
        <field name="action" ref="action_kr_customer_tax_refund"/>
    </record>
    <record id="account.menu_action_move_in_invoice_type" model="ir.ui.menu">
        <field name="name">매입처 세금계산서</field>
        <field name="action" ref="action_kr_vendor_tax_invoice"/>
    </record>
    <record id="account.menu_action_move_in_refund_type" model="ir.ui.menu">
        <field name="name">매입처 취소 세금계산서</field>
        <field name="action" ref="action_kr_vendor_tax_refund"/>
    </record>
    <record id="account.menu_action_move_journal_line_form" model="ir.ui.menu">
        <field name="name">전표</field>
        <field name="action" ref="action_kr_journal_entries"/>
    </record>

    <menuitem id="menu_kr_bank_journals"
              name="계좌 설정"
              parent="account.account_banks_menu"
              action="action_kr_bank_journals"
              groups="account.group_account_manager"
              sequence="2"/>
</odoo>
