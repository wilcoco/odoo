<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_kr_vendor_tax_invoice" model="ir.actions.act_window">
        <field name="name">매입처 세금계산서</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kr_vendor_tax_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_move_form_kr_plus')})]"/>
        <field name="search_view_id" ref="view_kr_vendor_tax_invoice_search"/>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'display_account_trust': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">매입처 세금계산서를 등록하세요.</p>
        </field>
    </record>

    <record id="action_kr_vendor_tax_refund" model="ir.actions.act_window">
        <field name="name">매입처 취소 세금계산서</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kr_vendor_tax_invoice_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_move_form_kr_plus')})]"/>
        <field name="search_view_id" ref="view_kr_vendor_tax_invoice_search"/>
        <field name="domain">[('move_type', '=', 'in_refund')]</field>
        <field name="context">{'default_move_type': 'in_refund', 'display_account_trust': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">매입처 취소 세금계산서를 등록하세요.</p>
        </field>
    </record>

    <record id="action_kr_journal_entries" model="ir.actions.act_window">
        <field name="name">전표</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_move_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_move_form_kr_plus')})]"/>
        <field name="search_view_id" ref="account.view_account_move_filter"/>
        <!-- 일반 전표뿐 아니라 Odoo 청구서·세금계산서도 함께 조회한다. -->
        <field name="domain">[]</field>
        <field name="context">{'default_move_type': 'entry', 'view_no_maturity': True}</field>
    </record>

    <record id="action_kr_bank_journals" model="ir.actions.act_window">
        <field name="name">당좌·보통예금 은행계좌</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_kr_bank_journal_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_account_journal_form')})]"/>
        <field name="domain">[('type', '=', 'bank')]</field>
        <field name="context">{'default_type': 'bank'}</field>
    </record>

    <!-- 표준 메뉴 이름과 동작을 회사용 화면으로 교체한다. -->
    <record id="account.menu_action_move_in_invoice_type" model="ir.ui.menu">
        <field name="name">매입처 세금계산서</field>
        <field name="action" ref="action_kr_vendor_tax_invoice"/>
    </record>
    <record id="account.menu_action_move_in_refund_type" model="ir.ui.menu">
        <field name="name">매입처 취소 세금계산서</field>
        <field name="action" ref="action_kr_vendor_tax_refund"/>
    </record>
    <record id="account.menu_action_move_journal_line_form" model="ir.ui.menu">
        <field name="name">전표</field>
        <field name="action" ref="action_kr_journal_entries"/>
    </record>

    <menuitem id="menu_kr_bank_journals"
              name="당좌·보통예금 은행계좌"
              parent="account.account_banks_menu"
              action="action_kr_bank_journals"
              groups="account.group_account_manager"
              sequence="2"/>
</odoo>
