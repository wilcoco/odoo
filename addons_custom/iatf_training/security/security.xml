<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_training_user" model="res.groups">
        <field name="name">Training User</field>
        <field name="category_id" ref="iatf_document_control.module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_training_manager" model="res.groups">
        <field name="name">Training Manager</field>
        <field name="category_id" ref="iatf_document_control.module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('group_training_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_training_user" model="res.groups"><field name="implied_ids" eval="[(4, ref('cams_evidence_core.group_evidence_user'))]"/></record>
    <record id="group_training_manager" model="res.groups"><field name="implied_ids" eval="[(4, ref('cams_evidence_core.group_evidence_manager'))]"/></record>
    <record id="preassessment_company" model="ir.rule"><field name="name">자격 사전평가 회사 격리</field><field name="model_id" ref="model_iatf_qualification_preassessment"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
    <record id="competence_company" model="ir.rule"><field name="name">직원 역량 회사 격리</field><field name="model_id" ref="model_iatf_competence_matrix"/><field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field></record>
</odoo>
