<odoo>
 <record id="qualification_criteria_form" model="ir.ui.view">
  <field name="name">qualification.criteria.form</field><field name="model">iatf.document</field>
  <field name="inherit_id" ref="iatf_document_control.view_document_quality_evidence"/>
  <field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="자격 사전평가 기준" invisible="quality_evidence_kind != 'qualification_criteria'">
   <field name="qualification_criteria_confirmed"/><field name="qualification_theory_min"/><field name="qualification_practical_min"/><field name="qualification_method"/>
  </group></xpath></field>
 </record>
 <record id="preassessment_list" model="ir.ui.view"><field name="name">qualification.preassessment.list</field><field name="model">iatf.qualification.preassessment</field><field name="arch" type="xml"><list><field name="name"/><field name="record_date"/><field name="competence_id"/><field name="result"/><field name="evidence_revision"/><field name="evidence_state"/><field name="approval_state"/></list></field></record>
 <record id="preassessment_form" model="ir.ui.view"><field name="name">qualification.preassessment.form</field><field name="model">iatf.qualification.preassessment</field><field name="arch" type="xml"><form>
  <header><button name="action_submit_approval" type="object" string="승인 요청" invisible="evidence_state == 'done' or approval_state not in ('draft','rejected')"/><button name="action_approve_approval" type="object" string="승인" invisible="approval_state != 'in_progress' or not approval_is_current_user"/><button name="action_reject_approval" type="object" string="반려" invisible="approval_state != 'in_progress' or not approval_is_current_user"/><button name="action_complete_evidence" type="object" string="검증 완료" invisible="approval_state != 'approved' or evidence_state == 'done'"/><button name="action_new_evidence_revision" type="object" string="새 개정" invisible="evidence_state != 'done'"/><field name="approval_is_current_user" invisible="1"/><field name="evidence_state" widget="statusbar"/></header>
  <sheet><div class="alert alert-info">이 화면은 자격 부여 전 시험 이력입니다. 검증 완료가 직원의 현재 역량 수준이나 생산 투입 자격을 자동으로 바꾸지 않습니다.</div>
   <group><field name="name"/><field name="record_date"/><field name="company_id"/><field name="responsible_id"/><field name="competence_id"/><field name="criteria_document_id"/><field name="product_id"/><field name="lot_id"/><field name="workcenter_id"/><field name="trace_exception"/></group>
   <group string="실제 시험 결과"><field name="theory_score"/><field name="practical_score"/><field name="assessed_level"/><field name="observation"/><field name="result"/><field name="followup"/><field name="attachment_ids" widget="many2many_binary"/></group>
   <group string="승인·개정"><field name="approval_state"/><field name="approval_line_ids"><list editable="bottom"><field name="sequence"/><field name="user_id"/><field name="state" readonly="1"/></list></field><field name="evidence_revision"/><field name="completed_at"/><field name="completion_snapshot" readonly="1"/></group>
  </sheet><chatter/></form></field></record>
 <record id="action_preassessment" model="ir.actions.act_window"><field name="name">자격 사전평가</field><field name="res_model">iatf.qualification.preassessment</field><field name="view_mode">list,form</field></record>
 <menuitem id="menu_preassessment" name="자격 사전평가" parent="menu_iatf_training_root" action="action_preassessment" groups="group_training_user" sequence="25"/>
</odoo>
