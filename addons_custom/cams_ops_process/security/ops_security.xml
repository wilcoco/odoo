<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ops" model="ir.module.category">
        <field name="name">회사 운영 센터</field>
    </record>
    <record id="group_ops_user" model="res.groups">
        <field name="name">운영 업무 사용자</field>
        <field name="category_id" ref="module_category_ops"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
    </record>
    <record id="group_ops_manager" model="res.groups">
        <field name="name">운영 관리자</field>
        <field name="category_id" ref="module_category_ops"/>
        <field name="implied_ids" eval="[(4, ref('group_ops_user'))]"/>
    </record>
    <!-- 전사 도구: 모든 내부 사용자에게 운영 업무 사용자 권한 자동 부여 -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ops_user'))]"/>
    </record>
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_ops_manager'))]"/>
    </record>

    <!-- 일반 사용자는 직접 배정된 역할 또는 자신의 임직원 부서에 배정된 역할만 본다. -->
    <record id="rule_ops_role_user_scope" model="ir.rule">
        <field name="name">운영 역할: 내 담당 범위</field>
        <field name="model_id" ref="model_ops_role"/>
        <field name="domain_force">['|', ('user_ids', 'in', user.id), ('department_ids', 'in', user.employee_ids.department_id.ids)]</field>
        <field name="groups" eval="[(4, ref('group_ops_user'))]"/>
    </record>
    <record id="rule_ops_role_manager_all" model="ir.rule">
        <field name="name">운영 역할: 관리자 전체</field>
        <field name="model_id" ref="model_ops_role"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ops_manager'))]"/>
    </record>

    <record id="rule_ops_task_def_user_scope" model="ir.rule">
        <field name="name">업무 정의: 내 담당·승인 범위</field>
        <field name="model_id" ref="model_ops_task_def"/>
        <field name="domain_force">['|', '|', '|', ('role_id.user_ids', 'in', user.id), ('role_id.department_ids', 'in', user.employee_ids.department_id.ids), ('approver_role_id.user_ids', 'in', user.id), ('approver_role_id.department_ids', 'in', user.employee_ids.department_id.ids)]</field>
        <field name="groups" eval="[(4, ref('group_ops_user'))]"/>
    </record>
    <record id="rule_ops_task_def_manager_all" model="ir.rule">
        <field name="name">업무 정의: 관리자 전체</field>
        <field name="model_id" ref="model_ops_task_def"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ops_manager'))]"/>
    </record>

    <record id="rule_ops_task_user_scope" model="ir.rule">
        <field name="name">운영 업무: 내 담당·승인 범위</field>
        <field name="model_id" ref="model_ops_task"/>
        <field name="domain_force">['|', '|', ('role_id.user_ids', 'in', user.id), ('role_id.department_ids', 'in', user.employee_ids.department_id.ids), '&amp;', ('state', '=', 'done'), '|', ('task_def_id.approver_role_id.user_ids', 'in', user.id), ('task_def_id.approver_role_id.department_ids', 'in', user.employee_ids.department_id.ids)]</field>
        <field name="groups" eval="[(4, ref('group_ops_user'))]"/>
    </record>
    <record id="rule_ops_task_manager_all" model="ir.rule">
        <field name="name">운영 업무: 관리자 전체</field>
        <field name="model_id" ref="model_ops_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ops_manager'))]"/>
    </record>
</odoo>
