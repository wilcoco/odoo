<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_coating_test_user" model="res.groups">
        <field name="name">도장시험 담당자</field>
        <field name="category_id" ref="iatf_document_control.module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_coating_test_manager" model="res.groups">
        <field name="name">도장시험 관리자</field>
        <field name="category_id" ref="iatf_document_control.module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('group_coating_test_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
