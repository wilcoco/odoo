<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_reliability_test" model="ir.sequence">
            <field name="name">신뢰성 시험</field>
            <field name="code">iatf.reliability.test</field>
            <field name="prefix">REL-%(year)s-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_adhesion_test" model="ir.sequence">
            <field name="name">밀착성 시험</field>
            <field name="code">iatf.adhesion.test</field>
            <field name="prefix">ADH-%(year)s-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_color_measurement" model="ir.sequence">
            <field name="name">색상 측정</field>
            <field name="code">iatf.color.measurement</field>
            <field name="prefix">COL-%(year)s-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_coating_thickness" model="ir.sequence">
            <field name="name">도막두께 측정</field>
            <field name="code">iatf.coating.thickness</field>
            <field name="prefix">CTK-%(year)s-</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
