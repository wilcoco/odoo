<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ 신뢰성 시험 ============ -->
    <record id="view_reliability_test_list" model="ir.ui.view">
        <field name="name">iatf.reliability.test.list</field>
        <field name="model">iatf.reliability.test</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="test_date"/>
                <field name="product_id"/>
                <field name="test_type"/>
                <field name="report_no"/>
                <field name="result" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_reliability_test_form" model="ir.ui.view">
        <field name="name">iatf.reliability.test.form</field>
        <field name="model">iatf.reliability.test</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_done" string="시험 완료" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_close" string="종료" type="object" class="btn-success"
                            invisible="state != 'tested'"/>
                    <button name="action_cancel" string="취소" type="object"
                            invisible="state in ('closed','cancelled')"/>
                    <button name="action_submit_approval" string="결재 상신" type="object" class="btn-primary"
                            invisible="approval_state not in (False, 'draft', 'rejected')"/>
                    <button name="action_approve_approval" string="승인" type="object" class="btn-success"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <button name="action_reject_approval" string="반려" type="object"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <field name="approval_is_current_user" invisible="1"/>
                    <field name="approval_state" widget="badge"
                           decoration-success="approval_state == 'approved'"
                           decoration-danger="approval_state == 'rejected'"
                           decoration-info="approval_state == 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,tested,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="test_type"/>
                            <field name="test_date"/>
                            <field name="test_standard"/>
                            <field name="tester_id"/>
                        </group>
                        <group>
                            <field name="sample_qty"/>
                            <field name="test_duration"/>
                            <field name="report_no"/>
                            <field name="result"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="시험 조건 / 측정값">
                            <group>
                                <field name="test_conditions"/>
                                <field name="measured_values"/>
                                <field name="notes"/>
                            </group>
                        </page>
                        <page string="결재선">
                            <field name="approval_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_reliability_test" model="ir.actions.act_window">
        <field name="name">신뢰성 시험</field>
        <field name="res_model">iatf.reliability.test</field>
        <field name="view_mode">list,form</field>
    </record>

