<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iatf_calibration_record_tree" model="ir.ui.view">
        <field name="name">iatf.calibration.record.tree</field>
        <field name="model">iatf.calibration.record</field>
        <field name="arch" type="xml">
            <list decoration-danger="result == 'fail'">
                <field name="name"/><field name="equipment_id"/><field name="calibration_date"/>
                <field name="calibration_type"/><field name="provider"/><field name="certificate_number"/>
                <field name="result" widget="badge" decoration-success="result in ('pass','adjusted')" decoration-danger="result == 'fail'" decoration-warning="result == 'limited'"/>
                <field name="next_due_date"/>
            </list>
        </field>
    </record>

    <record id="view_iatf_calibration_record_form" model="ir.ui.view">
        <field name="name">iatf.calibration.record.form</field>
        <field name="model">iatf.calibration.record</field>
        <field name="arch" type="xml">
            <form string="Calibration Record">
                <header>
                    <button name="action_submit_approval" string="결재 상신" type="object" class="btn-primary"
                            invisible="approval_state not in (False, 'draft', 'rejected')"/>
                    <button name="action_approve_approval" string="승인" type="object" class="btn-success"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <button name="action_reject_approval" string="반려" type="object"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <field name="approval_is_current_user" invisible="1"/>
                    <field name="approval_state" widget="badge"
                           decoration-success="approval_state == 'approved'"
                           decoration-danger="approval_state == 'rejected'"
                           decoration-info="approval_state == 'in_progress'"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Calibration">
                            <field name="equipment_id"/><field name="calibration_date"/>
                            <field name="calibration_type"/><field name="provider"/><field name="certificate_number"/>
                            <field name="standard_used"/>
                            <field name="performed_by"/>
                        </group>
                        <group string="Result">
                            <field name="result"/><field name="uncertainty"/><field name="next_due_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Environment">
                            <field name="temperature"/><field name="humidity"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Measured Values" name="data">
                            <group>
                                <field name="before_values"/>
                                <field name="after_values"/>
                            </group>
                            <field name="measured_values"/>
                        </page>
                        <page string="Notes / Certificates" name="notes">
                            <field name="notes"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="결재선" name="approval">
                            <field name="approval_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_iatf_calibration_record" model="ir.actions.act_window">
        <field name="name">Calibration Records</field>
        <field name="res_model">iatf.calibration.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
