<odoo>
<record id="view_condition_limit_list" model="ir.ui.view"><field name="name">condition_limit.list</field><field name="model">injection.condition.limit</field><field name="arch" type="xml"><list><field name="name"/><field name="product_id"/><field name="workcenter_id"/><field name="metric"/><field name="channel_no"/><field name="unit"/><field name="lower"/><field name="upper"/><field name="valid_from"/><field name="valid_to"/></list></field></record>
<record id="view_condition_limit_form" model="ir.ui.view"><field name="name">condition_limit.form</field><field name="model">injection.condition.limit</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="product_id"/><field name="workcenter_id"/><field name="metric"/><field name="channel_no"/><field name="unit"/><field name="lower"/><field name="upper"/><field name="valid_from"/><field name="valid_to"/><field name="document_id"/><field name="reason"/><field name="company_id"/><field name="active"/></group></sheet><chatter/></form></field></record>
<record id="action_condition_limit" model="ir.actions.act_window"><field name="name">성형조건 상·하한</field><field name="res_model">injection.condition.limit</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_condition_limit" name="성형조건 상·하한" parent="stock.menu_stock_config_settings" action="action_condition_limit" groups="quality.group_quality_manager"/>
<record id="view_startup_standard_list" model="ir.ui.view"><field name="name">startup_standard.list</field><field name="model">injection.startup.standard</field><field name="arch" type="xml"><list><field name="name"/><field name="product_id"/><field name="trigger"/><field name="quantity"/><field name="document_id"/><field name="reason"/><field name="company_id"/><field name="active"/></list></field></record>
<record id="view_startup_standard_form" model="ir.ui.view"><field name="name">startup_standard.form</field><field name="model">injection.startup.standard</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="product_id"/><field name="trigger"/><field name="quantity"/><field name="document_id"/><field name="reason"/><field name="company_id"/><field name="active"/></group></sheet><chatter/></form></field></record>
<record id="action_startup_standard" model="ir.actions.act_window"><field name="name">초기 허용불량 기준</field><field name="res_model">injection.startup.standard</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_startup_standard" name="초기 허용불량 기준" parent="stock.menu_stock_config_settings" action="action_startup_standard" groups="quality.group_quality_manager"/>
<record id="view_scrap_startup" model="ir.ui.view"><field name="name">stock.scrap.startup</field><field name="model">stock.scrap</field><field name="inherit_id" ref="stock.stock_scrap_form_view"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="시업·재가동 폐기"><field name="startup_standard_id" readonly="state == 'done'"/><field name="startup_note" readonly="state == 'done'"/><field name="startup_reference_qty"/></group></xpath></field></record>
<record id="view_condition_measurement" model="ir.ui.view"><field name="name">injection.measurement.condition</field><field name="model">injection.machine.shot.measurement</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="shot_id"/><field name="metric"/><field name="channel_no"/><field name="value_kind"/><field name="value"/><field name="unit"/><field name="condition_limit_id"/><field name="condition_status"/></list></field></record>
<record id="action_condition_measurement" model="ir.actions.act_window"><field name="name">성형조건 실측 대조</field><field name="res_model">injection.machine.shot.measurement</field><field name="view_mode">list</field><field name="view_id" ref="view_condition_measurement"/></record>
<menuitem id="menu_condition_measurement" name="성형조건 실측 대조" parent="stock.menu_stock_config_settings" action="action_condition_measurement" groups="quality.group_quality_manager"/>
</odoo>