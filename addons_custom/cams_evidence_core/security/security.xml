<odoo>
  <record id="group_evidence_user" model="res.groups"><field name="name">제조품질 증빙 담당</field><field name="implied_ids" eval="[(4,ref('base.group_user'))]"/></record>
  <record id="group_evidence_manager" model="res.groups"><field name="name">제조품질 증빙 승인</field><field name="implied_ids" eval="[(4,ref('group_evidence_user'))]"/></record>
  <record id="evidence_document_company" model="ir.rule"><field name="name">증빙 참조 문서 회사</field><field name="model_id" ref="iatf_document_control.model_iatf_document"/><field name="groups" eval="[(4,ref('group_evidence_user'))]"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="evidence_revision_company" model="ir.rule"><field name="name">증빙 참조 문서 개정 회사</field><field name="model_id" ref="iatf_document_control.model_iatf_document_revision"/><field name="groups" eval="[(4,ref('group_evidence_user'))]"/><field name="domain_force">[('document_id.company_id','in',company_ids)]</field></record>
</odoo>
