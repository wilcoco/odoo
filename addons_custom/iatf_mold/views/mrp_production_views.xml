<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_iatf_mold" model="ir.ui.view">
        <field name="name">mrp.production.form.iatf.mold</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-industry"
                        invisible="not mold_id" disabled="1">
                    <span class="o_stat_text">금형</span>
                </button>
                <field name="mold_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
