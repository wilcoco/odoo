<odoo>
<record id="group_mold_user" model="res.groups"><field name="implied_ids" eval="[(4,ref('cams_evidence_core.group_evidence_user'))]"/></record>
<record id="rule_tryout_company" model="ir.rule"><field name="name">시사출 회사 격리</field><field name="model_id" ref="model_iatf_mold_tryout"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="rule_maintenance_company" model="ir.rule"><field name="name">금형 보전 회사 격리</field><field name="model_id" ref="model_iatf_mold_maintenance"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="view_mold_development_counter" model="ir.ui.view"><field name="name">injection.mold.development.counter</field><field name="model">injection.mold</field><field name="inherit_id" ref="view_injection_mold_form_iatf"/><field name="arch" type="xml"><xpath expr="//field[@name='guaranteed_shots']" position="after"><field name="dev_shots"/><field name="dev_shots_in_counter"/></xpath></field></record>
<record id="view_mold_tryout_evidence" model="ir.ui.view"><field name="name">iatf.mold.tryout.evidence</field><field name="model">iatf.mold.tryout</field><field name="inherit_id" ref="view_mold_tryout_form"/><field name="arch" type="xml">
<xpath expr="//header" position="replace"><header>
<button name="action_submit_approval" type="object" string="검토 상신" class="btn-primary" invisible="state == 'done' or approval_state not in ('draft','rejected',False)"/>
<button name="action_approve_approval" type="object" string="승인" invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
<button name="action_reject_approval" type="object" string="반려" invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
<button name="action_complete_evidence" type="object" string="검증 완료" invisible="approval_state != 'approved' or state == 'done'"/>
<button name="action_new_evidence_revision" type="object" string="정정 개정" invisible="state != 'done'"/>
<field name="approval_is_current_user" invisible="1"/><field name="approval_state" widget="badge"/><field name="evidence_state" invisible="1"/><field name="state" widget="statusbar"/>
</header></xpath>
<xpath expr="//sheet" position="inside"><group string="추적·실측 근거"><field name="company_id"/><field name="product_id"/><field name="lot_id"/><field name="workcenter_id"/><field name="trace_exception"/><field name="counter_start"/><field name="counter_end"/><field name="counter_confirmed"/><field name="counter_includes_tryout"/><field name="production_id"/><field name="document_ids" widget="many2many_tags"/></group>
<group string="검토·승인"><field name="approval_line_ids" readonly="approval_state in ('in_progress','approved') or state == 'done'"><list editable="bottom"><field name="sequence" widget="handle"/><field name="user_id"/><field name="state" readonly="1"/></list></field></group>
<group string="개정·완료 당시 근거"><field name="evidence_revision"/><field name="previous_evidence_id"/><field name="completed_by_id"/><field name="completed_at"/><field name="completion_snapshot"/></group></xpath>
</field></record>
<record id="view_mold_maintenance_evidence" model="ir.ui.view"><field name="name">iatf.mold.maintenance.evidence</field><field name="model">iatf.mold.maintenance</field><field name="inherit_id" ref="view_mold_maintenance_form"/><field name="arch" type="xml">
<xpath expr="//header" position="replace"><header>
<button name="action_submit_approval" type="object" string="검토 상신" class="btn-primary" invisible="state == 'done' or approval_state not in ('draft','rejected',False)"/>
<button name="action_approve_approval" type="object" string="승인" invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
<button name="action_reject_approval" type="object" string="반려" invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
<button name="action_complete_evidence" type="object" string="검증 완료" invisible="approval_state != 'approved' or state == 'done'"/>
<button name="action_new_evidence_revision" type="object" string="정정 개정" invisible="state != 'done'"/>
<field name="approval_is_current_user" invisible="1"/><field name="approval_state" widget="badge"/><field name="evidence_state" invisible="1"/><field name="state" widget="statusbar"/>
</header></xpath>
<xpath expr="//sheet" position="inside"><group string="추적·실측 근거"><field name="company_id"/><field name="product_id"/><field name="lot_id"/><field name="workcenter_id"/><field name="trace_exception"/><field name="cleaning_method"/><field name="cleaning_agent"/><field name="cleaning_before_photo_ids" widget="many2many_binary"/><field name="cleaning_after_photo_ids" widget="many2many_binary"/><field name="document_ids" widget="many2many_tags"/></group>
<group string="검토·승인"><field name="approval_line_ids" readonly="approval_state in ('in_progress','approved') or state == 'done'"><list editable="bottom"><field name="sequence" widget="handle"/><field name="user_id"/><field name="state" readonly="1"/></list></field></group>
<group string="개정·완료 당시 근거"><field name="evidence_revision"/><field name="previous_evidence_id"/><field name="completed_by_id"/><field name="completed_at"/><field name="completion_snapshot"/></group></xpath>
</field></record>
<record id="view_mold_temperature_evidence" model="ir.ui.view"><field name="name">iatf.mold.temperature.evidence</field><field name="model">iatf.mold.temp.log</field><field name="inherit_id" ref="view_mold_temp_log_form"/><field name="arch" type="xml">
<xpath expr="//sheet" position="before"><header>
<button name="action_submit_approval" type="object" string="검토 상신" invisible="evidence_state == 'done' or approval_state not in ('draft','rejected',False)"/>
<button name="action_approve_approval" type="object" string="승인" invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
<button name="action_reject_approval" type="object" string="반려" invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
<button name="action_complete_evidence" type="object" string="검증 완료" invisible="approval_state != 'approved' or evidence_state == 'done'"/>
<button name="action_new_evidence_revision" type="object" string="재측정 개정" invisible="evidence_state != 'done'"/>
<field name="approval_is_current_user" invisible="1"/><field name="approval_state" widget="badge"/><field name="evidence_state" widget="statusbar"/>
</header></xpath>
<xpath expr="//sheet" position="inside"><group string="추적·조치"><field name="name"/><field name="record_date"/><field name="product_id"/><field name="lot_id"/><field name="workcenter_id"/><field name="trace_exception"/><field name="action_note"/><field name="document_ids" widget="many2many_tags"/><field name="attachment_ids" widget="many2many_binary"/></group>
<field name="approval_line_ids" readonly="approval_state in ('in_progress','approved') or evidence_state == 'done'"><list editable="bottom"><field name="sequence"/><field name="user_id"/><field name="state" readonly="1"/></list></field>
<group string="개정·완료 근거"><field name="evidence_revision"/><field name="previous_evidence_id"/><field name="completed_at"/><field name="completion_snapshot"/></group></xpath>
</field></record>
<record id="view_temperature_remeasure" model="ir.ui.view"><field name="name">mold.temperature.remeasure</field><field name="model">iatf.mold.temp.remeasure</field><field name="arch" type="xml"><form string="실제 온도 재측정"><group><field name="source_id"/><field name="temperature"/><field name="measured_at"/><field name="method"/><field name="point"/><field name="reason"/><field name="confirmed"/></group><footer><button name="action_remeasure" type="object" string="새 개정 작성" class="btn-primary"/><button string="취소" special="cancel"/></footer></form></field></record>
</odoo>
