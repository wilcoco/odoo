<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 일계표/월계표 (피벗: 계정 × 일/월, 차변·대변) — #20 1단계 -->
    <record id="view_kr_daily_sheet_pivot" model="ir.ui.view">
        <field name="name">account.move.line.kr.daily.pivot</field>
        <field name="model">account.move.line</field>
        <field name="priority">110</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="account_id" type="row"/>
                <field name="date" interval="day" type="col"/>
                <field name="debit" type="measure" string="차변"/>
                <field name="credit" type="measure" string="대변"/>
                <field name="balance" type="measure" string="잔액증감"/>
            </pivot>
        </field>
    </record>
    <record id="action_kr_daily_sheet" model="ir.actions.act_window">
        <field name="name">일계표</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="view_id" ref="view_kr_daily_sheet_pivot"/>
        <field name="domain">[('parent_state','=','posted')]</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>
    <record id="view_kr_monthly_sheet_pivot" model="ir.ui.view">
        <field name="name">account.move.line.kr.monthly.pivot</field>
        <field name="model">account.move.line</field>
        <field name="priority">111</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="account_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="debit" type="measure" string="차변"/>
                <field name="credit" type="measure" string="대변"/>
                <field name="balance" type="measure" string="잔액증감"/>
            </pivot>
        </field>
    </record>
    <record id="action_kr_monthly_sheet" model="ir.actions.act_window">
        <field name="name">월계표</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="view_id" ref="view_kr_monthly_sheet_pivot"/>
        <field name="domain">[('parent_state','=','posted')]</field>
    </record>

    <!-- 오늘 전표 (#10: 날짜 기본 오늘 + 빠른 필터) -->
    <record id="action_kr_today_moves" model="ir.actions.act_window">
        <field name="name">오늘 전표</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('date','=',context_today().strftime('%Y-%m-%d'))]</field>
    </record>

    <!-- 수금/지급 예정표 (#30) -->
    <record id="view_kr_due_list" model="ir.ui.view">
        <field name="name">account.move.kr.due.list</field>
        <field name="model">account.move</field>
        <field name="priority">120</field>
        <field name="arch" type="xml">
            <list decoration-danger="invoice_date_due and invoice_date_due &lt; current_date" create="false">
                <field name="partner_id" string="거래처"/>
                <field name="name" string="청구서 번호"/>
                <field name="invoice_date" string="청구일"/>
                <field name="invoice_date_due" string="만기일"/>
                <field name="amount_total" string="청구금액" sum="계"/>
                <field name="kr_paid_amount" string="수금/지급액" sum="계"/>
                <field name="amount_residual" string="잔액" sum="계"/>
                <field name="payment_state" string="상태"/>
                <field name="invoice_user_id" string="담당자" optional="show"/>
            </list>
        </field>
    </record>
    <record id="action_kr_receivable_due" model="ir.actions.act_window">
        <field name="name">수금 예정표</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="view_id" ref="view_kr_due_list"/>
        <field name="domain">[('move_type','=','out_invoice'),('state','=','posted'),('payment_state','in',('not_paid','partial'))]</field>
        <field name="context">{'group_by': []}</field>
    </record>
    <record id="action_kr_payable_due" model="ir.actions.act_window">
        <field name="name">지급 예정표</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="view_id" ref="view_kr_due_list"/>
        <field name="domain">[('move_type','=','in_invoice'),('state','=','posted'),('payment_state','in',('not_paid','partial'))]</field>
    </record>
</odoo>
