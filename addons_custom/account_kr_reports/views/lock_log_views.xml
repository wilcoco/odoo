<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kr_lock_log_list" model="ir.ui.view">
        <field name="name">kr.lock.log.list</field>
        <field name="model">kr.lock.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="direction == 'release'" decoration-warning="direction == 'loosen'">
                <field name="create_date" string="변경 시각"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="field_label"/>
                <field name="old_date"/>
                <field name="new_date"/>
                <field name="direction" widget="badge"
                       decoration-success="direction == 'tighten'"
                       decoration-warning="direction == 'loosen'"
                       decoration-danger="direction == 'release'"/>
            </list>
        </field>
    </record>

    <record id="action_kr_lock_log" model="ir.actions.act_window">
        <field name="name">마감 잠금 변경 이력</field>
        <field name="res_model">kr.lock.log</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">잠금 변경 이력이 없습니다</p>
            <p>마감일 잠금(회계연도/부가세 등)의 강화·완화·해제가 자동으로 기록됩니다.</p>
        </field>
    </record>
</odoo>
