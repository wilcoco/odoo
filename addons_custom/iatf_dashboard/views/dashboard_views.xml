<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iatf_dashboard_form" model="ir.ui.view">
        <field name="name">iatf.dashboard.form</field>
        <field name="model">iatf.dashboard</field>
        <field name="arch" type="xml">
            <form string="IATF Quality Dashboard" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title mb-3 d-flex align-items-center">
                        <h1 class="me-3">IATF 16949 품질 대시보드</h1>
                        <button name="action_refresh" type="object" class="btn btn-primary btn-sm" icon="fa-refresh">
                            새로고침
                        </button>
                    </div>

                    <!-- Row 1: Critical Alerts -->
                    <div class="row mb-4">
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card bg-danger text-white">
                                <div class="card-body text-center">
                                    <h5 class="card-title">미결 부적합 / 8D</h5>
                                    <h2><field name="nc_open" class="text-white"/></h2>
                                    <small>기한 초과: <field name="nc_overdue" class="text-white"/></small>
                                    <br/>
                                    <button name="action_open_nc_open" type="object" class="btn btn-sm btn-light mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card bg-warning">
                                <div class="card-body text-center">
                                    <h5 class="card-title">고객 불만</h5>
                                    <h2><field name="complaint_open"/></h2>
                                    <small>치명적: <field name="complaint_critical"/></small>
                                    <br/>
                                    <button name="action_open_complaints" type="object" class="btn btn-sm btn-dark mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card bg-danger text-white">
                                <div class="card-body text-center">
                                    <h5 class="card-title">FMEA 고위험</h5>
                                    <h2><field name="fmea_high_risk" class="text-white"/></h2>
                                    <small>미결 조치: <field name="fmea_open_actions" class="text-white"/></small>
                                    <br/>
                                    <button name="action_open_fmea_high" type="object" class="btn btn-sm btn-light mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card bg-info text-white">
                                <div class="card-body text-center">
                                    <h5 class="card-title">PPAP 진행 중</h5>
                                    <h2><field name="ppap_open" class="text-white"/></h2>
                                    <small>반려: <field name="ppap_rejected" class="text-white"/></small>
                                    <br/>
                                    <button name="action_open_ppap_open" type="object" class="btn btn-sm btn-light mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: Core Tools -->
                    <div class="row mb-4">
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h5 class="card-title">SPC 공정능력 부적합</h5>
                                    <h2 class="text-danger"><field name="spc_not_capable"/></h2>
                                    <small>관리 이탈: <field name="spc_ooc"/></small>
                                    <br/>
                                    <button name="action_open_spc_not_capable" type="object" class="btn btn-sm btn-outline-danger mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h5 class="card-title">MSA 불합격</h5>
                                    <h2 class="text-danger"><field name="msa_unacceptable"/></h2>
                                    <br/>
                                    <button name="action_open_msa_unacceptable" type="object" class="btn btn-sm btn-outline-danger mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h5 class="card-title">교정 기한 초과</h5>
                                    <h2 class="text-warning"><field name="cal_overdue"/></h2>
                                    <br/>
                                    <button name="action_open_cal_overdue" type="object" class="btn btn-sm btn-outline-warning mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h5 class="card-title">역량 차이</h5>
                                    <h2 class="text-warning"><field name="training_gaps"/></h2>
                                    <br/>
                                    <button name="action_open_training_gaps" type="object" class="btn btn-sm btn-outline-warning mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 3: Support -->
                    <div class="row mb-4">
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h5 class="card-title">미결 심사 지적사항</h5>
                                    <h2><field name="audit_open_findings"/></h2>
                                    <small>계획된 심사: <field name="audit_planned"/></small>
                                    <br/>
                                    <button name="action_open_audit_findings" type="object" class="btn btn-sm btn-outline-primary mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h5 class="card-title">미결 SCAR</h5>
                                    <h2><field name="scar_open"/></h2>
                                    <small>협력업체 D등급: <field name="supplier_grade_d"/></small>
                                    <br/>
                                    <button name="action_open_scar_open" type="object" class="btn btn-sm btn-outline-primary mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h5 class="card-title">리스크 치명/높음</h5>
                                    <h2 class="text-danger"><field name="risk_critical"/></h2>
                                    <small>높음: <field name="risk_high"/></small>
                                    <br/>
                                    <button name="action_open_risk_critical" type="object" class="btn btn-sm btn-outline-danger mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h5 class="card-title">APQP 진행 프로젝트</h5>
                                    <h2 class="text-success"><field name="apqp_active"/></h2>
                                    <small>문서: <field name="doc_total"/> (승인 대기: <field name="doc_pending_approval"/>)</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 4: Inspection & New Modules -->
                    <div class="row mb-4">
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <h5 class="card-title">수입검사 (IQC)</h5>
                                    <h2><field name="iqc_open" class="text-white"/></h2>
                                    <small>불합격: <field name="iqc_fail" class="text-white"/></small>
                                    <br/>
                                    <button name="action_open_iqc_open" type="object" class="btn btn-sm btn-light mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card bg-primary text-white">
                                <div class="card-body text-center">
                                    <h5 class="card-title">공정/출하검사</h5>
                                    <h2><field name="pqc_open" class="text-white"/></h2>
                                    <small>불합격: <field name="pqc_fail" class="text-white"/></small>
                                    <br/>
                                    <button name="action_open_pqc_open" type="object" class="btn btn-sm btn-light mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card bg-success text-white">
                                <div class="card-body text-center">
                                    <h5 class="card-title">품질 목표</h5>
                                    <h2><field name="qo_active" class="text-white"/></h2>
                                    <small>미달/위험: <field name="qo_behind" class="text-white"/></small>
                                    <br/>
                                    <button name="action_open_qo_behind" type="object" class="btn btn-sm btn-light mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card bg-warning">
                                <div class="card-body text-center">
                                    <h5 class="card-title">변경 관리</h5>
                                    <h2><field name="cr_open"/></h2>
                                    <small>고위험: <field name="cr_high_risk"/></small>
                                    <br/>
                                    <button name="action_open_cr_open" type="object" class="btn btn-sm btn-dark mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 5: CSR, Layout, YTD -->
                    <div class="row">
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h5 class="card-title">고객 특수요구사항</h5>
                                    <h2><field name="csr_active"/></h2>
                                    <small class="text-danger">부적합: <field name="csr_non_compliant"/></small>
                                    <br/>
                                    <button name="action_open_csr_noncompliant" type="object" class="btn btn-sm btn-outline-danger mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h5 class="card-title">레이아웃 검사</h5>
                                    <h2><field name="li_open"/></h2>
                                    <small class="text-danger">불합격: <field name="li_fail"/></small>
                                    <br/>
                                    <button name="action_open_li_open" type="object" class="btn btn-sm btn-outline-primary mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card border-secondary">
                                <div class="card-body text-center">
                                    <h5 class="card-title">부적합 합계 (연간)</h5>
                                    <h2><field name="nc_total_ytd"/></h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card border-secondary">
                                <div class="card-body text-center">
                                    <h5 class="card-title">불만 비용 (연간)</h5>
                                    <h2><field name="complaint_cost_ytd" widget="monetary"/></h2>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 6: Equipment, Mold, Customer Property, Outsource -->
                    <div class="row mb-4">
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card bg-dark text-white">
                                <div class="card-body text-center">
                                    <h5 class="card-title">설비 / TPM</h5>
                                    <h2><field name="eq_active" class="text-white"/></h2>
                                    <small>고장: <field name="eq_breakdown" class="text-white"/> | PM초과: <field name="eq_pm_overdue" class="text-white"/></small>
                                    <br/>
                                    <button name="action_open_eq_breakdown" type="object" class="btn btn-sm btn-light mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card bg-dark text-white">
                                <div class="card-body text-center">
                                    <h5 class="card-title">금형 / 치공구</h5>
                                    <h2><field name="mold_active" class="text-white"/></h2>
                                    <small>수명 경고 (≥80%): <field name="mold_life_warning" class="text-white"/></small>
                                    <br/>
                                    <button name="action_open_mold_warning" type="object" class="btn btn-sm btn-light mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h5 class="card-title">고객재산</h5>
                                    <h2><field name="cp_active"/></h2>
                                    <small class="text-danger">손상/분실: <field name="cp_issue"/></small>
                                    <br/>
                                    <button name="action_open_cp_issue" type="object" class="btn btn-sm btn-outline-danger mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body text-center">
                                    <h5 class="card-title">외주공정</h5>
                                    <h2><field name="os_open"/></h2>
                                    <small class="text-danger">불합격: <field name="os_fail"/></small>
                                    <br/>
                                    <button name="action_open_os_open" type="object" class="btn btn-sm btn-outline-primary mt-2">보기</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_iatf_dashboard" model="ir.actions.act_window">
        <field name="name">IATF 품질 대시보드</field>
        <field name="res_model">iatf.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'create': True}</field>
    </record>
</odoo>
