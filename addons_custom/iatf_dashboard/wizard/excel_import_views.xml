<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iatf_excel_import_form" model="ir.ui.view">
        <field name="name">iatf.excel.import.form</field>
        <field name="model">iatf.excel.import</field>
        <field name="arch" type="xml">
            <form string="Excel Data Import">
                <group>
                    <group string="Import Settings">
                        <field name="import_type"/>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group string="Target (if applicable)">
                        <field name="fmea_id" invisible="import_type != 'fmea'"/>
                        <field name="control_plan_id" invisible="import_type != 'control_plan'"/>
                    </group>
                </group>
                <group invisible="not result_message">
                    <field name="result_message" readonly="1"/>
                </group>
                <separator string="Expected Column Format"/>
                <div class="alert alert-info" role="alert">
                    <p invisible="import_type != 'fmea'">
                        <strong>FMEA:</strong> Process Step | Failure Mode | Effect | Cause | Prevention Controls | Detection Controls | S | O | D | Recommended Action | Special Char (CC/SC/HI)
                    </p>
                    <p invisible="import_type != 'control_plan'">
                        <strong>Control Plan:</strong> Step # | Process Name | Machine/Tool | Char # | Characteristic | Specification | Eval Method | Sample Size | Frequency | Control Method | Reaction Plan
                    </p>
                    <p invisible="import_type != 'risk'">
                        <strong>Risk:</strong> Title | Type (risk/opportunity) | Category | Description | Likelihood (1-5) | Impact (1-5) | Strategy | Current Controls | Planned Actions
                    </p>
                    <p invisible="import_type != 'equipment'">
                        <strong>Equipment:</strong> Name | ID # | Type | Manufacturer | Serial # | Location | Cal Frequency (days)
                    </p>
                    <p invisible="import_type != 'competence'">
                        <strong>Competence:</strong> Employee Name | Skill Name | Category | Required Level (0-4) | Current Level (0-4)
                    </p>
                    <p invisible="import_type != 'nc'">
                        <strong>NC:</strong> Title | Type (internal/supplier/customer/audit) | Severity (critical/major/minor) | Problem Description
                    </p>
                    <p><em>Row 1 = header (skipped). Data starts from row 2.</em></p>
                </div>
                <footer>
                    <button name="action_import" string="Import" type="object" class="oe_highlight"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_iatf_excel_import" model="ir.actions.act_window">
        <field name="name">Excel Data Import</field>
        <field name="res_model">iatf.excel.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
