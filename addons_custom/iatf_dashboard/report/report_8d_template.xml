<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_8d_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 11px;">
                        <h2 class="text-center mb-4">8D Problem Solving Report</h2>

                        <!-- Header -->
                        <table class="table table-bordered table-sm">
                            <tr>
                                <td class="fw-bold" style="width:25%">Report #</td>
                                <td style="width:25%"><t t-esc="o.name"/></td>
                                <td class="fw-bold" style="width:25%">Date</td>
                                <td style="width:25%"><t t-esc="o.create_date" t-options='{"widget": "date"}'/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Title</td>
                                <td colspan="3"><t t-esc="o.title"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Type</td>
                                <td><t t-esc="dict(o._fields['nc_type'].selection).get(o.nc_type, '')"/></td>
                                <td class="fw-bold">Severity</td>
                                <td><t t-esc="dict(o._fields['severity'].selection).get(o.severity, '')"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Product</td>
                                <td><t t-esc="o.product_id.display_name or '-'"/></td>
                                <td class="fw-bold">Lot/Serial</td>
                                <td><t t-esc="o.lot_id.name or '-'"/></td>
                            </tr>
                            <tr>
                                <td class="fw-bold">Responsible</td>
                                <td><t t-esc="o.responsible_id.name or '-'"/></td>
                                <td class="fw-bold">Status</td>
                                <td><t t-esc="dict(o._fields['state'].selection).get(o.state, '')"/></td>
                            </tr>
                        </table>

                        <!-- D1: Team -->
                        <h4 class="mt-3 bg-light p-2">D1 — Team</h4>
                        <p><t t-esc="o.team_member_ids.mapped('name') and ', '.join(o.team_member_ids.mapped('name')) or 'Not assigned'"/></p>

                        <!-- D2: Problem Description -->
                        <h4 class="mt-3 bg-light p-2">D2 — Problem Description</h4>
                        <div><t t-raw="o.problem_description or '-'"/></div>

                        <!-- D3: Containment -->
                        <h4 class="mt-3 bg-light p-2">D3 — Interim Containment Action</h4>
                        <div><t t-raw="o.containment_action or '-'"/></div>

                        <!-- D4: Root Cause -->
                        <h4 class="mt-3 bg-light p-2">D4 — Root Cause Analysis</h4>
                        <div><t t-raw="o.root_cause or '-'"/></div>

                        <!-- D5: Corrective Actions -->
                        <h4 class="mt-3 bg-light p-2">D5 — Permanent Corrective Actions</h4>
                        <t t-if="o.corrective_action_ids">
                            <table class="table table-bordered table-sm">
                                <thead><tr>
                                    <th>#</th><th>Description</th><th>Type</th>
                                    <th>Responsible</th><th>Due Date</th><th>Status</th>
                                </tr></thead>
                                <tbody>
                                    <t t-foreach="o.corrective_action_ids" t-as="ca">
                                        <tr>
                                            <td><t t-esc="ca.name"/></td>
                                            <td><t t-esc="ca.description or ''"/></td>
                                            <td><t t-esc="dict(ca._fields['ca_type'].selection).get(ca.ca_type, '')"/></td>
                                            <td><t t-esc="ca.responsible_id.name or '-'"/></td>
                                            <td><t t-esc="ca.due_date" t-options='{"widget": "date"}'/></td>
                                            <td><t t-esc="dict(ca._fields['state'].selection).get(ca.state, '')"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else=""><p>No corrective actions defined.</p></t>

                        <!-- D6: Verification -->
                        <h4 class="mt-3 bg-light p-2">D6 — Verification of Effectiveness</h4>
                        <div><t t-raw="o.verification_result or '-'"/></div>

                        <!-- D7: Preventive Action -->
                        <h4 class="mt-3 bg-light p-2">D7 — Preventive Action / Systemic Changes</h4>
                        <div><t t-raw="o.preventive_action or '-'"/></div>

                        <!-- D8: Closure -->
                        <h4 class="mt-3 bg-light p-2">D8 — Team Recognition &amp; Closure</h4>
                        <table class="table table-bordered table-sm">
                            <tr>
                                <td class="fw-bold">Target Close Date</td>
                                <td><t t-esc="o.target_close_date" t-options='{"widget": "date"}'/></td>
                                <td class="fw-bold">Actual Close Date</td>
                                <td><t t-esc="o.actual_close_date" t-options='{"widget": "date"}'/></td>
                            </tr>
                        </table>
                        <div><t t-raw="o.notes or ''"/></div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
