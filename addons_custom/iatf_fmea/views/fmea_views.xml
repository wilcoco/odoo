<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iatf_fmea_search" model="ir.ui.view">
        <field name="name">iatf.fmea.search</field>
        <field name="model">iatf.fmea</field>
        <field name="arch" type="xml">
            <search string="FMEA">
                <field name="name"/>
                <field name="title"/>
                <field name="product_id"/>
                <field name="responsible_id"/>
                <separator/>
                <filter name="pfmea" string="PFMEA" domain="[('fmea_type','=','pfmea')]"/>
                <filter name="dfmea" string="DFMEA" domain="[('fmea_type','=','dfmea')]"/>
                <filter name="has_high_risk" string="Has High Risk" domain="[('high_risk_count','>',0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Type" context="{'group_by': 'fmea_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_iatf_fmea_tree" model="ir.ui.view">
        <field name="name">iatf.fmea.tree</field>
        <field name="model">iatf.fmea</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="title"/>
                <field name="fmea_type" widget="badge"/>
                <field name="product_id" optional="show"/>
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="revision"/>
                <field name="line_count" string="Items"/>
                <field name="max_rpn" decoration-danger="max_rpn >= 200" decoration-warning="max_rpn >= 100"/>
                <field name="high_risk_count" decoration-danger="high_risk_count > 0"/>
                <field name="open_action_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-info="state == 'in_progress'"
                       decoration-warning="state == 'review'"/>
            </list>
        </field>
    </record>

    <record id="view_iatf_fmea_form" model="ir.ui.view">
        <field name="name">iatf.fmea.form</field>
        <field name="model">iatf.fmea</field>
        <field name="arch" type="xml">
            <form string="FMEA">
                <header>
                    <button name="action_start" string="Start" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_submit_review" string="Submit for Review" type="object" class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="state != 'review'"
                            groups="iatf_fmea.group_fmea_manager"/>
                    <button name="action_reset_draft" string="Reset" type="object"
                            invisible="state in ('draft',)"
                            groups="iatf_fmea.group_fmea_manager"/>
                    <button name="action_submit_approval" string="결재 상신" type="object" class="btn-primary"
                            invisible="approval_state not in (False, 'draft', 'rejected')"/>
                    <button name="action_approve_approval" string="승인" type="object" class="btn-success"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <button name="action_reject_approval" string="반려" type="object"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <field name="approval_is_current_user" invisible="1"/>
                    <field name="approval_state" widget="badge"
                           decoration-success="approval_state == 'approved'"
                           decoration-danger="approval_state == 'rejected'"
                           decoration-info="approval_state == 'in_progress'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,review,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="title" placeholder="FMEA Title"/></h2>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="fmea_type"/>
                            <field name="product_id"/>
                            <field name="part_number"/>
                            <field name="process_name"/>
                            <field name="customer_id"/>
                            <field name="model_year"/>
                        </group>
                        <group string="Ownership &amp; Revision">
                            <field name="responsible_id"/>
                            <field name="team_member_ids" widget="many2many_tags"/>
                            <field name="revision"/>
                            <field name="revision_date"/>
                            <field name="apqp_project_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Risk Summary">
                            <field name="max_rpn"/>
                            <field name="high_risk_count"/>
                            <field name="open_action_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="FMEA Worksheet" name="worksheet">
                            <field name="line_ids">
                                <list editable="bottom"
                                      decoration-danger="action_priority == 'high'"
                                      decoration-warning="action_priority == 'medium'">
                                    <field name="process_step"/>
                                    <field name="failure_mode"/>
                                    <field name="failure_effect"/>
                                    <field name="failure_cause"/>
                                    <field name="special_characteristic" widget="badge"
                                           decoration-danger="special_characteristic == 'cc'"
                                           decoration-warning="special_characteristic == 'sc'"/>
                                    <field name="current_prevention"/>
                                    <field name="current_detection"/>
                                    <field name="severity"/>
                                    <field name="occurrence"/>
                                    <field name="detection"/>
                                    <field name="rpn" decoration-danger="rpn >= 200" decoration-warning="rpn >= 100"/>
                                    <field name="action_priority" widget="badge"
                                           decoration-danger="action_priority == 'high'"
                                           decoration-warning="action_priority == 'medium'"/>
                                    <field name="recommended_action"/>
                                    <field name="action_responsible_id"/>
                                    <field name="action_due_date"/>
                                    <field name="action_status" widget="badge"
                                           decoration-success="action_status == 'verified'"
                                           decoration-info="action_status == 'in_progress'"/>
                                    <field name="severity_after" optional="hide"/>
                                    <field name="occurrence_after" optional="hide"/>
                                    <field name="detection_after" optional="hide"/>
                                    <field name="rpn_after" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="document_ids" widget="many2many_tags"/>
                        </page>
                        <page string="결재선" name="approval">
                            <field name="approval_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_iatf_fmea" model="ir.actions.act_window">
        <field name="name">FMEA</field>
        <field name="res_model">iatf.fmea</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_iatf_fmea_search"/>
    </record>
</odoo>
