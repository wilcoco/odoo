<odoo>
  <record id="policy_company_rule" model="ir.rule"><field name="name">운영 정책 회사</field><field name="model_id" ref="model_cams_ops_policy"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="policy_list" model="ir.ui.view"><field name="name">cams.ops.policy.list</field><field name="model">cams.ops.policy</field><field name="arch" type="xml"><list delete="false"><field name="company_id"/><field name="change_reason"/><field name="write_date"/></list></field></record>
  <record id="policy_form" model="ir.ui.view"><field name="name">cams.ops.policy.form</field><field name="model">cams.ops.policy</field><field name="arch" type="xml"><form delete="false"><sheet><group><field name="company_id"/><field name="change_reason"/></group><group string="BOM·4M"><field name="bom_reactivate_old"/><field name="bom_delete_active"/><field name="bom_log_immutable"/><field name="cr_self_review_block"/><field name="cr_sequence_enforce"/></group><group string="생산·자재"><field name="mo_close_requires_good"/><field name="planning_mo_qty_lock"/><field name="silo_reorder_po_state"/><field name="silo_setting_editor"/><field name="scrap_requires_approval"/></group><group string="인사·외부 접속"><field name="leave_hr_skip_manager"/><field name="portal_token_mode"/><field name="statement_link_days"/></group></sheet><chatter/></form></field></record>
  <record id="action_policy" model="ir.actions.act_window"><field name="name">운영 정책</field><field name="res_model">cams.ops.policy</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_policy" name="운영 정책" parent="base.menu_administration" action="action_policy" groups="base.group_system" sequence="50"/>
</odoo>
