<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_shipping_inspection_list" model="ir.ui.view">
        <field name="name">iatf.shipping.inspection.list</field>
        <field name="model">iatf.shipping.inspection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="shipping_date"/>
                <field name="product_id"/>
                <field name="partner_id"/>
                <field name="destination"/>
                <field name="quantity"/>
                <field name="result"/>
                <field name="inspector_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_shipping_inspection_form" model="ir.ui.view">
        <field name="name">iatf.shipping.inspection.form</field>
        <field name="model">iatf.shipping.inspection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_inspection" string="검사 시작" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_decide" string="판정 완료" type="object"
                            class="btn-primary" invisible="state != 'inspecting'"/>
                    <button name="action_close" string="종료" type="object"
                            class="btn-success" invisible="state != 'decided'"/>
                    <button name="action_create_nc" string="부적합 생성" type="object"
                            class="btn-warning" invisible="result != 'fail'"/>
                    <button name="action_cancel" string="취소" type="object"
                            invisible="state in ('closed', 'cancelled')"/>
                    <button name="action_submit_approval" string="결재 상신" type="object"
                            class="btn-primary" invisible="approval_state not in (False, 'draft', 'rejected')"/>
                    <button name="action_approve_approval" string="승인" type="object"
                            class="btn-success"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <button name="action_reject_approval" string="반려" type="object"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <field name="approval_is_current_user" invisible="1"/>
                    <field name="approval_state" widget="badge"
                           decoration-success="approval_state == 'approved'"
                           decoration-danger="approval_state == 'rejected'"
                           decoration-info="approval_state == 'in_progress'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,inspecting,decided,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="shipping_date"/>
                            <field name="product_id"/>
                            <field name="part_number"/>
                            <field name="lot_id"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="destination"/>
                            <field name="picking_id"/>
                            <field name="inspector_id"/>
                            <field name="approved_by"/>
                        </group>
                    </group>
                    <group string="판정">
                        <group>
                            <field name="visual_result"/>
                            <field name="dimension_result"/>
                            <field name="packaging_result"/>
                            <field name="label_result"/>
                        </group>
                        <group>
                            <field name="result"/>
                            <field name="nonconformity_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="결재선">
                            <field name="approval_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="기타">
                            <group>
                                <field name="notes"/>
                            </group>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shipping_inspection" model="ir.actions.act_window">
        <field name="name">출하검사</field>
        <field name="res_model">iatf.shipping.inspection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
