<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_iatf_nonconformity" model="ir.sequence">
            <field name="name">IATF Nonconformity</field>
            <field name="code">iatf.nonconformity</field>
            <field name="prefix">NC-%(year)s-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_iatf_corrective_action" model="ir.sequence">
            <field name="name">IATF Corrective Action</field>
            <field name="code">iatf.corrective.action</field>
            <field name="prefix">CA-%(year)s-</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
