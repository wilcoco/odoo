<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_incoming_inspection_list" model="ir.ui.view">
        <field name="name">iatf.incoming.inspection.list</field>
        <field name="model">iatf.incoming.inspection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="inspection_date"/>
                <field name="supplier_id"/>
                <field name="product_id"/>
                <field name="quantity_received"/>
                <field name="quantity_inspected"/>
                <field name="inspection_type"/>
                <field name="result"/>
                <field name="disposition"/>
                <field name="inspector_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_incoming_inspection_form" model="ir.ui.view">
        <field name="name">iatf.incoming.inspection.form</field>
        <field name="model">iatf.incoming.inspection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_inspection" string="검사 시작" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_decide" string="판정 완료" type="object"
                            class="btn-primary" invisible="state != 'inspecting'"/>
                    <button name="action_close" string="종료" type="object"
                            class="btn-success" invisible="state != 'decided'"/>
                    <button name="action_create_nc" string="부적합 생성" type="object"
                            class="btn-warning" invisible="result != 'fail'"/>
                    <button name="action_cancel" string="취소" type="object"
                            invisible="state in ('closed', 'cancelled')"/>
                    <button name="action_submit_approval" string="결재 상신" type="object"
                            class="btn-primary" invisible="approval_state not in (False, 'draft', 'rejected')"/>
                    <button name="action_approve_approval" string="승인" type="object"
                            class="btn-success"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <button name="action_reject_approval" string="반려" type="object"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <field name="approval_is_current_user" invisible="1"/>
                    <field name="approval_state" widget="badge"
                           decoration-success="approval_state == 'approved'"
                           decoration-danger="approval_state == 'rejected'"
                           decoration-info="approval_state == 'in_progress'"/>
                    <field name="state" widget="statusbar"
                           readonly="1"
                           statusbar_visible="draft,inspecting,decided,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="inspection_date"/>
                            <field name="supplier_id"/>
                            <field name="supplier_cert_no"/>
                            <field name="product_id"/>
                            <field name="part_number"/>
                            <field name="lot_id"/>
                        </group>
                        <group>
                            <field name="picking_id"/>
                            <field name="source_move_id"/>
                            <field name="purchase_id"/>
                            <field name="inspector_id"/>
                            <field name="approved_by"/>
                        </group>
                    </group>
                    <group>
                        <group string="수량">
                            <field name="quantity_received"/>
                            <field name="product_uom_id"/>
                            <field name="quantity_inspected"/>
                            <field name="quantity_accepted"/>
                            <field name="quantity_rejected"/>
                        </group>
                        <group string="검사 기준">
                            <field name="inspection_type"/>
                            <field name="sampling_plan"/>
                            <field name="sample_size"/>
                            <field name="accept_number"/>
                            <field name="reject_number"/>
                        </group>
                    </group>
                    <group string="판정">
                        <group string="항목별 판정">
                            <field name="visual_result"/>
                            <field name="dimension_result"/>
                            <field name="material_result"/>
                            <field name="defect_rate"/>
                        </group>
                        <group string="종합 판정">
                            <field name="result"/>
                            <field name="disposition"/>
                            <field name="nonconformity_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="보류 해제·처분">
                            <group>
                                <group>
                                    <field name="hold_version"/>
                                    <field name="release_reviewer_id"/>
                                    <field name="release_approver_id"/>
                                    <field name="release_executor_id"/>
                                    <field name="release_reason"/>
                                    <field name="release_requested"/>
                                </group>
                                <group>
                                    <field name="released_version"/>
                                    <field name="released_by"/>
                                    <field name="released_at"/>
                                    <field name="disposal_move_id"/>
                                </group>
                            </group>
                            <p>정상 입고의 전량 합격은 자동 해제합니다. 수동 보류·조건부 합격은 품질 검토와 생산 승인 후 지정 담당자가 해제합니다. 같은 LOT의 미판정·불합격 수량이 남으면 전체 해제할 수 없습니다.</p>
                            <button name="action_request_release" type="object" string="예외 해제 상신" class="btn-primary" invisible="state not in ('decided', 'closed')"/>
                            <button name="action_release_hold" type="object" string="승인 근거로 LOT 해제" groups="iatf_incoming_inspection.group_quality_release_executor" invisible="not release_requested or approval_state != 'approved'"/>
                            <button name="action_process_disposition" type="object" string="불합격 수량 반품·폐기" confirm="이 입고 LOT의 불합격 수량만 실제 반품 또는 폐기 이동합니다. 계속하시겠습니까?" invisible="state not in ('decided', 'closed') or disposition not in ('return', 'scrap') or disposal_move_id"/>
                        </page>
                        <page string="검사 항목">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="characteristic_name"/>
                                    <field name="characteristic_type"/>
                                    <field name="specification"/>
                                    <field name="measurement_method"/>
                                    <field name="measured_value"/>
                                    <field name="result"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="결재선">
                            <field name="approval_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="기타">
                            <group>
                                <field name="document_ids" widget="many2many_tags"/>
                                <field name="notes"/>
                            </group>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_incoming_inspection" model="ir.actions.act_window">
        <field name="name">수입검사</field>
        <field name="res_model">iatf.incoming.inspection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
