<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inspection_criteria_list" model="ir.ui.view">
        <field name="name">iatf.inspection.criteria.list</field>
        <field name="model">iatf.inspection.criteria</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="product_id"/>
                <field name="supplier_id"/>
                <field name="characteristic_name"/>
                <field name="characteristic_type"/>
                <field name="specification"/>
                <field name="measurement_method"/>
                <field name="sampling_plan"/>
                <field name="is_critical"/>
            </list>
        </field>
    </record>

    <record id="action_inspection_criteria" model="ir.actions.act_window">
        <field name="name">검사 기준서</field>
        <field name="res_model">iatf.inspection.criteria</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
