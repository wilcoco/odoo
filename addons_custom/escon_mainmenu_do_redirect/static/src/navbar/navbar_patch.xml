<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- 데스크톱: 앱 드롭다운 → 홈 화면 이동 버튼으로 교체 -->
    <t t-name="escon_mainmenu.NavBar.AppsMenu" t-inherit="web.NavBar.AppsMenu" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_navbar_apps_menu')]/Dropdown" position="replace">
            <button data-hotkey="h" title="홈" t-on-click="() => this.onEsconHomeClick()">
                <i class="oi oi-apps"/>
            </button>
        </xpath>
    </t>

</templates>
