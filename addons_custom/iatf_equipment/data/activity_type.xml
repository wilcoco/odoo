             한다. 제목(summary) 문자열로 찾으면 사용자가 제목을 고치는 순간
             중복 생성이 시작된다. -->
        <record id="mail_activity_spare_shortage" model="mail.activity.type">
            <field name="name">예비부품 부족</field>
            <field name="icon">fa-exclamation-triangle</field>
            <field name="res_model">iatf.equipment.spare</field>
            <field name="delay_count">0</field>
            <field name="sequence">20</field>
        </record>
    </data>
</odoo>
