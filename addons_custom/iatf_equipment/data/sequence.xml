<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_equipment" model="ir.sequence">
            <field name="name">설비</field>
            <field name="code">iatf.equipment</field>
            <field name="prefix">EQ-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_pm_schedule" model="ir.sequence">
            <field name="name">예방보전</field>
            <field name="code">iatf.pm.schedule</field>
            <field name="prefix">PM-%(year)s-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_breakdown" model="ir.sequence">
            <field name="name">설비고장</field>
            <field name="code">iatf.equipment.breakdown</field>
            <field name="prefix">BD-%(year)s-</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_daily_check" model="ir.sequence">
            <field name="name">일상점검</field>
            <field name="code">iatf.daily.check</field>
            <field name="prefix">DC-%(year)s-</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
