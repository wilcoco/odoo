<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_pm_overdue_alert" model="ir.cron">
            <field name="name">IATF: 설비 PM 기한 알림</field>
            <field name="model_id" ref="model_iatf_equipment"/>
            <field name="state">code</field>
            <field name="code">model._cron_pm_overdue_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>

            <field name="active">True</field>
        </record>

        <record id="cron_spare_shortage_alert" model="ir.cron">
            <field name="name">IATF: 예비부품 부족 알림</field>
            <field name="model_id" ref="model_iatf_equipment_spare"/>
            <field name="state">code</field>
            <field name="code">model._cron_shortage_alert()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
