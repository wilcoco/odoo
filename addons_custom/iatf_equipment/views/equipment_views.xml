<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_list" model="ir.ui.view">
        <field name="name">iatf.equipment.list</field>
        <field name="model">iatf.equipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="complete_name" string="설비/장치"/>
                <field name="node_type" widget="badge"/>
                <field name="parent_id" optional="hide"/>
                <field name="equipment_type"/>
                <field name="manufacturer"/>
                <field name="workcenter_id"/>
                <field name="location"/>
                <field name="next_pm_date"/>
                <field name="is_pm_overdue"/>
                <field name="breakdown_count"/>
                <field name="availability_rate"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_search" model="ir.ui.view">
        <field name="name">iatf.equipment.search</field>
        <field name="model">iatf.equipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="complete_name" string="설비/장치"
                       filter_domain="['|', '|', ('complete_name', 'ilike', self), ('code', 'ilike', self), ('serial_number', 'ilike', self)]"/>
                <field name="parent_id" string="상위 설비 이하"
                       filter_domain="[('parent_id', 'child_of', raw_value)]"/>
                <field name="workcenter_id"/>
                <field name="responsible_id"/>
                <separator/>
                <filter name="filter_no_device" string="설비 (장치 제외)"
                        domain="[('node_type', '!=', 'device')]"/>
                <filter name="filter_device" string="장치만"
                        domain="[('node_type', '=', 'device')]"/>
                <filter name="filter_top_level" string="최상위만"
                        domain="[('parent_id', '=', False)]"/>
                <separator/>
                <filter name="filter_active_state" string="가동 중" domain="[('state', '=', 'active')]"/>
                <filter name="filter_breakdown" string="고장" domain="[('state', '=', 'breakdown')]"/>
                <filter name="filter_pm_overdue" string="PM 기한 초과" domain="[('is_pm_overdue', '=', True)]"/>
                <group expand="0" string="그룹">
                    <filter name="group_parent" string="상위 설비" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_node_type" string="계층 구분" context="{'group_by': 'node_type'}"/>
                    <filter name="group_equipment_type" string="설비 유형" context="{'group_by': 'equipment_type'}"/>
                    <filter name="group_workcenter" string="작업장" context="{'group_by': 'workcenter_id'}"/>
                    <filter name="group_state" string="상태" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_equipment_form" model="ir.ui.view">
        <field name="name">iatf.equipment.form</field>
        <field name="model">iatf.equipment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="가동" type="object" class="btn-success" invisible="state in ('active', 'disposed')"/>
                    <button name="action_maintenance" string="보전" type="object" class="btn-warning" invisible="state != 'active'"/>
                    <button name="action_breakdown" string="고장" type="object" class="btn-danger" invisible="state != 'active'"/>
                    <button name="action_inactive" string="비가동" type="object" invisible="state in ('disposed', 'draft')"/>
                    <button name="action_dispose" string="폐기" type="object" invisible="state == 'disposed'"/>
                    <button name="action_submit_approval" string="결재 상신" type="object" class="btn-primary"
                            invisible="approval_state not in (False, 'draft', 'rejected')"/>
                    <button name="action_approve_approval" string="승인" type="object" class="btn-success"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <button name="action_reject_approval" string="반려" type="object"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <field name="approval_is_current_user" invisible="1"/>
                    <field name="approval_state" widget="badge"
                           decoration-success="approval_state == 'approved'"
                           decoration-danger="approval_state == 'rejected'"
                           decoration-info="approval_state == 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_children" type="object"
                                class="oe_stat_button" icon="fa-sitemap"
                                invisible="child_count == 0">
                            <field name="child_count" widget="statinfo" string="하위 장치"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="code" readonly="1"/> - <field name="name" placeholder="설비명"/></h1>
                        <div class="text-muted" invisible="not parent_id">
                            <field name="complete_name" readonly="1" nolabel="1"/>
                        </div>
                    </div>
                    <group>
                        <group string="기본 정보">
                            <field name="node_type"/>
                            <field name="parent_id"
                                   domain="[('id', '!=', id)]"
                                   options="{'no_create_edit': True}"/>
                            <field name="root_equipment_id" readonly="1"
                                   invisible="node_type != 'device'"/>
                            <field name="equipment_type"/>
                            <field name="manufacturer"/>
                            <field name="model_name"/>
                            <field name="serial_number"/>
                            <field name="manufacture_year"/>
                            <field name="capacity"/>
                        </group>
                        <group string="위치/담당">
                            <field name="workcenter_id"/>
                            <field name="location"/>
                            <field name="department_id"/>
                            <field name="responsible_id"/>
                            <field name="purchase_date"/>
                            <field name="install_date"/>
                        </group>
                    </group>
                    <group string="TPM / 보전 현황">
                        <group>
                            <field name="pm_cycle_days"/>
                            <field name="last_pm_date"/>
                            <field name="next_pm_date"/>
                            <field name="is_pm_overdue"/>
                        </group>
                        <group>
                            <field name="runtime_source"/>
                            <field name="total_runtime_hours"
                                   invisible="runtime_source == 'workcenter'"/>
                            <field name="runtime_hours_wc"
                                   invisible="runtime_source != 'workcenter'"/>
                            <field name="breakdown_count"/>
                            <field name="total_downtime_hours"/>
                            <field name="mttr"/>
                            <field name="mtbf"
                                   invisible="runtime_source == 'none' or breakdown_count == 0"/>
                            <field name="availability_rate"
                                   invisible="runtime_source == 'none'"/>
                            <div class="text-muted" colspan="2" invisible="runtime_source != 'none'">
                                가동시간 실적이 없어 MTBF·가동률을 산출하지 않습니다.
                                작업장을 연결하거나 수기 가동시간을 입력하십시오.
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="사양">
                            <field name="specification"/>
                        </page>
                        <page string="하위 장치">
                            <field name="child_ids" context="{'default_node_type': 'device'}">
                                <list editable="bottom">
                                    <field name="code" readonly="1"/>
                                    <field name="name"/>
                                    <field name="node_type"/>
                                    <field name="equipment_type"/>
                                    <field name="manufacturer" optional="hide"/>
                                    <field name="serial_number" optional="hide"/>
                                    <field name="next_pm_date"/>
                                    <field name="breakdown_count"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="PM 계획/실적">
                            <field name="pm_schedule_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="pm_type"/>
                                    <field name="planned_date"/>
                                    <field name="actual_date"/>
                                    <field name="responsible_id"/>
                                    <field name="result"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="고장 이력">
                            <field name="breakdown_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="occurrence_date"/>
                                    <field name="breakdown_type"/>
                                    <field name="severity"/>
                                    <field name="downtime_hours"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="일상점검">
                            <field name="daily_check_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="check_date"/>
                                    <field name="shift"/>
                                    <field name="checker_id"/>
                                    <field name="overall_result" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="예비부품">
                            <field name="spare_part_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="part_number"/>
                                    <field name="quantity_required"/>
                                    <field name="quantity_on_hand"/>
                                    <field name="supplier"/>
                                    <field name="lead_time_days"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="결재선">
                            <field name="approval_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="문서/첨부">
                            <group>
                                <field name="document_ids" widget="many2many_tags"/>
                                <field name="notes"/>
                            </group>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_equipment" model="ir.actions.act_window">
        <field name="name">설비 대장</field>
        <field name="res_model">iatf.equipment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_equipment_search"/>
        <field name="context">{'search_default_filter_no_device': 1}</field>
    </record>
</odoo>
