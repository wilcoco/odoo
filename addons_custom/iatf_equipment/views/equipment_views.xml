<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_equipment_list" model="ir.ui.view">
        <field name="name">iatf.equipment.list</field>
        <field name="model">iatf.equipment</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="equipment_type"/>
                <field name="manufacturer"/>
                <field name="workcenter_id"/>
                <field name="location"/>
                <field name="next_pm_date"/>
                <field name="is_pm_overdue"/>
                <field name="breakdown_count"/>
                <field name="availability_rate"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_form" model="ir.ui.view">
        <field name="name">iatf.equipment.form</field>
        <field name="model">iatf.equipment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="가동" type="object" class="btn-success" invisible="state in ('active', 'disposed')"/>
                    <button name="action_maintenance" string="보전" type="object" class="btn-warning" invisible="state != 'active'"/>
                    <button name="action_breakdown" string="고장" type="object" class="btn-danger" invisible="state != 'active'"/>
                    <button name="action_inactive" string="비가동" type="object" invisible="state in ('disposed', 'draft')"/>
                    <button name="action_dispose" string="폐기" type="object" invisible="state == 'disposed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="code" readonly="1"/> - <field name="name" placeholder="설비명"/></h1>
                    </div>
                    <group>
                        <group string="기본 정보">
                            <field name="equipment_type"/>
                            <field name="manufacturer"/>
                            <field name="model_name"/>
                            <field name="serial_number"/>
                            <field name="manufacture_year"/>
                            <field name="capacity"/>
                        </group>
                        <group string="위치/담당">
                            <field name="workcenter_id"/>
                            <field name="location"/>
                            <field name="department_id"/>
                            <field name="responsible_id"/>
                            <field name="purchase_date"/>
                            <field name="install_date"/>
                        </group>
                    </group>
                    <group string="TPM / 보전 현황">
                        <group>
                            <field name="pm_cycle_days"/>
                            <field name="last_pm_date"/>
                            <field name="next_pm_date"/>
                            <field name="is_pm_overdue"/>
                        </group>
                        <group>
                            <field name="total_runtime_hours"/>
                            <field name="breakdown_count"/>
                            <field name="mtbf"/>
                            <field name="mttr"/>
                            <field name="availability_rate"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="사양">
                            <field name="specification"/>
                        </page>
                        <page string="PM 계획/실적">
                            <field name="pm_schedule_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="pm_type"/>
                                    <field name="planned_date"/>
                                    <field name="actual_date"/>
                                    <field name="responsible_id"/>
                                    <field name="result"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="고장 이력">
                            <field name="breakdown_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="occurrence_date"/>
                                    <field name="breakdown_type"/>
                                    <field name="severity"/>
                                    <field name="downtime_hours"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="일상점검">
                            <field name="daily_check_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="check_date"/>
                                    <field name="shift"/>
                                    <field name="checker_id"/>
                                    <field name="overall_result" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="예비부품">
                            <field name="spare_part_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="part_number"/>
                                    <field name="quantity_required"/>
                                    <field name="quantity_on_hand"/>
                                    <field name="supplier"/>
                                    <field name="lead_time_days"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="문서/첨부">
                            <group>
                                <field name="document_ids" widget="many2many_tags"/>
                                <field name="notes"/>
                            </group>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_equipment" model="ir.actions.act_window">
        <field name="name">설비 대장</field>
        <field name="res_model">iatf.equipment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
