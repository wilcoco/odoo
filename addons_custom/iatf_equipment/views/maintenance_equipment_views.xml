<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maintenance_equipment_form_iatf" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.iatf</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_iatf_equipment" type="object"
                        class="oe_stat_button" icon="fa-cog"
                        invisible="not iatf_equipment_id">
                    <span class="o_stat_text">IATF 설비</span>
                </button>
                <button name="action_view_iatf_pm" type="object"
                        class="oe_stat_button" icon="fa-wrench"
                        invisible="iatf_pm_count == 0">
                    <field name="iatf_pm_count" string="PM" widget="statinfo"/>
                </button>
                <button name="action_view_iatf_breakdown" type="object"
                        class="oe_stat_button" icon="fa-bolt"
                        invisible="iatf_breakdown_count == 0">
                    <field name="iatf_breakdown_count" string="고장" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//group" position="after">
                <group string="IATF 연결">
                    <field name="iatf_equipment_id"/>
                </group>
            </xpath>
            <!-- 신뢰성 지표 단일화: IATF 설비가 연결되면 표준(일 단위, 달력 기준) 통계를 감춘다. -->
            <xpath expr="//group[@name='statistics']" position="attributes">
                <attribute name="invisible">iatf_equipment_id</attribute>
            </xpath>
            <xpath expr="//group[@name='statistics']" position="after">
                <group name="iatf_statistics" string="신뢰성 지표 (IATF 설비대장)"
                       invisible="not iatf_equipment_id">
                    <field name="iatf_runtime_source"/>
                    <field name="iatf_runtime_hours" invisible="iatf_runtime_source == 'none'"/>
                    <field name="iatf_mtbf" invisible="iatf_runtime_source == 'none' or iatf_breakdown_count == 0"/>
                    <field name="iatf_mttr"/>
                    <field name="iatf_availability_rate" invisible="iatf_runtime_source == 'none'"/>
                    <div class="text-muted" colspan="2" invisible="iatf_runtime_source != 'none'">
                        가동시간 실적이 없어 MTBF·가동률을 산출하지 않습니다.
                        작업장을 연결하거나 IATF 설비대장에 수기 가동시간을 입력하십시오.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
