<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pm_schedule_list" model="ir.ui.view">
        <field name="name">iatf.pm.schedule.list</field>
        <field name="model">iatf.pm.schedule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="pm_type"/>
                <field name="planned_date"/>
                <field name="actual_date"/>
                <field name="responsible_id"/>
                <field name="duration_hours"/>
                <field name="result"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_pm_schedule_form" model="ir.ui.view">
        <field name="name">iatf.pm.schedule.form</field>
        <field name="model">iatf.pm.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_done" string="완료" type="object" class="btn-success" invisible="state != 'planned'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="pm_type"/>
                            <field name="planned_date"/>
                            <field name="actual_date"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="technician"/>
                            <field name="duration_hours"/>
                            <field name="result"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="점검/작업 내용">
                            <separator string="점검 항목"/>
                            <field name="checklist"/>
                            <separator string="작업 내용"/>
                            <field name="work_done"/>
                            <group><field name="parts_replaced"/></group>
                        </page>
                        <page string="첨부">
                            <field name="attachment_ids" widget="many2many_binary"/>
                            <group><field name="notes"/></group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pm_schedule" model="ir.actions.act_window">
        <field name="name">예방보전 (PM)</field>
        <field name="res_model">iatf.pm.schedule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
