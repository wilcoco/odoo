<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 수량 자리수 복원 — 운영 DB 에서 'Product Unit of Measure' 가 0자리로
         내려가 있어 BOM 소요량·생산수량 등 모든 수량이 정수로만 표시된다.
         (금액 소수점을 없애려던 과거 조치의 부수효과로 추정 — 금액은 이제
         account_kr_plus_patch 가 담당하므로 수량은 Odoo 기본값 2자리로 되돌린다.)

         값 자체는 잘리지 않았다: uom.uom.rounding 이 전부 0.01 이라 저장값은
         소수점을 유지하고 있고, 표시 자리수만 0이었다.

         noupdate: 설치 때 한 번만 적용. 이후 설정 > 기술 > 소수점 정확도에서
         바꾼 값(예: 3자리)은 모듈 업그레이드가 덮어쓰지 않는다. -->
    <data noupdate="1">
        <record id="product.decimal_product_uom" model="decimal.precision">
            <field name="digits">2</field>
        </record>
    </data>
</odoo>
