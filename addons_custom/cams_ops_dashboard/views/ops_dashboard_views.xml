<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_cams_ops_dashboard" model="ir.actions.client">
        <field name="name">운영 대시보드</field>
        <field name="tag">cams_ops_dashboard.dashboard</field>
    </record>

    <!-- 구 버전의 별도 앱 루트는 업그레이드 후에도 다시 나타나지 않게 비활성화한다. -->
    <record id="menu_cams_ops_dashboard_root" model="ir.ui.menu">
        <field name="name">운영 현황</field>
        <field name="active" eval="False"/>
    </record>

    <menuitem id="menu_cams_ops_dashboard"
              name="운영 대시보드"
              parent="cams_ops_process.menu_ops_root"
              action="action_cams_ops_dashboard"
              groups="base.group_user"
              sequence="5"/>
    <!-- 기존 DB에 남은 비활성/그룹 상태를 업그레이드 시 명시적으로 복구한다. -->
    <record id="menu_cams_ops_dashboard" model="ir.ui.menu">
        <field name="active" eval="True"/>
        <field name="parent_id" ref="cams_ops_process.menu_ops_root"/>
        <field name="action" ref="action_cams_ops_dashboard"/>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>
</odoo>
