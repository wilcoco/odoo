<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_outsource_order_list" model="ir.ui.view">
        <field name="name">iatf.outsource.order.list</field>
        <field name="model">iatf.outsource.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="process_id"/>
                <field name="supplier_id"/>
                <field name="product_id"/>
                <field name="quantity_sent"/>
                <field name="send_date"/>
                <field name="quantity_received"/>
                <field name="receive_date"/>
                <field name="inspection_result"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_outsource_order_form" model="ir.ui.view">
        <field name="name">iatf.outsource.order.form</field>
        <field name="model">iatf.outsource.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send" string="출고" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_receive" string="입고" type="object" class="btn-primary" invisible="state != 'sent'"/>
                    <button name="action_inspect" string="검사 완료" type="object" class="btn-warning" invisible="state != 'received'"/>
                    <button name="action_close" string="종료" type="object" class="btn-success" invisible="state != 'inspected'"/>
                    <button name="action_submit_approval" string="결재 상신" type="object" class="btn-primary"
                            invisible="approval_state not in (False, 'draft', 'rejected')"/>
                    <button name="action_approve_approval" string="승인" type="object" class="btn-success"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <button name="action_reject_approval" string="반려" type="object"
                            invisible="approval_state != 'in_progress' or not approval_is_current_user"/>
                    <field name="approval_is_current_user" invisible="1"/>
                    <field name="approval_state" widget="badge"
                           decoration-success="approval_state == 'approved'"
                           decoration-danger="approval_state == 'rejected'"
                           decoration-info="approval_state == 'in_progress'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,received,inspected,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="process_id"/>
                            <field name="supplier_id"/>
                            <field name="purchase_id"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                        </group>
                        <group>
                            <field name="quantity_sent"/>
                            <field name="send_date"/>
                            <field name="quantity_received"/>
                            <field name="receive_date"/>
                            <field name="quantity_rejected"/>
                        </group>
                    </group>
                    <group string="검사">
                        <group>
                            <field name="inspection_result"/>
                            <field name="certificate_received"/>
                            <field name="certificate_ok"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <field name="attachment_ids" widget="many2many_binary"/>
                    <notebook>
                        <page string="결재선" name="approval">
                            <field name="approval_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_outsource_order" model="ir.actions.act_window">
        <field name="name">외주 발주/입고</field>
        <field name="res_model">iatf.outsource.order</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
