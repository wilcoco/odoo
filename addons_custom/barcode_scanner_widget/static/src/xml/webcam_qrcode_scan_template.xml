<?xml version="1.0" encoding="utf-8"?>

<templates xml:space="preserve">

    <t t-name="widget_qrcode_scanner">
        <button class="fa fa-qrcode btn btn-secondary qr_scan_button" title="Scan QRCode"
            aria-label="Scan QRCode" name="o_start_qr_scan" />
    </t>

    <div t-name="device_selector" id="WebCamSelector">
        <div class="container-fluid my-2">
            <div>
                <label for="camera_id">Select A Camera</label>
                <select class="custom-select custom-select-lg mb-3 o_camera_selector" id="camera_id" name="camera_id">
                    <t t-foreach="devices" t-as="dev">
                        <option t-att-value="dev.id">
                            <t t-raw="dev.label or dev.kind" />
                        </option>
                    </t>
                </select>
            </div>
            <div>
                <input type="radio" id="scan_code_type_barcode" name='scan_code_type' value='1' />
                <label for="scan_code_type_barcode">Barcode</label>
                <input type="radio" id="scan_code_type_qr" name='scan_code_type' value='0' checked="checked" />
                <label for="scan_code_type_qr">QR Code</label>
            </div>
        </div>
    </div>

    <!-- OWL Field template -->
    <t t-name="barcode_scanner_widget.BarcodeScannerField" owl="1">
        <div class="o_qrcode_scanner_widget">
            <input type="text"
                   class="o_input"
                   t-att-placeholder="props.placeholder"
                   t-att-readonly="props.readonly ? true : undefined"
                   t-ref="input"
                   t-on-blur="onBlur"/>
            <button type="button" class="btn btn-secondary qr_scan_button" title="Scan" aria-label="Scan" t-on-click="openScan">
                <i class="fa fa-qrcode"/>
            </button>
            <div t-ref="webcam" id="webcam_viewport" class="o_live_scan_result"></div>
        </div>
    </t>

</templates>

