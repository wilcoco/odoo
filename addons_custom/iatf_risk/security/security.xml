<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_risk_user" model="res.groups">
        <field name="name">Risk Management User</field>
        <field name="category_id" ref="iatf_document_control.module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_risk_manager" model="res.groups">
        <field name="name">Risk Management Manager</field>
        <field name="category_id" ref="iatf_document_control.module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('group_risk_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
