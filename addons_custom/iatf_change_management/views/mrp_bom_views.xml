<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_form_iatf_change" model="ir.ui.view">
        <field name="name">mrp.bom.form.iatf.change</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div invisible="not change_locked" class="alert alert-danger text-center" role="alert">
                    <strong>🔒 미승인 변경요청(CR)이 존재하여 BOM 변경이 잠겨있습니다.</strong>
                    CR 승인 후 수정 가능합니다.
                </div>
            </xpath>
            <xpath expr="//group[1]" position="after">
                <group string="IATF 변경관리" invisible="not change_locked">
                    <field name="change_locked" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
