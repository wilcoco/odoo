<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_change_management_user" model="res.groups">
        <field name="name">변경관리 담당자</field>
        <field name="category_id" ref="iatf_document_control.module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_change_management_manager" model="res.groups">
        <field name="name">변경관리 관리자</field>
        <field name="category_id" ref="iatf_document_control.module_category_iatf"/>
        <field name="implied_ids" eval="[(4, ref('group_change_management_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_change_request_company" model="ir.rule">
        <field name="name">변경요청 회사 범위</field>
        <field name="model_id" ref="model_iatf_change_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
