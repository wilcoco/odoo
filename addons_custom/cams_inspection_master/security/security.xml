<odoo>
  <record id="group_inspection_user" model="res.groups"><field name="name">한도견본·정기시험 담당</field><field name="implied_ids" eval="[(4,ref('cams_evidence_core.group_evidence_user'))]"/></record>
  <record id="group_inspection_manager" model="res.groups"><field name="name">한도견본·정기시험 책임자</field><field name="implied_ids" eval="[(4,ref('group_inspection_user')),(4,ref('cams_evidence_core.group_evidence_manager'))]"/></record>
  <record id="limit_sample_company" model="ir.rule"><field name="name">한도견본 점검 회사 격리</field><field name="model_id" ref="model_cams_limit_sample_check"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="periodic_test_company" model="ir.rule"><field name="name">정기시험 회사 격리</field><field name="model_id" ref="model_cams_periodic_test"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
</odoo>
