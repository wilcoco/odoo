<odoo>
    <record id="view_sq_daily_list" model="ir.ui.view">
        <field name="name">sq.item.daily.list</field><field name="model">sq.item</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="code"/><field name="name"/><field name="responsible_id"/>
                <field name="daily_status"/><field name="daily_period"/>
                <field name="daily_document_status" optional="show"/>
                <field name="daily_document_review_due" optional="show"/>
                <field name="daily_document_unapproved" optional="hide"/>
                <field name="daily_plan_count" optional="show" groups="cams_ops_process.group_ops_manager,cams_sq.group_sq_manager"/>
                <field name="daily_missing_count" groups="cams_ops_process.group_ops_manager,cams_sq.group_sq_manager"/>
                <field name="daily_overdue_count" groups="cams_ops_process.group_ops_manager,cams_sq.group_sq_manager"/>
                <field name="daily_sheet_overdue" groups="cams_ops_process.group_ops_manager,cams_sq.group_sq_manager"/>
                <field name="daily_pending_ng" groups="cams_ops_process.group_ops_manager,cams_sq.group_sq_manager"/>
                <button name="action_daily_plans" type="object" string="관리계획"/>
                <button name="action_daily_tasks" type="object" string="수행 업무"/>
                <button name="action_evidence" type="object" string="원천 증빙"/>
                <button name="action_daily_documents" type="object" string="연결 문서"/>
            </list>
        </field>
    </record>
    <record id="action_sq_daily" model="ir.actions.act_window">
        <field name="name">일상관리 누락 확인 (이번 달)</field><field name="res_model">sq.item</field>
        <field name="view_mode">list,form</field><field name="view_id" ref="view_sq_daily_list"/>
    </record>
    <menuitem id="menu_sq_daily" name="일상관리 누락 확인" parent="cams_sq.menu_sq_readiness"
              action="action_sq_daily" sequence="5" groups="cams_sq.group_sq_user"/>
    <record id="view_sq_direct_plan" model="ir.ui.view">
        <field name="name">ops.task.def.sq.direct</field><field name="model">ops.task.def</field>
        <field name="inherit_id" ref="view_sq_ops_definition"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='sq_company_id']" position="after">
            <field name="sq_sheet_ids" widget="many2many_tags" invisible="not sq_item_id"
                   domain="[('company_id','=',sq_company_id)]" options="{'no_create': True}"/>
            <field name="sq_shift" invisible="not sq_item_id"/>
            <field name="sq_required_document_ids" widget="many2many_tags" invisible="not sq_item_id"
                   domain="[('company_id','=',sq_company_id)]" options="{'no_create': True}"/>
        </xpath></field>
    </record>
    <record id="view_sq_direct_task" model="ir.ui.view">
        <field name="name">ops.task.sq.direct</field><field name="model">ops.task</field>
        <field name="inherit_id" ref="view_sq_ops_task"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sq_document_ids']" position="before">
                <field name="sq_check_ids" widget="many2many_tags" readonly="state != 'todo'"
                       options="{'no_create': True}" domain="[('state','=','done'),('company_id','=',sq_company_id)]"/>
                <field name="sq_nonconformity_id" readonly="state != 'todo'" options="{'no_create': True}"
                       domain="[('company_id','=',sq_company_id),('state','!=','cancelled')]"/>
                <field name="sq_recheck_ids" widget="many2many_tags" readonly="state != 'todo'"
                       options="{'no_create': True}" domain="[('state','=','done'),('company_id','=',sq_company_id)]"/>
            </xpath>
            <xpath expr="//field[@name='sq_execution_snapshot']/preceding-sibling::p" position="replace">
                <p class="text-muted">기존 완료 점검표를 직접 연결하거나 승인 문서를 사용합니다. NG 점검은 기존 부적합과 조치 후 재점검을 연결하고, 부적합 종료 후 다른 승인자가 확인합니다. 원래 NG 기록은 유지합니다. 완료 보고 후 근거를 추가하려면 재작업으로 회수합니다.</p>
            </xpath>
        </field>
    </record>
</odoo>
