<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_mrp_workorder_form_scan_guard" model="ir.ui.view">
    <field name="name">mrp.workorder.form.scan.guard</field>
    <field name="model">mrp.workorder</field>
    <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_open_bom_scan_guard"
                string="Scan Component"
                type="object"
                class="oe_highlight"
                groups="mrp.group_mrp_user"/>
      </xpath>
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_open_bom_scan_guard" type="object" class="oe_stat_button" icon="fa-qrcode" groups="mrp.group_mrp_user">
          <div class="o_field_widget o_stat_info">
            <span class="o_stat_text">Scan Component</span>
          </div>
        </button>
        <button name="action_open_scan_guard_logs" type="object" class="oe_stat_button" icon="fa-exclamation-triangle" groups="mrp.group_mrp_user">
          <div class="o_field_widget o_stat_info">
            <span class="o_stat_text">Scan Guard Logs</span>
          </div>
        </button>
      </xpath>
    </field>
  </record>
</odoo>

