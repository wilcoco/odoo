<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Wizard Form -->
  <record id="view_mrp_bom_scan_guard_wizard" model="ir.ui.view">
    <field name="name">mrp.bom.scan.guard.wizard.form</field>
    <field name="model">mrp.bom.scan.guard.wizard</field>
    <field name="arch" type="xml">
      <form string="BOM 부품 이종검사">
        <group>
          <group>
            <field name="workorder_id" readonly="context.get('default_workorder_id')"/>
            <field name="production_id" readonly="1"/>
            <field name="operation_id" readonly="1"/>
          </group>
          <group>
            <!-- If the scanner widget is loaded, show camera UI; otherwise behaves as a normal input for hardware scanners -->
            <field name="scan_value" placeholder="부품 LOT 바코드를 스캔하세요"/>
            <field name="matched_product_id" readonly="1"/>
            <field name="lot_id" readonly="1"/>
          </group>
        </group>

        <group>
          <field name="result_state" readonly="1" class="oe_inline"/>
          <field name="message" readonly="1" nolabel="1"/>
        </group>

        <p class="text-muted">입력 후에는 미리보기만 표시됩니다. 스캔 확정을 눌러 정상 또는 차단 이력을 기록하세요.</p>
        <group string="이 공정의 BOM 부품">
          <field name="allowed_product_ids" widget="many2many_tags" readonly="1"/>
        </group>

        <footer>
          <button name="action_confirm_scan" string="스캔 확정" class="btn-primary" type="object" invisible="not scan_value"/>
          <button name="action_reset" string="초기화" class="btn-secondary" type="object"/>
          <button string="닫기" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Standalone action (optional) -->
  <record id="action_mrp_bom_scan_guard" model="ir.actions.act_window">
    <field name="name">BOM Scan Guard</field>
    <field name="res_model">mrp.bom.scan.guard.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="context">{}</field>
  </record>

  <!-- (Optional) Menu: Manufacturing > Operations -->
  <menuitem id="menu_mrp_bom_scan_guard"
            name="BOM Scan Guard"
            parent="mrp.menu_mrp_manufacturing"
            action="action_mrp_bom_scan_guard"
            sequence="99"/>
</odoo>
