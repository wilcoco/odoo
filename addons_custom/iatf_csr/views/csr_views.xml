<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_csr_list" model="ir.ui.view">
        <field name="name">iatf.csr.list</field>
        <field name="model">iatf.csr</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="title"/>
                <field name="category"/>
                <field name="compliance_status" widget="badge"/>
                <field name="responsible_id"/>
                <field name="effective_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_csr_form" model="ir.ui.view">
        <field name="name">iatf.csr.form</field>
        <field name="model">iatf.csr</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="활성화" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_review" string="검토 필요" type="object"
                            class="btn-warning" invisible="state != 'active'"/>
                    <button name="action_activate" string="검토 완료" type="object"
                            class="btn-success" invisible="state != 'review'"/>
                    <button name="action_obsolete" string="폐기" type="object"
                            invisible="state in ('draft', 'obsolete')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,review"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="title" placeholder="요구사항 제목"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="category"/>
                            <field name="reference_document"/>
                            <field name="revision"/>
                        </group>
                        <group>
                            <field name="effective_date"/>
                            <field name="expiry_date"/>
                            <field name="responsible_id"/>
                            <field name="review_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="요구사항 상세">
                            <field name="description"/>
                            <group>
                                <field name="applies_to_all"/>
                                <field name="product_ids" widget="many2many_tags"
                                       invisible="applies_to_all"/>
                            </group>
                        </page>
                        <page string="내부 대응">
                            <group>
                                <field name="compliance_status"/>
                            </group>
                            <field name="internal_action"/>
                        </page>
                        <page string="문서 / 첨부">
                            <group>
                                <field name="document_ids" widget="many2many_tags"/>
                                <field name="notes"/>
                            </group>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_csr" model="ir.actions.act_window">
        <field name="name">고객 특수요구사항</field>
        <field name="res_model">iatf.csr</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
