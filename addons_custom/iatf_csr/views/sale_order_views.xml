<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_iatf_csr" model="ir.ui.view">
        <field name="name">sale.order.form.iatf.csr</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_csrs" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="csr_count == 0">
                    <field name="csr_count" string="CSR" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <div invisible="not csr_warning" class="alert alert-warning" role="alert">
                    <strong>⚠ 고객 특수 요구사항(CSR)</strong>이 존재합니다. 확인 후 진행하세요.
                </div>
                <field name="csr_warning" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
