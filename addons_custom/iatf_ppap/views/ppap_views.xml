<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iatf_ppap_search" model="ir.ui.view">
        <field name="name">iatf.ppap.submission.search</field>
        <field name="model">iatf.ppap.submission</field>
        <field name="arch" type="xml">
            <search string="PPAP Submissions">
                <field name="name"/>
                <field name="title"/>
                <field name="customer_id"/>
                <field name="product_id"/>
                <separator/>
                <filter name="open" string="Open" domain="[('state','not in',('closed',))]"/>
                <filter name="approved" string="Approved" domain="[('customer_decision','=','approved')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_level" string="Level" context="{'group_by': 'submission_level'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_iatf_ppap_tree" model="ir.ui.view">
        <field name="name">iatf.ppap.submission.tree</field>
        <field name="model">iatf.ppap.submission</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="title"/>
                <field name="customer_id"/>
                <field name="product_id"/>
                <field name="submission_level"/>
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="progress" widget="progressbar"/>
                <field name="customer_decision" widget="badge"
                       decoration-success="customer_decision == 'approved'"
                       decoration-warning="customer_decision == 'interim'"
                       decoration-danger="customer_decision == 'rejected'"
                       optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'closed'"
                       decoration-info="state in ('preparation','submitted')"/>
            </list>
        </field>
    </record>

    <record id="view_iatf_ppap_form" model="ir.ui.view">
        <field name="name">iatf.ppap.submission.form</field>
        <field name="model">iatf.ppap.submission</field>
        <field name="arch" type="xml">
            <form string="PPAP Submission">
                <header>
                    <button name="action_start_preparation" string="Start Preparation" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_create_standard_elements" string="Create 18 Elements" type="object"
                            invisible="state != 'draft'" class="btn-secondary"/>
                    <button name="action_submit" string="Submit to Customer" type="object" class="oe_highlight"
                            invisible="state != 'preparation'"/>
                    <button name="action_record_decision" string="Record Decision" type="object" class="oe_highlight"
                            invisible="state != 'submitted'"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'decided'"/>
                    <button name="action_reset_draft" string="Reset" type="object"
                            invisible="state in ('draft',)"
                            groups="iatf_ppap.group_ppap_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,preparation,submitted,decided,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="title" placeholder="PPAP Title"/></h2>
                    </div>
                    <group>
                        <group string="Part / Customer">
                            <field name="product_id"/>
                            <field name="part_number"/>
                            <field name="customer_id"/>
                            <field name="submission_reason"/>
                        </group>
                        <group string="Submission">
                            <field name="submission_level"/>
                            <field name="responsible_id"/>
                            <field name="submission_date"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <group>
                        <group string="Customer Decision">
                            <field name="customer_decision"/>
                            <field name="decision_date"/>
                            <field name="decision_notes"/>
                        </group>
                        <group string="Links">
                            <field name="fmea_id"/>
                            <field name="control_plan_id"/>
                            <field name="apqp_project_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="PPAP Elements (18)" name="elements">
                            <field name="element_ids">
                                <list editable="bottom">
                                    <field name="element_number"/>
                                    <field name="name"/>
                                    <field name="is_required"/>
                                    <field name="responsible_id"/>
                                    <field name="due_date"/>
                                    <field name="completion_date"/>
                                    <field name="document_id"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-info="state == 'in_progress'"
                                           decoration-muted="state == 'na'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_iatf_ppap" model="ir.actions.act_window">
        <field name="name">PPAP Submissions</field>
        <field name="res_model">iatf.ppap.submission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_iatf_ppap_search"/>
    </record>
</odoo>
