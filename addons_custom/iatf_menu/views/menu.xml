<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- IATF 16949 통합(큐레이션) 메뉴.
             골격 메뉴(menu_iatf_root)는 iatf_document_control 모듈이 제공한다.
             아래 카테고리/항목들은 각 iatf 모듈의 액션을 9개 업무 영역으로 재구성한다. -->

        <!-- 1. 경영 및 기획 -->
        <menuitem id="menu_iatf_management" name="경영 및 기획"
                  parent="iatf_document_control.menu_iatf_root" sequence="1"/>

        <menuitem id="menu_iatf_management_review" name="경영검토" parent="menu_iatf_management" sequence="10"
                  action="iatf_management_review.action_iatf_management_review"/>

        <menuitem id="menu_iatf_quality_objective" name="품질목표 관리" parent="menu_iatf_management" sequence="20"
                  action="iatf_quality_objective.action_quality_objective"/>

        <menuitem id="menu_iatf_risk" name="리스크관리" parent="menu_iatf_management" sequence="30"
                  action="iatf_contingency.action_iatf_contingency"/>

        <menuitem id="menu_iatf_continuous_improvement" name="지속적개선" parent="menu_iatf_management" sequence="40"
                  action="iatf_nonconformity.action_iatf_nonconformity"/>

        <!-- 2. 인적자원 및 교육 -->
        <menuitem id="menu_iatf_hr" name="인적자원 및 교육"
                  parent="iatf_document_control.menu_iatf_root" sequence="2"/>

        <menuitem id="menu_iatf_training" name="교육관리" parent="menu_iatf_hr" sequence="10"
                  action="iatf_training.action_iatf_training_record"/>

        <menuitem id="menu_iatf_qualification" name="자격인증관리" parent="menu_iatf_hr" sequence="20"
                  action="iatf_training.action_iatf_competence_matrix"/>

        <!-- 3. 품질 시스템 및 감사 -->
        <menuitem id="menu_iatf_quality_system" name="품질 시스템 및 감사"
                  parent="iatf_document_control.menu_iatf_root" sequence="3"/>

        <menuitem id="menu_iatf_audit" name="내부심사" parent="menu_iatf_quality_system" sequence="10"
                  action="iatf_audit.action_iatf_audit"/>

        <menuitem id="menu_iatf_audit_overdue" name="미실시 내부심사" parent="menu_iatf_quality_system" sequence="15"
                  action="iatf_audit.action_iatf_audit_overdue"/>

        <menuitem id="menu_iatf_customer_satisfaction" name="고객만족도" parent="menu_iatf_quality_system" sequence="20"
                  action="iatf_customer_complaint.action_iatf_customer_complaint"/>

        <!-- 4. 생산 및 공정 관리 -->
        <menuitem id="menu_iatf_production" name="생산 및 공정 관리"
                  parent="iatf_document_control.menu_iatf_root" sequence="4"/>

        <menuitem id="menu_iatf_apqp" name="APQP/PPAP" parent="menu_iatf_production" sequence="10">
            <menuitem id="menu_iatf_apqp_project" name="APQP 프로젝트" sequence="10"
                      action="iatf_apqp.action_iatf_apqp_project"/>
            <menuitem id="menu_iatf_ppap" name="PPAP 제출서류" sequence="20"
                      action="iatf_ppap.action_iatf_ppap"/>
        </menuitem>

        <menuitem id="menu_iatf_process" name="공정관리" parent="menu_iatf_production" sequence="20">
            <menuitem id="menu_iatf_control_plan" name="관리계획서" sequence="10"
                      action="iatf_control_plan.action_iatf_control_plan"/>
            <menuitem id="menu_iatf_fmea" name="FMEA" sequence="20"
                      action="iatf_fmea.action_iatf_fmea"/>
            <menuitem id="menu_iatf_spc" name="SPC/공정능력" sequence="30"
                      action="iatf_spc.action_iatf_spc_study"/>
        </menuitem>

        <!-- 분쇄·배합은 생산 공정이라 여기에 둔다. 메뉴를 새로 만들지 않고 추적성 모듈의
             원본 그룹(배합 관리기준·배합일지·분쇄일지·기준초과)을 통째로 옮긴다.
             같은 화면이 두 메뉴에 달리면 평가장에서 "어디로 가야 하나" 가 흔들린다
             (2026-09-10 리허설: 중복 88건). 원본 레코드 하나만 남긴다. -->
        <menuitem id="iatf_traceability.menu_iatf_blend_root" name="분쇄·배합 관리"
                  parent="menu_iatf_production" sequence="25"/>

        <menuitem id="menu_iatf_inspection" name="검사관리" parent="menu_iatf_production" sequence="30">
            <menuitem id="menu_iatf_incoming" name="수입검사" sequence="10"
                      action="iatf_incoming_inspection.action_incoming_inspection"/>
            <menuitem id="menu_iatf_process_inspection" name="공정검사" sequence="20"
                      action="iatf_process_inspection.action_process_inspection"/>
            <menuitem id="menu_iatf_layout" name="레이아웃검사" sequence="30"
                      action="iatf_layout_inspection.action_layout_inspection"/>
        </menuitem>

        <!-- 5. 설비 및 금형 관리 -->
        <menuitem id="menu_iatf_equipment" name="설비 및 금형 관리"
                  parent="iatf_document_control.menu_iatf_root" sequence="5"/>

        <!-- 아래 셋은 새 메뉴가 아니라 각 모듈 **원본 트리의 뿌리를 옮긴 것**이다.
             설비대장·PM·고장·일상점검·예비부품·분류·적용표 / 금형대장·보전·T/O·점검·온도 /
             작업구역·5S·점검시트·실적·미실시 가 원본 레코드 그대로 이 밑에 온다.
             ⚠ 각 모듈을 단독 -u 하면 그 모듈 XML 이 뿌리를 옛 자리로 되돌린다.
               메뉴가 흐트러지면 iatf_menu 를 함께 -u 한다. -->
        <menuitem id="iatf_equipment.menu_iatf_equipment_root" name="설비관리 / TPM"
                  parent="menu_iatf_equipment" sequence="10"/>

        <menuitem id="menu_iatf_calibration" name="계측기관리" parent="menu_iatf_equipment" sequence="20"
                  action="iatf_calibration.action_iatf_equipment"/>

        <menuitem id="iatf_mold.menu_iatf_mold_root" name="금형관리"
                  parent="menu_iatf_equipment" sequence="30"/>

        <menuitem id="iatf_work_environment.menu_iatf_work_env_root" name="점검 일지 / 작업환경"
                  parent="menu_iatf_equipment" sequence="40"/>

        <!-- 6. 구매 및 자재 관리 -->
        <menuitem id="menu_iatf_procurement" name="구매 및 자재 관리"
                  parent="iatf_document_control.menu_iatf_root" sequence="6"/>

        <menuitem id="menu_iatf_supplier" name="공급자관리" parent="menu_iatf_procurement" sequence="10">
            <menuitem id="menu_iatf_supplier_evaluation" name="공급자평가" sequence="10"
                      action="iatf_supplier_quality.action_iatf_supplier_evaluation"/>
            <menuitem id="menu_iatf_scar" name="SCAR" sequence="20"
                      action="iatf_supplier_quality.action_iatf_scar"/>
        </menuitem>

        <menuitem id="menu_iatf_outsource" name="외주관리" parent="menu_iatf_procurement" sequence="20"
                  action="iatf_outsource.action_outsource_order"/>

        <!-- 7. 물류 및 인도 관리 -->
        <menuitem id="menu_iatf_logistics" name="물류 및 인도 관리"
                  parent="iatf_document_control.menu_iatf_root" sequence="7"/>

        <menuitem id="iatf_traceability.menu_iatf_traceability_records" name="추적성관리"
                  parent="menu_iatf_logistics" sequence="10"/>

        <menuitem id="menu_iatf_packaging" name="포장관리" parent="menu_iatf_logistics" sequence="20"
                  action="iatf_packaging.action_packaging_spec"/>

        <!-- 8. 비상 및 안전 관리 -->
        <menuitem id="menu_iatf_safety" name="비상 및 안전 관리"
                  parent="iatf_document_control.menu_iatf_root" sequence="8"/>

        <menuitem id="menu_iatf_contingency" name="비상대응계획" parent="menu_iatf_safety" sequence="10"
                  action="iatf_contingency.action_iatf_contingency"/>

        <menuitem id="iatf_traceability.menu_iatf_recall_simulations" name="리콜시뮬레이션"
                  parent="menu_iatf_safety" sequence="20"/>

        <menuitem id="iatf_work_environment.menu_iatf_safety_assessment" name="위험성평가"
                  parent="menu_iatf_safety" sequence="30"/>
        <menuitem id="iatf_work_environment.menu_iatf_safety_incident" name="아차사고/사고 이력"
                  parent="menu_iatf_safety" sequence="40"/>
        <menuitem id="iatf_work_environment.menu_iatf_safety_check_sheet" name="안전점검 시트"
                  parent="menu_iatf_safety" sequence="50"/>

        <!-- 자식을 전부 옮겨 비게 된 옛 그룹. 지우면 모듈 -u 때 되살아나므로 비활성으로 둔다. -->
        <record id="iatf_work_environment.menu_iatf_safety_root" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="iatf_traceability.menu_iatf_traceability_root" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

        <!-- 9. 리포트 및 분석 -->
        <menuitem id="menu_iatf_reports" name="리포트 및 분석"
                  parent="iatf_document_control.menu_iatf_root" sequence="9"/>

        <menuitem id="menu_iatf_dashboard" name="품질대시보드"
                  parent="iatf_document_control.menu_iatf_root" sequence="10"
                  action="iatf_dashboard.action_iatf_dashboard_server"/>

        <menuitem id="menu_iatf_excel_import" name="엑셀 가져오기" parent="menu_iatf_reports" sequence="20"
                  action="iatf_dashboard.action_iatf_excel_import"/>

        <menuitem id="menu_iatf_reports_sub" name="리포트" parent="menu_iatf_reports" sequence="30"/>
    </data>
</odoo>
