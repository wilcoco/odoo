            <menuitem id="menu_iatf_apqp_project" name="APQP 프로젝트" sequence="10"
                      action="iatf_apqp.action_iatf_apqp_project"/>
            <menuitem id="menu_iatf_ppap" name="PPAP 제출서류" sequence="20"
                      action="iatf_ppap.action_iatf_ppap"/>
        </menuitem>

        <menuitem id="menu_iatf_process" name="공정관리" parent="menu_iatf_production" sequence="20">
            <menuitem id="menu_iatf_control_plan" name="관리계획서" sequence="10"
                      action="iatf_control_plan.action_iatf_control_plan"/>
            <menuitem id="menu_iatf_fmea" name="FMEA" sequence="20"
                      action="iatf_fmea.action_iatf_fmea"/>
            <menuitem id="menu_iatf_spc" name="SPC/공정능력" sequence="30"
                      action="iatf_spc.action_iatf_spc_study"/>
        </menuitem>

        <!-- 분쇄·배합은 생산 공정이라 여기에도 둔다. 정본 화면은 추적성 모듈에 있다. -->
        <menuitem id="menu_iatf_blend" name="분쇄·배합 관리" parent="menu_iatf_production" sequence="25">
            <menuitem id="menu_iatf_blend_standard_x" name="배합 관리기준" sequence="10"
                      action="iatf_traceability.action_blend_standard"/>
            <menuitem id="menu_iatf_blend_log_x" name="배합일지" sequence="20"
                      action="iatf_traceability.action_blend_log"/>
            <menuitem id="menu_iatf_regrind_log_x" name="분쇄일지" sequence="30"
                      action="iatf_traceability.action_regrind_log"/>
