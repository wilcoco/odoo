        <menuitem id="menu_iatf_logistics" name="물류 및 인도 관리"
                  parent="iatf_document_control.menu_iatf_root" sequence="7"/>

        <menuitem id="menu_iatf_traceability" name="추적성관리" parent="menu_iatf_logistics" sequence="10"
