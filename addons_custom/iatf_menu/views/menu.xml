        <menuitem id="menu_iatf_inspection" name="검사관리" parent="menu_iatf_production" sequence="30">
            <menuitem id="menu_iatf_incoming" name="수입검사" sequence="10"
                      action="iatf_incoming_inspection.action_incoming_inspection"/>
            <menuitem id="menu_iatf_process_inspection" name="공정검사" sequence="20"
                      action="iatf_process_inspection.action_process_inspection"/>
            <menuitem id="menu_iatf_layout" name="레이아웃검사" sequence="30"
                      action="iatf_layout_inspection.action_layout_inspection"/>
        </menuitem>

        <!-- 5. 설비 및 금형 관리 -->
        <menuitem id="menu_iatf_equipment" name="설비 및 금형 관리"
                  parent="iatf_document_control.menu_iatf_root" sequence="5"/>

        <menuitem id="menu_iatf_equipment_main" name="설비관리" parent="menu_iatf_equipment" sequence="10"
