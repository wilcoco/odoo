<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category Tree -->
    <record id="view_iatf_document_category_tree" model="ir.ui.view">
        <field name="name">iatf.document.category.tree</field>
        <field name="model">iatf.document.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="retention_years"/>
                <field name="document_count"/>
            </list>
        </field>
    </record>

    <!-- Category Form -->
    <record id="view_iatf_document_category_form" model="ir.ui.view">
        <field name="name">iatf.document.category.form</field>
        <field name="model">iatf.document.category</field>
        <field name="arch" type="xml">
            <form string="Document Category">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="retention_years"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Category Action -->
    <record id="action_iatf_document_category" model="ir.actions.act_window">
        <field name="name">Document Categories</field>
        <field name="res_model">iatf.document.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
