<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Revision Tree (standalone) -->
    <record id="view_iatf_document_revision_tree" model="ir.ui.view">
        <field name="name">iatf.document.revision.tree</field>
        <field name="model">iatf.document.revision</field>
        <field name="arch" type="xml">
            <list>
                <field name="document_id"/>
                <field name="revision_number"/>
                <field name="revision_date"/>
                <field name="reason"/>
                <field name="revised_by"/>
                <field name="approved_by"/>
            </list>
        </field>
    </record>

    <!-- Revision Form -->
    <record id="view_iatf_document_revision_form" model="ir.ui.view">
        <field name="name">iatf.document.revision.form</field>
        <field name="model">iatf.document.revision</field>
        <field name="arch" type="xml">
            <form string="Document Revision">
                <sheet>
                    <group>
                        <group>
                            <field name="document_id"/>
                            <field name="revision_number"/>
                            <field name="revision_date"/>
                        </group>
                        <group>
                            <field name="revised_by"/>
                            <field name="approved_by"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="change_description"/>
                    </group>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Revision Action -->
    <record id="action_iatf_document_revision" model="ir.actions.act_window">
        <field name="name">Revision History</field>
        <field name="res_model">iatf.document.revision</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
