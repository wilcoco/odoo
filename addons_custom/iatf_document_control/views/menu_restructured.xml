<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Top-level IATF Quality menu.
             순수 컨테이너로만 정의한다. 다른 iatf 모듈들이 이 메뉴(menu_iatf_root / menu_iatf_misc)를
             parent로 참조하므로 ID는 이 모듈(iatf_document_control) 네임스페이스에 유지해야 한다.
             타 모듈 액션을 참조하는 통합(큐레이션) 메뉴는 iatf_menu 모듈에서 구성한다. -->
        <menuitem id="menu_iatf_root"
                  name="IATF 16949"
                  sequence="55"
                  web_icon="iatf_document_control,static/description/icon.png"/>

        <!-- 기타/확장 (여러 iatf 모듈이 parent로 참조) -->
        <menuitem id="menu_iatf_misc" name="기타/확장" parent="menu_iatf_root" sequence="90"/>

        <!-- 문서관리: 본 모듈 자체 액션 -->
        <menuitem id="menu_iatf_document_control" name="문서관리" parent="menu_iatf_root" sequence="30"/>
        <menuitem id="menu_iatf_documents" name="문서 목록" parent="menu_iatf_document_control"
                  action="action_iatf_document" sequence="10"/>
        <menuitem id="menu_iatf_document_revisions" name="개정 이력" parent="menu_iatf_document_control"
                  action="action_iatf_document_revision" sequence="20"/>
        <menuitem id="menu_iatf_document_categories" name="문서 카테고리" parent="menu_iatf_document_control"
                  action="action_iatf_document_category" sequence="30"/>

        <!-- 설정 -->
        <menuitem id="menu_iatf_settings" name="설정" parent="menu_iatf_root" sequence="100"
                  groups="base.group_system"/>
        <menuitem id="menu_iatf_config" name="IATF 설정" parent="menu_iatf_settings" sequence="10"
                  action="base.res_config_setting_act_window"/>
    </data>
</odoo>
