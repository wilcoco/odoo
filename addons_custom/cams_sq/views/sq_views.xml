<odoo>
<record id="view_standard_list" model="ir.ui.view"><field name="name">view_standard_list</field><field name="model">sq.standard</field><field name="arch" type="xml"><list create="false"><field name="name"/><field name="sector"/><field name="revision"/><field name="total_points"/><field name="company_id" groups="base.group_multi_company"/><button name="action_new_assessment" type="object" string="평가서 작성"/></list></field></record>
<record id="view_standard_form" model="ir.ui.view"><field name="name">view_standard_form</field><field name="model">sq.standard</field><field name="arch" type="xml"><form create="false"><header><button name="action_new_assessment" type="object" string="평가서 작성" class="btn-primary"/></header><sheet><group><field name="name"/><field name="sector"/><field name="revision"/><field name="company_id"/><field name="total_points"/><field name="source_commit"/></group><group string="채점 비율" groups="cams_sq.group_sq_manager"><field name="good_ratio"/><field name="partial_ratio"/><field name="poor_ratio"/><field name="ratio_source"/></group><field name="item_ids" readonly="1"><list><field name="code"/><field name="name"/><field name="points"/></list></field></sheet><chatter/></form></field></record>
<record id="view_item_list" model="ir.ui.view"><field name="name">view_item_list</field><field name="model">sq.item</field><field name="arch" type="xml"><list create="false"><field name="code"/><field name="name"/><field name="standard_id"/><field name="area_id"/><field name="points"/><field name="responsible_id"/><field name="ready_rate"/><button name="action_evidence" type="object" string="증빙 후보 열기"/></list></field></record>
<record id="view_item_form" model="ir.ui.view"><field name="name">view_item_form</field><field name="model">sq.item</field><field name="arch" type="xml"><form create="false"><header><button name="action_evidence" type="object" string="증빙 후보 열기" class="btn-primary"/></header><sheet><group><field name="code"/><field name="name" readonly="1"/><field name="standard_id"/><field name="area_id" readonly="1"/><field name="points" readonly="1"/><field name="responsible_id"/><field name="source_owner"/><field name="source"/><field name="applicability_note"/></group><field name="requirement" readonly="1"/><group string="기존 점검 시트·문서 연결"><p>관리자가 기존 원천과 연결 근거를 지정합니다. 연결되지 않은 점검표는 다른 항목의 증빙으로 집계하지 않습니다. 점검 결과는 원래 업무 메뉴에서 입력하십시오.</p><field name="binding_ids" groups="cams_sq.group_sq_manager"><list editable="bottom"><field name="source_ref" options="{'no_create': True}"/><field name="purpose"/><field name="active"/><button name="action_open_source" type="object" string="원천 열기"/></list></field><field name="binding_ids" readonly="1" groups="!cams_sq.group_sq_manager"><list><field name="source_ref"/><field name="purpose"/><button name="action_open_source" type="object" string="원천 열기"/></list></field></group><field name="requirement_ids" readonly="1"><list><field name="name"/><field name="source_status"/><field name="state"/><field name="responsible_id"/></list></field></sheet></form></field></record>
<record id="view_requirement_list" model="ir.ui.view"><field name="name">view_requirement_list</field><field name="model">sq.doc.requirement</field><field name="arch" type="xml"><list create="false"><field name="name"/><field name="item_ids" widget="many2many_tags"/><field name="responsible_id"/><field name="source_owner"/><field name="source_status"/><field name="state" widget="badge"/></list></field></record>
<record id="view_requirement_form" model="ir.ui.view"><field name="name">view_requirement_form</field><field name="model">sq.doc.requirement</field><field name="arch" type="xml"><form create="false"><sheet><group><field name="name" readonly="1"/><field name="kind" readonly="1"/><field name="item_ids" widget="many2many_tags" readonly="1"/><field name="source"/><field name="source_status"/><field name="source_owner"/><field name="source_quantity"/><field name="responsible_id"/><field name="state"/><field name="company_id" invisible="1"/><field name="document_ids" widget="many2many_tags" options="{'no_create': True}" domain="[('company_id','=',company_id)]"/><field name="note"/></group><p>원본 과거 표시는 참고 정보입니다. 현재 준비 확인은 기존 문서 연결과 확인 근거를 바탕으로 기록합니다.</p></sheet><chatter/></form></field></record>
<record id="view_evidence_readonly" model="ir.ui.view"><field name="name">view_evidence_readonly</field><field name="model">sq.evidence.rule</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="item_id"/><field name="name"/><field name="model_name"/><field name="scope_mode"/><field name="period_mode"/><field name="evidence_count"/><field name="latest_date"/><field name="evidence_state"/><button name="action_open_source" type="object" string="원천 기록 열기"/></list></field></record>
<record id="view_rule_form" model="ir.ui.view"><field name="name">view_rule_form</field><field name="model">sq.evidence.rule</field><field name="arch" type="xml"><form><sheet><group><field name="item_id"/><field name="name"/><field name="source_key"/><field name="model_name"/><field name="company_path"/><field name="scope_mode"/><field name="period_mode"/><field name="review_revision"/><field name="date_field"/><field name="domain_json"/><field name="period_days"/><field name="note"/><field name="proposal_enabled"/><field name="minimum_count"/><field name="metric_kind"/><field name="metric_field"/><field name="metric_domain_json"/><field name="positive_values"/><field name="decided_values"/><field name="minimum_samples"/><field name="good_threshold"/><field name="partial_threshold"/><field name="metric_source" readonly="1"/><field name="proposal_source"/><field name="active"/></group></sheet></form></field></record>
<record id="view_sq_audit_form" model="ir.ui.view"><field name="name">iatf.audit.sq</field><field name="model">iatf.audit</field><field name="inherit_id" ref="iatf_audit.view_iatf_audit_form"/><field name="arch" type="xml">
<xpath expr="//header" position="inside"><button name="action_sq_initialize" type="object" string="SQ 항목 생성" invisible="audit_type != 'sq' or sq_line_ids"/><button name="action_sq_propose" type="object" string="증빙 조회·제안" invisible="audit_type != 'sq' or state not in ('planned','in_progress')"/><button name="action_sq_package" type="object" string="심사 패키지 ZIP" invisible="audit_type != 'sq'"/></xpath>
<xpath expr="//notebook" position="before"><group string="SQ 평가" invisible="audit_type != 'sq'"><group><field name="company_id"/><field name="sq_standard_id" domain="[('company_id','=',company_id)]" options="{'no_create': True}" readonly="sq_line_ids"/><field name="sq_date_from"/><field name="sq_date_to"/></group><group><field name="sq_raw_score"/><field name="sq_applicable"/><field name="sq_score"/><field name="sq_unknown"/><field name="sq_area_scores"/></group><p>미평가 항목이 남으면 점수는 잠정치입니다. 해당없음은 담당자 확인 근거를 입력하고 배점에서 제외합니다.</p></group></xpath>
<xpath expr="//notebook" position="inside"><page string="SQ 항목 평가" invisible="audit_type != 'sq'"><field name="sq_line_ids" readonly="state in ('report','follow_up','closed','cancelled')"><list editable="bottom" create="false" delete="false"><field name="item_id" readonly="1"/><field name="points"/><field name="proposed_rating"/><field name="proposed_reason" optional="show"/><field name="rating"/><field name="score"/><field name="reason"/><field name="finding" optional="hide"/><field name="action" optional="hide"/><button name="action_evidence" type="object" string="증빙"/><button name="action_accept_proposal" type="object" string="제안 확인"/></list></field></page></xpath>
</field></record>
<record id="action_standard" model="ir.actions.act_window"><field name="name">업종·개정</field><field name="res_model">sq.standard</field><field name="view_mode">list,form</field></record>
<record id="action_item" model="ir.actions.act_window"><field name="name">SQ 기준 항목</field><field name="res_model">sq.item</field><field name="view_mode">list,form</field></record>
<record id="action_requirements" model="ir.actions.act_window"><field name="name">서류 준비 현황</field><field name="res_model">sq.doc.requirement</field><field name="view_mode">list,form</field><field name="domain">[('kind','=','document')]</field></record>
<record id="action_purchase" model="ir.actions.act_window"><field name="name">구매 준비</field><field name="res_model">sq.doc.requirement</field><field name="view_mode">list,form</field><field name="domain">[('kind','=','purchase')]</field></record>
<record id="action_evidence" model="ir.actions.act_window"><field name="name">항목별 증빙</field><field name="res_model">sq.evidence.rule</field><field name="view_mode">list</field><field name="view_id" ref="view_evidence_readonly"/><field name="context">{'create':False,'edit':False,'delete':False}</field></record>
<record id="action_rule" model="ir.actions.act_window"><field name="name">증빙 규칙</field><field name="res_model">sq.evidence.rule</field><field name="view_mode">list,form</field></record>
<record id="action_audit" model="ir.actions.act_window"><field name="name">SQ 평가서</field><field name="res_model">iatf.audit</field><field name="view_mode">list,form</field><field name="domain">[('audit_type','=','sq')]</field><field name="context">{'default_audit_type':'sq'}</field></record>
<record id="action_load_catalog" model="ir.actions.server"><field name="name">인계 기준 적재 / 재확인</field><field name="model_id" ref="model_sq_standard"/><field name="state">code</field><field name="code">action = model.action_load_catalog()</field><field name="groups_id" eval="[(4,ref('group_sq_manager'))]"/></record>
<menuitem id="menu_sq_root" name="SQ" sequence="54" web_icon="cams_sq,static/description/icon.svg" groups="group_sq_user"/>
<menuitem id="menu_sq_standards" name="기준" parent="menu_sq_root" sequence="10"/>
<menuitem id="menu_standard" name="업종·개정" parent="menu_sq_standards" action="action_standard"/>
<menuitem id="menu_item" name="항목" parent="menu_sq_standards" action="action_item"/>
<menuitem id="menu_sq_readiness" name="준비 현황" parent="menu_sq_root" sequence="20"/>
<menuitem id="menu_requirements" name="서류·담당" parent="menu_sq_readiness" action="action_requirements"/>
<menuitem id="menu_purchase" name="구매 준비" parent="menu_sq_readiness" action="action_purchase"/>
<menuitem id="menu_sq_evidence" name="항목별 증빙" parent="menu_sq_root" action="action_evidence" sequence="30"/>
<menuitem id="menu_sq_audit" name="평가서" parent="menu_sq_root" action="action_audit" sequence="40"/>
<record id="action_reinforcement" model="ir.actions.act_window"><field name="name">보강 필요 항목</field><field name="res_model">sq.assessment.line</field><field name="view_mode">list,form</field><field name="domain">[('proposed_rating','in',['poor','partial','unknown']),('audit_id.state','not in',['cancelled','closed'])]</field></record>
<record id="view_reinforcement_list" model="ir.ui.view"><field name="name">sq.assessment.line.reinforcement</field><field name="model">sq.assessment.line</field><field name="arch" type="xml"><list create="false" delete="false"><field name="audit_id"/><field name="item_id"/><field name="proposed_rating"/><field name="proposed_reason"/><field name="rating"/><field name="reason"/><button name="action_evidence" type="object" string="증빙"/></list></field></record>
<record id="view_assessment_line_form" model="ir.ui.view"><field name="name">sq.assessment.line.form</field><field name="model">sq.assessment.line</field><field name="arch" type="xml"><form create="false" delete="false"><header><button name="action_evidence" type="object" string="증빙"/><button name="action_accept_proposal" type="object" string="제안 확인"/></header><sheet><group><field name="audit_id" readonly="1"/><field name="item_id" readonly="1"/><field name="points"/><field name="proposed_rating"/><field name="proposed_reason"/><field name="rating"/><field name="reason"/><field name="finding"/><field name="action"/></group></sheet></form></field></record>
<menuitem id="menu_sq_reinforcement" name="보강 필요 항목" parent="menu_sq_readiness" action="action_reinforcement"/>
<menuitem id="menu_sq_settings" name="설정" parent="menu_sq_root" sequence="90" groups="group_sq_manager"/>
<menuitem id="menu_sq_ratios" name="채점 비율" parent="menu_sq_settings" action="action_standard"/>
<menuitem id="menu_sq_rules" name="증빙 규칙" parent="menu_sq_settings" action="action_rule"/>
<menuitem id="menu_sq_import" name="인계 기준 적재" parent="menu_sq_settings" action="action_load_catalog"/>
</odoo>