<odoo>
  <record id="rule_sq_finding_company" model="ir.rule"><field name="name">SQ 외부 지적 회사</field><field name="model_id" ref="model_sq_external_finding"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="rule_sq_value_company" model="ir.rule"><field name="name">SQ 기준값 회사</field><field name="model_id" ref="model_sq_standard_value"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
  <record id="view_union_standard" model="ir.ui.view"><field name="name">sq.standard.union</field><field name="model">sq.standard</field><field name="inherit_id" ref="view_standard_form"/><field name="arch" type="xml"><xpath expr="//field[@name='total_points']" position="after"><field name="scored_points"/><field name="import_note"/></xpath></field></record>
  <record id="view_union_item" model="ir.ui.view"><field name="name">sq.item.union</field><field name="model">sq.item</field><field name="inherit_id" ref="view_item_form"/><field name="arch" type="xml"><xpath expr="//field[@name='points']" position="after"><field name="internal_only"/></xpath><xpath expr="//sheet" position="inside"><group string="외부 지적 참고"><p>평가 대상 회사를 확인하십시오. 타사 지적은 우리 회사의 실적 또는 자동 합격 근거가 아닙니다.</p><field name="external_finding_ids" readonly="1"><list><field name="source"/><field name="evaluated_party"/><field name="external_code"/><field name="text"/><field name="status"/></list></field></group></xpath></field></record>
  <record id="view_union_audit" model="ir.ui.view"><field name="name">iatf.audit.sq.union</field><field name="model">iatf.audit</field><field name="inherit_id" ref="view_sq_audit_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="외부 지적 참고" invisible="audit_type != 'sq'"><field name="sq_external_finding_ids" readonly="1"><list><field name="item_id"/><field name="source"/><field name="evaluated_party"/><field name="external_code"/><field name="text"/><field name="status"/></list></field></page></xpath></field></record>
  <record id="view_finding_list" model="ir.ui.view"><field name="name">sq.external.finding.list</field><field name="model">sq.external.finding</field><field name="arch" type="xml"><list create="false" delete="false"><field name="item_id"/><field name="source"/><field name="evaluated_party"/><field name="date"/><field name="external_code"/><field name="status"/><field name="text"/></list></field></record>
  <record id="view_finding_form" model="ir.ui.view"><field name="name">sq.external.finding.form</field><field name="model">sq.external.finding</field><field name="arch" type="xml"><form create="false" delete="false"><sheet><group><field name="item_id" readonly="1"/><field name="source" readonly="1"/><field name="evaluated_party" readonly="1"/><field name="date" readonly="1"/><field name="external_code" readonly="1"/><field name="rating" readonly="1"/><field name="status"/><field name="evidence" readonly="1"/></group><field name="text" readonly="1"/><field name="improvement" readonly="1"/><field name="action_ids" readonly="1"/></sheet><chatter/></form></field></record>
  <record id="view_value_list" model="ir.ui.view"><field name="name">sq.standard.value.list</field><field name="model">sq.standard.value</field><field name="arch" type="xml"><list create="false" edit="false" delete="false" decoration-warning="decision_needed"><field name="union_code"/><field name="parameter"/><field name="value"/><field name="source"/><field name="reference_value"/><field name="reference_source"/><field name="unit"/><field name="decision_needed"/><field name="decision"/></list></field></record>
  <record id="action_external_finding" model="ir.actions.act_window"><field name="name">외부 지적 참고</field><field name="res_model">sq.external.finding</field><field name="view_mode">list,form</field></record>
  <record id="action_standard_value" model="ir.actions.act_window"><field name="name">기준값 원문·확정 대기</field><field name="res_model">sq.standard.value</field><field name="view_mode">list</field></record>
  <record id="action_load_union" model="ir.actions.server"><field name="name">2026-10 합집합 기준 적재</field><field name="model_id" ref="model_sq_standard"/><field name="state">code</field><field name="code">action = model.action_load_union()</field><field name="groups_id" eval="[(4,ref('group_sq_manager'))]"/></record>
  <menuitem id="menu_sq_union_import" name="합집합 기준 적재" parent="menu_sq_settings" action="action_load_union" sequence="20"/>
  <menuitem id="menu_sq_external_findings" name="외부 지적 참고" parent="menu_sq_readiness" action="action_external_finding"/>
  <menuitem id="menu_sq_standard_values" name="기준값 원문·확정 대기" parent="menu_sq_standards" action="action_standard_value"/>
</odoo>
