<odoo>
    <record id="view_sq_audit_revision" model="ir.ui.view">
        <field name="name">iatf.audit.sq.approval.revision</field>
        <field name="model">iatf.audit</field>
        <field name="inherit_id" ref="view_sq_audit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sq_revise" type="object" string="재평가서 작성"
                        invisible="audit_type != 'sq' or state not in ('report','follow_up','closed','cancelled')"/>
            </xpath>
            <xpath expr="//field[@name='sq_standard_id']" position="after">
                <field name="sq_revision_of_id" readonly="1" invisible="not sq_revision_of_id"/>
            </xpath>
        </field>
    </record>
</odoo>
