<odoo>
<record id="group_sq_user" model="res.groups"><field name="name">SQ 조회·평가</field><field name="implied_ids" eval="[(4,ref('iatf_audit.group_audit_user'))]"/></record>
<record id="group_sq_manager" model="res.groups"><field name="name">SQ 기준 관리자</field><field name="implied_ids" eval="[(4,ref('group_sq_user'))]"/><field name="users" eval="[(4,ref('base.user_admin'))]"/></record>
<record id="rule_sq_standard_company" model="ir.rule"><field name="name">SQ standard 회사 격리</field><field name="model_id" ref="model_sq_standard"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="rule_sq_area_company" model="ir.rule"><field name="name">SQ area 회사 격리</field><field name="model_id" ref="model_sq_area"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="rule_sq_item_company" model="ir.rule"><field name="name">SQ item 회사 격리</field><field name="model_id" ref="model_sq_item"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="rule_sq_item_alias_company" model="ir.rule"><field name="name">SQ item.alias 회사 격리</field><field name="model_id" ref="model_sq_item_alias"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="rule_sq_doc_requirement_company" model="ir.rule"><field name="name">SQ doc.requirement 회사 격리</field><field name="model_id" ref="model_sq_doc_requirement"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="rule_sq_evidence_rule_company" model="ir.rule"><field name="name">SQ evidence.rule 회사 격리</field><field name="model_id" ref="model_sq_evidence_rule"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="rule_sq_evidence_binding_company" model="ir.rule"><field name="name">SQ 기존 증빙 연결 회사 격리</field><field name="model_id" ref="model_sq_evidence_binding"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="rule_sq_assessment_line_company" model="ir.rule"><field name="name">SQ assessment.line 회사 격리</field><field name="model_id" ref="model_sq_assessment_line"/><field name="domain_force">[('company_id','in',company_ids)]</field></record>
<record id="rule_sq_audit_company" model="ir.rule"><field name="name">SQ 평가 회사 격리 (기존 IATF 유지)</field><field name="model_id" ref="iatf_audit.model_iatf_audit"/><field name="domain_force">['|',('audit_type','!=','sq'),('company_id','in',company_ids)]</field></record>
</odoo>
