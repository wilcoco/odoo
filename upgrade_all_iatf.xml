<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="action_upgrade_all_iatf" model="ir.actions.server">
            <field name="name">전체 IATF 모듈 업그레이드</field>
            <field name="model_id" ref="base.model_ir_module_module"/>
            <field name="state">code</field>
            <field name="code">
# 전체 IATF 모듈 업그레이드
iatf_modules = env['ir.module.module'].search([('name', 'like', 'iatf_%')])
for module in iatf_modules:
    if module.state == 'installed':
        module.button_upgrade()
            </field>
        </record>
        
        <menuitem id="menu_upgrade_all_iatf"
                  name="전체 IATF 업그레이드"
                  parent="base.menu_management"
                  action="action_upgrade_all_iatf"
                  sequence="100"/>
    </data>
</odoo>
